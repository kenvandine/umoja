[Unit]
Description=IBus input method framework for the Umoja session
Documentation=man:ibus-daemon(1)
# GNOME Shell starts IBus itself; Umoja has no shell to do it. Myna types
# its dictation into the focused app through IBus, so without this it
# fails with "Typing unavailable".
PartOf=umoja-session.target
After=umoja-session.target
ConditionPathExists=/usr/bin/ibus-daemon

[Service]
Type=simple
# Umoja has no IBus panel; --xim serves XWayland apps (XMODIFIERS=@im=ibus).
ExecStart=/usr/bin/ibus-daemon --panel disable --xim
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=umoja-session.target
