[Unit]
Description=Umoja overlay and AI search
PartOf=umoja-session.target
After=umoja-session.target
# Lots of fast restarts are expected while a crash loop is being fixed;
# never give up on the shell.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/umoja-overlay
Restart=always
# Restart well inside the 200 ms crash-recovery budget.
RestartSec=100ms
Slice=session.slice
EnvironmentFile=-%E/umoja/lemonade.env

[Install]
WantedBy=umoja-session.target
