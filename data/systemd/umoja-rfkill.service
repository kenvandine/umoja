[Unit]
Description=GNOME RFKill support for the Umoja session
Documentation=https://github.com/kenvandine/umoja
# gnome-control-center's Bluetooth and Airplane Mode panels read the radio
# switches from org.gnome.SettingsDaemon.Rfkill. Without it the Bluetooth
# panel says "No Bluetooth Found" even though BlueZ and the adapter work.
# gnome-settings-daemon's own unit can't be used here: it refuses a manual
# start and is Requisite= its target, which is Requisite=
# gnome-session-initialized.target, so it only runs under gnome-session.
# Its autostart entry is X-GNOME-HiddenUnderSystemd=true, so
# xdg-desktop-autostart.target skips it too. Run the daemon ourselves.
PartOf=umoja-session.target
After=umoja-session.target
ConditionPathExists=/usr/libexec/gsd-rfkill

[Service]
Type=dbus
BusName=org.gnome.SettingsDaemon.Rfkill
ExecStart=/usr/libexec/gsd-rfkill
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
Slice=session.slice

[Install]
WantedBy=umoja-session.target
