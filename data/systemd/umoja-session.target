[Unit]
Description=Umoja desktop session
Documentation=https://github.com/kenvandine/umoja
# Started by umoja-mir once Wayland is accepting clients.
Requires=basic.target
# This is the session, so it brings up graphical-session.target the way
# gnome-session's targets do (that target refuses a manual start). Without
# it, services that are Requisite=/PartOf= graphical-session.target never
# run: xdg-desktop-portal-gnome failed every activation, so OpenURI (Firefox
# opening a download), AppChooser and the GNOME file chooser did nothing.
# BindsTo also stops it again when this target stops at logout or on a
# compositor restart.
BindsTo=graphical-session.target
Before=graphical-session.target
# xdg-desktop-autostart.target runs the user's autostart apps the way GNOME
# does: systemd-xdg-autostart-generator turns ~/.config/autostart and
# /etc/xdg/autostart entries into app-*@autostart.service units (each in its
# own cgroup under app.slice), honouring Hidden, OnlyShowIn/NotShowIn against
# XDG_CURRENT_DESKTOP (Umoja:ubuntu:GNOME, so GNOME entries run), TryExec,
# X-GNOME-Autostart-enabled, X-GNOME-Autostart-Phase and X-systemd-skip.
# Snap apps are started by /etc/xdg/autostart/snap-userd-autostart.desktop.
# The units are PartOf=graphical-session.target, so they stop at logout.
# A target is ordered After= everything it Wants unless told otherwise, and
# the autostart units are After=graphical-session.target, which is after
# us: that loop made systemd drop the autostart job. Order it after us.
# graphical-session-pre.target is what gnome-session-pre.target pulls in:
# the early session services enabled there (xdg-user-dirs-update, which
# creates Documents, Music, Pictures... in the user's language;
# gnome-keyring-daemon, gcr-ssh-agent, user-session-migration) never ran
# without it, so a new account had no standard folders. Wants, not
# Requires: one failing early service must not stop the session.
Wants=graphical-session-pre.target
After=graphical-session-pre.target
Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target
Wants=umoja-panel.service umoja-tray-ready.service umoja-dock.service umoja-overlay.service umoja-lemonade.service umoja-files.service xdg-desktop-portal-umoja.service umoja-ibus.service umoja-agent-setup.service umoja-automations.service umoja-user-dirs-gtk.service
StopWhenUnneeded=no
