[Unit]
Description=Umoja dock
PartOf=umoja-session.target
After=umoja-session.target
# Only while the session is up: after logout a crash-restart found no
# display and looped ("Failed to open display") until the next login.
Requisite=umoja-session.target
# Lots of fast restarts are expected while a crash loop is being fixed;
# never give up on the shell.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/umoja-dock
Restart=always
# Restart well inside the 200 ms crash-recovery budget.
RestartSec=100ms
# GTK exits with status 1 when it loses the compositor. That only happens
# at logout (or a compositor crash, after which umoja-session starts the
# whole target again), so don't restart into the dying session: a restart
# there woke xdg-desktop-portal-gtk with no display, and its stuck D-Bus
# activation made the next login wait two minutes on portal timeouts.
RestartPreventExitStatus=1
Slice=session.slice

[Install]
WantedBy=umoja-session.target
