[Unit]
Description=GNOME settings daemon %i plugin for the Umoja session
Documentation=https://github.com/kenvandine/umoja
# gnome-settings-daemon is a set of per-feature daemons that Settings and
# apps talk to over D-Bus. Without gsd-rfkill, for one, Settings' Bluetooth
# panel says "No Bluetooth Found" even though BlueZ and the adapter work.
# gnome-settings-daemon's own units can't be used here: each refuses a
# manual start and is Requisite= its target, which is Requisite=
# gnome-session-initialized.target, so they only run under gnome-session.
# Their autostart entries are X-GNOME-HiddenUnderSystemd=true, so
# xdg-desktop-autostart.target skips them too. Run the daemons ourselves;
# umoja-session.target lists which ones.
PartOf=umoja-session.target
After=umoja-session.target
ConditionPathExists=/usr/libexec/gsd-%i

[Service]
Type=simple
ExecStart=/usr/libexec/gsd-%i
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
Slice=session.slice
