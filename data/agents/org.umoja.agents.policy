<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Umoja</vendor>
  <vendor_url>https://github.com/kenvandine/umoja</vendor_url>
  <action id="org.umoja.agents.lxd-setup">
    <description>Set up Hermes's sandbox</description>
    <message>Authentication is required to set up the sandbox Hermes works in.</message>
    <icon_name>umoja-agents-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/umoja-agents/lxd-setup</annotate>
  </action>
</policyconfig>
