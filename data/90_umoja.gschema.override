# Defaults for the Umoja session only: the ":Umoja" qualifier matches the
# first entry of XDG_CURRENT_DESKTOP (Umoja:ubuntu:GNOME), so a stock GNOME
# or Ubuntu session on the same machine keeps its own defaults. A value the
# user sets (GNOME Tweaks, gsettings) still wins over these.

# Middle-click pastes the primary selection (the last text selected), as
# GNOME did before it changed the default to false.
[org.gnome.desktop.interface:Umoja]
gtk-enable-primary-paste=true
# Dark Style by default (Quick Settings > Dark Style, or Settings >
# Appearance, still switches to light). The Yaru GTK theme follows, as the
# Dark Style tile does, so GTK 3 apps match.
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'

# Ubuntu's colourful default wallpaper for both styles, instead of Ubuntu's
# pair that swaps with the style. The greeter shows the same picture.
[org.gnome.desktop.background:Umoja]
picture-uri='file:///usr/share/backgrounds/warty-final-ubuntu.png'
picture-uri-dark='file:///usr/share/backgrounds/warty-final-ubuntu.png'

# The dock floats off the screen edge (Ubuntu's own default is the
# full-height "panel mode"); Settings > Ubuntu Desktop > Panel mode still
# turns it back on.
[org.gnome.shell.extensions.dash-to-dock:Umoja]
extend-height=false
# A dock on every monitor; Settings > Ubuntu Desktop > Dock > "Show on"
# still picks a single one.
multi-monitor=true

# Show Desktop on Super+D and Ctrl+Alt+D, as Ubuntu binds it (GNOME's own
# default is no key).
[org.gnome.desktop.wm.keybindings:Umoja]
show-desktop=['<Super>d', '<Primary><Alt>d']
