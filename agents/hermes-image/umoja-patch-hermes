#!/usr/bin/env python3
"""Build-time patch: Umoja's Telegram buttons in Hermes's Telegram adapter.

Umoja (umoja-agentd, through umoja-agent-bridge chat-ask) sends the sandbox's
consent prompts ("Hermes wants to reach example.com") to the user's Telegram
with Allow/Deny buttons. Hermes's gateway reads the bot's updates, so the
button taps reach its adapter; this patch makes it handle callback data
starting "umoja:" (umoja:<choice>:<key>): only an allowed user may answer,
the answer is written to /sandbox/.config/umoja/chat-answers/<key>.json for
umoja-agent-bridge chat-answers, and the message loses its buttons.

Fails the build when the adapter changed shape, so an upstream update can't
drop the buttons silently.
"""

import pathlib
import sys

MARK = "# umoja: consent buttons"
# Appended to the adapter module: wraps the adapter class's callback
# handler (before the gateway registers it), so the patch doesn't depend on
# the handler's body.
BLOCK = '''

# umoja: consent buttons (agents/hermes-image/umoja-patch-hermes)
def _umoja_install_buttons():
    import json as _uj, os as _uo, time as _ut

    owners = [c for c in list(globals().values())
              if isinstance(c, type) and "_handle_callback_query" in vars(c)]
    for cls in owners:
        orig = cls._handle_callback_query

        async def _handle_callback_query(self, update, context, _orig=orig):
            query = getattr(update, "callback_query", None)
            data = (getattr(query, "data", "") or "") if query else ""
            if not data.startswith("umoja:"):
                return await _orig(self, update, context)
            parts = data.split(":", 2)
            caller = str(getattr(getattr(query, "from_user", None), "id", ""))
            allowed = [x.strip() for x in _uo.environ.get("TELEGRAM_ALLOWED_USERS", "").split(",") if x.strip()]
            if len(parts) != 3 or caller not in allowed:
                await query.answer(text="Only the computer's owner can answer this.")
                return
            choice, key = parts[1], parts[2]
            folder = "/sandbox/.config/umoja/chat-answers"
            _uo.makedirs(folder, exist_ok=True)
            tmp = _uo.path.join(folder, "." + key + ".tmp")
            with open(tmp, "w", encoding="utf-8") as f:
                _uj.dump({"key": key, "choice": choice, "at": int(_ut.time())}, f)
            _uo.replace(tmp, _uo.path.join(folder, key + ".json"))
            label = {"allow": "Allowed once", "always": "Always allowed", "deny": "Denied"}.get(choice, "Answered")
            await query.answer(text=label)
            try:
                text = getattr(getattr(query, "message", None), "text", "") or ""
                await query.edit_message_text(text=text + "\\n\\n" + label + ".", reply_markup=None)
            except Exception:
                pass

        cls._handle_callback_query = _handle_callback_query
    return len(owners)


if not _umoja_install_buttons():
    raise ImportError("umoja: no Telegram callback handler to wrap")
'''


def patch(path: pathlib.Path) -> bool:
    src = path.read_text(encoding="utf-8")
    if MARK in src:
        return True
    if "async def _handle_callback_query(" not in src:
        return False
    path.write_text(src + BLOCK, encoding="utf-8")
    return True


def main() -> int:
    roots = [pathlib.Path(p) for p in sys.argv[1:]] or [
        pathlib.Path(p) for p in ("/opt/hermes", "/app", "/usr/local/lib", "/usr/lib/python3") if pathlib.Path(p).is_dir()
    ]
    found = [p for r in roots for p in r.rglob("plugins/platforms/telegram/adapter.py")]
    if not found:
        print("umoja-patch-hermes: Hermes's Telegram adapter not found", file=sys.stderr)
        return 1
    for p in found:
        if not patch(p):
            print(f"umoja-patch-hermes: {p} changed shape; update the patch", file=sys.stderr)
            return 1
        print(f"umoja-patch-hermes: patched {p}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
