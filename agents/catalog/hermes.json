    "balanced": "smart",
    "hands-off": "smart"
  },
  "messaging": [
    "telegram"
  ],
  "state_dir": "/sandbox/.hermes",
  "quiet_hosts": [
    "hermes-agent.nousresearch.com",
    "nousresearch.github.io",
    "cloudflare-dns.com",
    "dns.google",
    "yandex.com",
    "grokipedia.com",
    "api.firecrawl.dev"
  ]
}
