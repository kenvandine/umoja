#!/usr/bin/make -f
# Builds entirely offline: Launchpad builders have no network, so the
# source package carries vendored crates (vendor/cargo) and the embedded
# Lemonade build (vendor/lemonade/<arch>). Run `make vendor` before
# building a source package.

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/.cargo
export CARGO_TARGET_DIR = $(CURDIR)/target

include /usr/share/dpkg/architecture.mk

ifeq ($(DEB_HOST_ARCH),amd64)
LEMONADE_ARCH := x64
else ifeq ($(DEB_HOST_ARCH),arm64)
LEMONADE_ARCH := arm64
endif
LEMONADE_SRC := vendor/lemonade/$(LEMONADE_ARCH)
DESKTOP := debian/umoja-desktop
GREETER := debian/umoja-greeter
INSTALLER := debian/umoja-installer
KEYRING := debian/umoja-archive-keyring
META := packaging/meta/ubuntu-umoja-desktop

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	# Cargo resolves relative paths against the config file's parent, so
	# the vendor directory must be absolute.
	sed "s|@VENDOR_DIR@|$(CURDIR)/vendor/cargo|" debian/cargo-config.toml > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --release --offline --frozen --workspace
ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS)))
	# The user guide (docs/guide) as a PDF, opened from Ask Umoja.
	python3 tools/guide/build-pdf --out target/umoja-user-guide.pdf
endif

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# GTK crates need a display to run; test the headless logic only.
	cargo test --release --offline --frozen -p umoja-common -p umoja-mir -p umoja-portal -p umoja-panel -p umoja-files -p umoja-mcp -p umoja-screensaver -p umoja-installer -p umoja-portal-helper
endif

override_dh_auto_clean:
	rm -rf debian/.cargo target

override_dh_auto_install:
	# Binaries
	install -D -m 0755 target/release/umoja-mir $(DESKTOP)/usr/bin/umoja-mir
	install -D -m 0755 target/release/umoja-panel $(DESKTOP)/usr/bin/umoja-panel
	install -D -m 0755 target/release/umoja-dock $(DESKTOP)/usr/bin/umoja-dock
	install -D -m 0755 target/release/umoja-overlay $(DESKTOP)/usr/bin/umoja-overlay
	install -D -m 0755 target/release/umoja-files $(DESKTOP)/usr/bin/umoja-files
	install -D -m 0755 target/release/umoja-mcp $(DESKTOP)/usr/bin/umoja-mcp
	install -D -m 0755 target/release/umoja-screensaver $(DESKTOP)/usr/bin/umoja-screensaver
ifeq ($(DEB_HOST_ARCH),amd64)
	# The installer, for the live ISO only.
	install -D -m 0755 target/release/umoja-installer $(INSTALLER)/usr/bin/umoja-installer
	install -D -m 0755 bin/umoja-install $(INSTALLER)/usr/libexec/umoja-installer/umoja-install
	install -D -m 0644 data/installer/umoja-installer.desktop \
		$(INSTALLER)/usr/share/applications/umoja-installer.desktop
	install -D -m 0644 data/installer/umoja-installer-autostart.desktop \
		$(INSTALLER)/etc/xdg/autostart/umoja-installer.desktop
endif
	install -D -m 0755 bin/umoja-session $(DESKTOP)/usr/bin/umoja-session
	install -D -m 0755 bin/umoja-agent-setup $(DESKTOP)/usr/bin/umoja-agent-setup
	install -D -m 0755 target/release/xdg-desktop-portal-umoja $(DESKTOP)/usr/libexec/xdg-desktop-portal-umoja
	# Hotspot Login window for captive portals (D-Bus activated by the panel)
	install -D -m 0755 target/release/umoja-portal-helper $(DESKTOP)/usr/libexec/umoja-portal-helper
	install -D -m 0644 data/dbus/org.umoja.PortalHelper.service \
		$(DESKTOP)/usr/share/dbus-1/services/org.umoja.PortalHelper.service
	install -D -m 0644 data/applications/org.umoja.PortalHelper.desktop \
		$(DESKTOP)/usr/share/applications/org.umoja.PortalHelper.desktop
	install -D -m 0755 target/release/umoja-greeter $(GREETER)/usr/sbin/umoja-greeter
	install -D -m 0755 bin/umoja-greeter-session $(GREETER)/usr/libexec/umoja-greeter-session

	# The user guide: the PDF, and a launcher so the app grid and Ask Umoja
	# find it ("guide", "help", "manual").
ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS)))
	install -D -m 0644 target/umoja-user-guide.pdf $(DESKTOP)/usr/share/umoja/guide/umoja-user-guide.pdf
	install -D -m 0644 data/applications/umoja-user-guide.desktop \
		$(DESKTOP)/usr/share/applications/umoja-user-guide.desktop
endif

	# Lock screen PAM service
	install -D -m 0644 data/pam/umoja-lock $(DESKTOP)/etc/pam.d/umoja-lock

	# Desktop session & GSettings
	install -D -m 0644 data/umoja.desktop $(DESKTOP)/usr/share/wayland-sessions/umoja.desktop
	install -D -m 0644 data/org.umoja.shell.gschema.xml $(DESKTOP)/usr/share/glib-2.0/schemas/org.umoja.shell.gschema.xml
	install -D -m 0644 data/90_umoja.gschema.override $(DESKTOP)/usr/share/glib-2.0/schemas/90_umoja.gschema.override
	# Ubuntu's extension schemas (dock, tiling, appindicator, desktop icons)
	# with Ubuntu's and Umoja's dock defaults, for systems without GNOME
	# Shell. umoja-session adds this directory to XDG_DATA_DIRS only when
	# gnome-shell-ubuntu-extensions isn't installed. Overrides for schemas
	# that live elsewhere are skipped by glib-compile-schemas.
	install -d $(DESKTOP)/usr/share/umoja/gsettings/glib-2.0/schemas
	install -m 0644 data/schemas/ubuntu-extensions/*.gschema.xml data/schemas/ubuntu-extensions/*.gschema.override \
		data/90_umoja.gschema.override $(DESKTOP)/usr/share/umoja/gsettings/glib-2.0/schemas/
	glib-compile-schemas $(DESKTOP)/usr/share/umoja/gsettings/glib-2.0/schemas

	# systemd user units, D-Bus activation and portal registration
	install -d $(DESKTOP)/usr/lib/systemd/user
	install -m 0644 data/systemd/*.service data/systemd/*.target $(DESKTOP)/usr/lib/systemd/user/
	install -D -m 0644 data/systemd/app-.service.d/umoja-tray-ready.conf \
		$(DESKTOP)/usr/lib/systemd/user/app-.service.d/umoja-tray-ready.conf
	install -D -m 0644 data/dbus/org.umoja.Files.service \
		$(DESKTOP)/usr/share/dbus-1/services/org.umoja.Files.service
	install -D -m 0644 data/dbus/org.freedesktop.impl.portal.desktop.umoja.service \
		$(DESKTOP)/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.umoja.service
	install -D -m 0644 data/portal/umoja.portal $(DESKTOP)/usr/share/xdg-desktop-portal/portals/umoja.portal
	install -D -m 0644 data/portal/umoja-portals.conf $(DESKTOP)/usr/share/xdg-desktop-portal/umoja-portals.conf

	# Embedded Lemonade, private to Umoja (never on PATH, never port 13305)
	test -x $(LEMONADE_SRC)/lemond || { echo "missing $(LEMONADE_SRC); run 'make vendor-lemonade'" >&2; exit 1; }
	install -d $(DESKTOP)/usr/lib/umoja/lemonade
	cp -a $(LEMONADE_SRC)/. $(DESKTOP)/usr/lib/umoja/lemonade/
	install -D -m 0755 bin/umoja-lemonade $(DESKTOP)/usr/lib/umoja/umoja-lemonade
	install -d $(DESKTOP)/usr/share/umoja/icons
	cp -r data/icons/hicolor $(DESKTOP)/usr/share/umoja/icons/
	install -D -m 0644 data/lemonade/defaults.json $(DESKTOP)/usr/share/umoja/lemonade/defaults.json

	# Agent skill for AI coding agents (linked by umoja-agent-setup)
	install -d $(DESKTOP)/usr/share/umoja/agents/skills
	cp -r data/agents/skills/umoja $(DESKTOP)/usr/share/umoja/agents/skills/

	# Greeter
	install -D -m 0644 data/lightdm-umoja-greeter.desktop $(GREETER)/usr/share/xgreeters/lightdm-umoja-greeter.desktop
	install -D -m 0644 data/lightdm-umoja-greeter-x11.desktop $(GREETER)/usr/share/xgreeters/lightdm-umoja-greeter-x11.desktop
	install -D -m 0644 data/lightdm/60-umoja.conf $(GREETER)/usr/share/lightdm/lightdm.conf.d/60-umoja.conf
	install -D -m 0644 data/pam/umoja-greeter $(GREETER)/etc/pam.d/umoja-greeter
	install -D -m 0644 data/greeter/umoja-wait-for-snaps.service \
		$(GREETER)/usr/lib/systemd/system/umoja-wait-for-snaps.service
	install -D -m 0644 data/greeter/lightdm-wait-for-snaps.conf \
		$(GREETER)/usr/lib/systemd/system/lightdm.service.d/umoja-wait-for-snaps.conf

override_dh_install-indep:
	dh_install -i
	# The release PPA's signing key, committed in the repo
	# (packaging/fetch-ppa-keys refreshes it if Launchpad ever rotates it).
	install -D -m 0644 data/apt/keyrings/umoja-archive-keyring.asc \
		$(KEYRING)/usr/share/keyrings/umoja-archive-keyring.asc
	install -D -m 0644 data/apt/umoja.sources.in $(KEYRING)/usr/share/umoja-archive-keyring/umoja.sources.in
	install -D -m 0644 data/apt/umoja-mir.pref $(KEYRING)/etc/apt/preferences.d/umoja-mir.pref
	# Boot and disk-unlock screen: Ubuntu's BGRT theme with Umoja's wordmark.
	install -D -m 0644 data/plymouth/umoja/umoja.plymouth \
		debian/ubuntu-umoja-desktop/usr/share/plymouth/themes/umoja/umoja.plymouth
	install -D -m 0644 data/plymouth/umoja/watermark.png \
		debian/ubuntu-umoja-desktop/usr/share/plymouth/themes/umoja/watermark.png
	install -D -m 0644 data/plymouth/umoja-text/umoja-text.plymouth \
		debian/ubuntu-umoja-desktop/usr/share/plymouth/themes/umoja-text/umoja-text.plymouth


override_dh_gencontrol:
	# ubuntu-umoja-desktop's lists, one dependency per line (packaging/meta/update).
	echo "umoja:Depends=$$(paste -sd, $(META).depends | sed 's/,/, /g')" >> debian/ubuntu-umoja-desktop.substvars
	echo "umoja:Recommends=$$(paste -sd, $(META).recommends | sed 's/,/, /g')" >> debian/ubuntu-umoja-desktop.substvars
	dh_gencontrol

override_dh_shlibdeps:
	# lemond gets normal shlib deps; its downloaded/bundled backends under
	# bin/ carry their own private libraries.
	dh_shlibdeps -X/usr/lib/umoja/lemonade/bin -- --ignore-missing-info

override_dh_strip:
	# Don't strip upstream's prebuilt Lemonade binaries.
	dh_strip -X/usr/lib/umoja/lemonade

override_dh_dwz:
	dh_dwz -X/usr/lib/umoja/lemonade

override_dh_clean:
	# dh_clean deletes *.orig files, but vendored crates ship
	# Cargo.toml.orig and list it in .cargo-checksum.json.
	dh_clean -Xvendor/
