Description: Finish NVIDIA frames before releasing client buffers
 NVIDIA's driver doesn't add its reads of imported dma-bufs to their
 implicit fences. render() returning lets clients reuse their buffers
 while the GPU may still be sampling them; a client drawing on the Intel
 iGPU of a hybrid laptop then overwrote a buffer mid-read and its window
 tore on the NVIDIA-driven monitor (GTK GL/Vulkan apps; SHM apps were
 fine). glFinish() after committing a frame on NVIDIA GL.
 MIR_GL_FINISH_AFTER_RENDER=0/1 overrides the vendor check.
Author: Umoja developers
Forwarded: not yet
Last-Update: 2026-11-09
---
--- a/src/platform/renderers/gl/renderer.cpp
+++ b/src/platform/renderers/gl/renderer.cpp
@@ -45,6 +45,7 @@
 #include <algorithm>
 #include <array>
 #include <cstdlib>
+#include <cstring>
 #include <limits>
 #include <optional>
 #include <string>
@@ -1149,6 +1150,25 @@ void mrg::Renderer::tessellate(std::vector<mgl::Primitive>& primitives,
     primitives[0] = mgl::tessellate_renderable_into_rectangle(renderable, geom::Displacement{0,0});
 }
 
+namespace
+{
+/* NVIDIA's driver doesn't add its reads of imported dma-bufs to their
+ * implicit fences. Once render() returns, the renderables are dropped and the
+ * clients get their buffers back (wl_buffer.release, or the release point),
+ * but the GPU may still be reading them: a client drawing on another GPU (the
+ * Intel iGPU of a hybrid laptop) then overwrites a buffer mid-read, and its
+ * window tears on the NVIDIA-driven monitor. Wait for the frame to finish on
+ * such GPUs before letting go. MIR_GL_FINISH_AFTER_RENDER=0/1 overrides.
+ */
+auto finish_after_render() -> bool
+{
+    if (auto const env = getenv("MIR_GL_FINISH_AFTER_RENDER"))
+        return strcmp(env, "0") != 0;
+    auto const vendor = reinterpret_cast<char const*>(glGetString(GL_VENDOR)); //TICS !cppcoreguidelines-pro-type-reinterpret-cast
+    return vendor && strstr(vendor, "NVIDIA");
+}
+}
+
 auto mrg::Renderer::render(mg::RenderableList const& renderables) const -> std::unique_ptr<mg::Framebuffer>
 {
     output_surface->make_current();
@@ -1175,6 +1195,9 @@ auto mrg::Renderer::render(mg::RenderableList const& renderables) const -> std::
 
     auto output = output_surface->commit();
 
+    if (finish_after_render())
+        glFinish();
+
     // Report any GL errors after commit, to catch any *during* commit
     while (auto const gl_error = glGetError())
         mir::log_debug("GL error: %d", gl_error);
