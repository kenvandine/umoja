+/// Redraws a lingering surface when the server fades or scales it (the
+/// compositor stopped watching it when it was removed).
+struct LingeringSurfaceObserver : ms::NullSurfaceObserver
+{
+    LingeringSurfaceObserver(ms::SurfaceStack* stack)
+        : stack{stack}
+    {
+    }
+
+    void alpha_set_to(ms::Surface const*, float) override
+    {
+        stack->emit_scene_changed();
+    }
+
+    void transformation_set_to(ms::Surface const*, glm::mat4 const&) override
+    {
+        stack->emit_scene_changed();
+    }
+
+private:
+    ms::SurfaceStack* stack;
+};
+
+// Close animations. A server that exports this C function is asked, when
+// a surface is removed, whether to keep drawing it (non-zero), and then at
+// each scene whether it still wants it drawn; it fades or scales the
+// surface meanwhile. Without it nothing changes.
+using LingerHook = int (*)(void const* surface);
+
+auto linger_hook() -> LingerHook
+{
+    static LingerHook const hook =
+        reinterpret_cast<LingerHook>(dlsym(RTLD_DEFAULT, "mir_surface_linger_hook"));
+    return hook;
+}
 }
 
