+
+// Umoja: ping and pong for "App is not responding". The server looks up
+// mir_xdg_ping_setup_hook and hands it a function that pings every
+// xdg_wm_base of a process; each pong goes to mir_xdg_pong_hook. Instances
+// are only touched on the Wayland thread.
+namespace
+{
+struct PingTarget
+{
+    pid_t pid;
+    std::function<void(uint32_t)> ping;
 };
+std::map<void const*, PingTarget> ping_instances;
+mir::Executor* ping_executor{nullptr};
+
+using PongHook = void (*)(pid_t pid, uint32_t serial);
+using PingFn = void (*)(pid_t pid, uint32_t serial);
+using PingSetupHook = void (*)(PingFn ping);
+
+void ping_pid(pid_t pid, uint32_t serial);
+}
 
 // XdgShellStable
 
@@ -125,6 +156,9 @@
       output_manager{output_manager},
       surface_registry{surface_registry}
 {
+    ping_executor = &wayland_executor;
+    static auto const setup = reinterpret_cast<PingSetupHook>(dlsym(RTLD_DEFAULT, "mir_xdg_ping_setup_hook"));
+    if (setup) setup(&ping_pid);
 }
 
 void mf::XdgShellStable::bind(wl_resource* new_resource)
@@ -134,8 +168,34 @@
 
 mf::XdgShellStable::Instance::Instance(wl_resource* new_resource, mf::XdgShellStable* shell)
     : XdgWmBase{new_resource, Version<5>()},
-      shell{shell}
+      shell{shell},
+      pid{[this]
+          {
+              auto const session = client->client_session();
+              return session ? session->process_id() : pid_t{0};
+          }()}
+{
+    ping_instances[this] = PingTarget{pid, [this](uint32_t serial) { send_ping_event(serial); }};
+}
+
+mf::XdgShellStable::Instance::~Instance()
 {
+    ping_instances.erase(this);
+}
+
+namespace
+{
+void ping_pid(pid_t pid, uint32_t serial)
+{
+    if (!ping_executor || pid <= 0) return;
+    ping_executor->spawn([pid, serial]
+        {
+            for (auto const& [instance, target] : ping_instances)
+            {
+                if (target.pid == pid) target.ping(serial);
+            }
+        });
+}
 }
 
