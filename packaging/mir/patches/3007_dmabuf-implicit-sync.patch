+namespace
+{
+/* Implicit sync for client dmabufs.
+ *
+ * A client without linux-drm-syncobj may commit a dmabuf its GPU is still
+ * rendering into; the kernel tracks that work as an implicit fence on the
+ * dmabuf. Drivers that sample on the same GPU wait for it, but a different
+ * GPU's driver may not (NVIDIA compositing a window that Mesa rendered on the
+ * Intel iGPU, on hybrid laptops), so half-drawn frames reach the screen as
+ * tearing inside windows. As mutter does, hold such a commit until the
+ * dmabuf is readable (poll() on a dmabuf fd waits for its pending writes).
+ *
+ * Returns a dup of a still-busy plane's dmabuf fd to wait on, or an invalid
+ * Fd if the buffer isn't a dmabuf or is already idle.
+ */
+auto busy_dmabuf_fd(wl_resource* buffer) -> mir::Fd
+{
+    if (!buffer)
+        return mir::Fd{};
+    auto const* const dmabuf = dynamic_cast<mir::graphics::DMABufBuffer const*>(mir::wayland::Buffer::from(buffer));
+    if (!dmabuf)
+        return mir::Fd{};
+    for (auto const& plane : dmabuf->planes())
+    {
+        pollfd pfd{plane.dma_buf, POLLIN, 0};
+        if (poll(&pfd, 1, 0) == 1 && (pfd.revents & POLLIN))
+            continue;
+        if (int const fd = dup(plane.dma_buf); fd >= 0)
+            return mir::Fd{fd};
+    }
+    return mir::Fd{};
+}
+}
