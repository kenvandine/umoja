+#ifndef MIR_GRAPHICS_EGL_CONTEXT_PRIORITY_H_
+#define MIR_GRAPHICS_EGL_CONTEXT_PRIORITY_H_
+
+// Not <mir/log.h>: its printf-style overloads depend on MIR_LOG_COMPONENT,
+// which files including this one may define only afterwards
+#include <mir/logging/logger.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+#include <atomic>
+#include <cstring>
+#include <vector>
+
+namespace mir
+{
+[[gnu::format (printf, 3, 4)]]
+void log(logging::Severity sev, const char *component, char const* fmt, ...);
+}
+
+namespace mir::graphics::common
+{
+/**
+ * eglCreateContext(), asking for a high-priority context where the driver
+ * offers EGL_IMG_context_priority, so the compositor's drawing does not queue
+ * behind a client that keeps the GPU busy (as GNOME's and KDE's compositors
+ * do). Without the extension, or once the driver has refused high priority
+ * (amdgpu and i915 give it only to the DRM master or a process with
+ * CAP_SYS_NICE), it is plain eglCreateContext() with \a attribs.
+ *
+ * Header only, so it adds nothing to the platform ABI.
+ */
+inline auto create_compositor_context(
+    EGLDisplay dpy,
+    EGLConfig config,
+    EGLContext share,
+    EGLint const* attribs) -> EGLContext
+{
+    static std::atomic<bool> refused{false};
+    static std::atomic<bool> reported{false};
+
+    auto const has_extension = [dpy]
+        {
+            char const* const extensions = eglQueryString(dpy, EGL_EXTENSIONS);
+            if (!extensions)
+                return false;
+            char const* const name = "EGL_IMG_context_priority";
+            auto const length = std::strlen(name);
+            for (char const* p = std::strstr(extensions, name); p; p = std::strstr(p + length, name))
+            {
+                if ((p == extensions || p[-1] == ' ') && (p[length] == ' ' || p[length] == '\0'))
+                    return true;
+            }
+            return false;
+        };
+
+    if (!refused && has_extension())
+    {
+        std::vector<EGLint> with_priority;
+        for (auto attrib = attribs; attrib && *attrib != EGL_NONE; attrib += 2)
+        {
+            with_priority.push_back(attrib[0]);
+            with_priority.push_back(attrib[1]);
+        }
+        with_priority.push_back(EGL_CONTEXT_PRIORITY_LEVEL_IMG);
+        with_priority.push_back(EGL_CONTEXT_PRIORITY_HIGH_IMG);
+        with_priority.push_back(EGL_NONE);
+
+        if (auto const ctx = eglCreateContext(dpy, config, share, with_priority.data()); ctx != EGL_NO_CONTEXT)
+        {
+            if (!reported.exchange(true))
+            {
+                EGLint priority{EGL_CONTEXT_PRIORITY_MEDIUM_IMG};
+                eglQueryContext(dpy, ctx, EGL_CONTEXT_PRIORITY_LEVEL_IMG, &priority);
+                // The kernel may still run it at normal priority: amdgpu,
+                // for one, does unless we are DRM master or have CAP_SYS_NICE
+                mir::log(
+                    mir::logging::Severity::informational, "EGL",
+                    "EGL context priority: asked for high, EGL reports %s",
+                    priority == EGL_CONTEXT_PRIORITY_HIGH_IMG ? "high" :
+                    priority == EGL_CONTEXT_PRIORITY_LOW_IMG ? "low" : "medium");
+            }
+            return ctx;
+        }
+
+        eglGetError(); // Clear the error from the refused attempt
+        refused = true;
+        if (!reported.exchange(true))
+        {
+            mir::log(
+                mir::logging::Severity::informational, "EGL",
+                "EGL context priority: medium (the driver refused high priority)");
+        }
+    }
+
+    return eglCreateContext(dpy, config, share, attribs);
+}
+}
+
+#endif // MIR_GRAPHICS_EGL_CONTEXT_PRIORITY_H_
