+void mf::WlSurface::apply_ready_commits()
+{
+    // The newest commit that is ready and brings a frame: older frames still
+    // waiting for their fences are superseded by it
+    auto const newest_frame = std::find_if(
+        fenced_commits.rbegin(), fenced_commits.rend(),
+        [](auto const& c) { return c->ready && c->state.buffer.has_value(); });
+    auto superseded_until = static_cast<size_t>(fenced_commits.rend() - newest_frame);
+
+    // State of superseded commits (all but their frames), for the next one applied
+    std::optional<WlSurfaceState> carried;
+    std::optional<std::list<WlSubsurface*>> carried_order;
+
+    for (size_t i = 0; !fenced_commits.empty(); ++i)
+    {
+        bool const superseded = i < superseded_until && !fenced_commits.front()->ready;
+        if (!fenced_commits.front()->ready && !superseded)
+            break;
+
+        auto entry = std::move(fenced_commits.front());
+        fenced_commits.pop_front();
+
+        if (superseded)
+        {
+            entry->drop_frame();
+            if (!carried)
+                carried.emplace();
+            carried->update_from(entry->state);
+            if (entry->surface_order)
+                carried_order = std::move(entry->surface_order);
+            continue;
+        }
+
+        auto state = std::move(entry->state);
+        if (carried)
+        {
+            carried->update_from(state);
+            state = std::move(*carried);
+            carried.reset();
+        }
+        auto surface_order = entry->surface_order ? std::move(entry->surface_order) : std::move(carried_order);
+        carried_order.reset();
+
+        apply_commit(std::move(state), std::move(surface_order));
+    }
