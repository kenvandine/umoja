Description: Don't probe connectors that Intel's driver already knows are empty
 drmModeGetConnector forces a fresh probe. On an Intel DisplayPort/USB-C
 port with nothing plugged in that waits for AUX timeouts: 0.68 s per port
 on a ThinkPad P16 Gen 3, which has two such ports. Mir asks about every
 connector four times over while it starts, so 5.5 s of the 6.6 s between
 exec and "ready" went to probing two empty ports, with the screen black
 (login to desktop, and the greeter at boot).
 .
 i915 and xe run detection themselves on a hotplug interrupt, before the
 uevent. So on those drivers, when the kernel's kept state
 (drmModeGetConnectorCurrent) says a connector is disconnected, use that.
 A connector reported connected or unknown is still probed (quick, and
 its mode list is only refreshed by a probe), and other drivers are always
 probed: with the first version of this patch nvidia-drm went on
 reporting an unplugged monitor as connected.
 MIR_DRM_ALWAYS_PROBE=1 restores the old behaviour.
Author: Umoja developers
Forwarded: no

diff --git src/platform/graphics/kms/drm_mode_resources.cpp src/platform/graphics/kms/drm_mode_resources.cpp
--- a/src/platform/graphics/kms/drm_mode_resources.cpp
+++ b/src/platform/graphics/kms/drm_mode_resources.cpp
@@ -18,6 +18,9 @@
 
 #include <boost/throw_exception.hpp>
 #include <drm_mode.h>
+#include <cstdlib>
+#include <memory>
+#include <string_view>
 #include <system_error>
 #include <format>
 #include <xf86drm.h>
@@ -139,10 +142,69 @@
     return get_crtc(drm_fd, id);
 }
 
+namespace
+{
+/* drmModeGetConnector makes the kernel probe the connector again. On an
+ * Intel DisplayPort/USB-C port with nothing plugged in that waits for AUX
+ * timeouts (0.68 s per port on a ThinkPad P16 Gen 3), and Mir asks about
+ * every connector several times while it starts: 5.5 s of a 6.6 s startup
+ * went to probing two empty ports eight times.
+ *
+ * i915 and xe detect a plug or unplug themselves before they send the
+ * hotplug event, so when they say a port is empty, believe them without a
+ * probe. A port they report as connected is still probed (that is quick,
+ * and its mode list is only refreshed by a probe), and so is everything on
+ * other drivers: nvidia-drm kept reporting an unplugged monitor as
+ * connected until asked to probe.
+ * MIR_DRM_ALWAYS_PROBE=1 restores the probe on every query.
+ */
+auto always_probe() -> bool
+{
+    static bool const enabled = []
+        {
+            auto const env = getenv("MIR_DRM_ALWAYS_PROBE");
+            return env && env[0] != '\0' && env[0] != '0';
+        }();
+    return enabled;
+}
+
+auto driver_detects_hotplug(int drm_fd) -> bool
+{
+    std::unique_ptr<drmVersion, void (*)(drmVersionPtr)> const version{drmGetVersion(drm_fd), &drmFreeVersion};
+    if (!version || !version->name)
+    {
+        return false;
+    }
+    std::string_view const name{version->name, static_cast<size_t>(version->name_len)};
+    return name == "i915" || name == "xe";
+}
+
+auto known_empty_connector(int drm_fd, uint32_t id) -> drmModeConnector*
+{
+    if (always_probe() || !driver_detects_hotplug(drm_fd))
+    {
+        return nullptr;
+    }
+    auto const connector = drmModeGetConnectorCurrent(drm_fd, id);
+    if (connector && connector->connection != DRM_MODE_DISCONNECTED)
+    {
+        drmModeFreeConnector(connector);
+        return nullptr;
+    }
+    return connector;
+}
+}
+
 mgk::DRMModeConnectorUPtr mgk::get_connector(int drm_fd, uint32_t id)
 {
     errno = 0;
-    DRMModeConnectorUPtr connector{drmModeGetConnector(drm_fd, id), &drmModeFreeConnector};
+    auto raw = known_empty_connector(drm_fd, id);
+    if (!raw)
+    {
+        errno = 0;
+        raw = drmModeGetConnector(drm_fd, id);
+    }
+    DRMModeConnectorUPtr connector{raw, &drmModeFreeConnector};
 
     if (!connector)
     {
