Description: Don't make the kernel probe every connector again at each query
 drmModeGetConnector forces a fresh probe. On a DisplayPort/USB-C port with
 nothing plugged in that waits for AUX timeouts: 0.68 s per port on a
 ThinkPad P16 Gen 3, which has two such ports on the Intel GPU. Mir asks
 about every connector four times over while it starts, so 5.5 s of the
 6.6 s between exec and "ready" went to probing two empty ports, with the
 screen black (login to desktop, and the greeter at boot).
 .
 The kernel probes on hotplug and keeps the result, so use
 drmModeGetConnectorCurrent, and fall back to a probe only when the kernel
 has never probed the connector or reports it connected without modes.
 MIR_DRM_ALWAYS_PROBE=1 restores the old behaviour.
Author: Umoja developers
Forwarded: no

diff --git src/platform/graphics/kms/drm_mode_resources.cpp src/platform/graphics/kms/drm_mode_resources.cpp
--- a/src/platform/graphics/kms/drm_mode_resources.cpp
+++ b/src/platform/graphics/kms/drm_mode_resources.cpp
@@ -18,6 +18,7 @@
 
 #include <boost/throw_exception.hpp>
 #include <drm_mode.h>
+#include <cstdlib>
 #include <system_error>
 #include <format>
 #include <xf86drm.h>
@@ -139,10 +140,59 @@
     return get_crtc(drm_fd, id);
 }
 
+namespace
+{
+/* drmModeGetConnector makes the kernel probe the connector again. On a
+ * DisplayPort/USB-C port with nothing plugged in that waits for AUX
+ * timeouts (0.68 s per port on a ThinkPad P16 Gen 3), and Mir asks about
+ * every connector several times while it starts: 5.5 s of a 6.6 s startup
+ * went to probing two empty ports eight times. The kernel already probes
+ * when something is plugged or unplugged and keeps the result, so read
+ * that, and only probe when the kernel has nothing useful yet.
+ * MIR_DRM_ALWAYS_PROBE=1 restores the probe on every query.
+ */
+auto always_probe() -> bool
+{
+    static bool const enabled = []
+        {
+            auto const env = getenv("MIR_DRM_ALWAYS_PROBE");
+            return env && env[0] != '\0' && env[0] != '0';
+        }();
+    return enabled;
+}
+
+auto current_connector(int drm_fd, uint32_t id) -> drmModeConnector*
+{
+    if (always_probe())
+    {
+        return nullptr;
+    }
+    auto const connector = drmModeGetConnectorCurrent(drm_fd, id);
+    if (!connector)
+    {
+        return nullptr;
+    }
+    bool const never_probed = connector->connection == DRM_MODE_UNKNOWNCONNECTION;
+    bool const no_modes = connector->connection == DRM_MODE_CONNECTED && connector->count_modes == 0;
+    if (never_probed || no_modes)
+    {
+        drmModeFreeConnector(connector);
+        return nullptr;
+    }
+    return connector;
+}
+}
+
 mgk::DRMModeConnectorUPtr mgk::get_connector(int drm_fd, uint32_t id)
 {
     errno = 0;
-    DRMModeConnectorUPtr connector{drmModeGetConnector(drm_fd, id), &drmModeFreeConnector};
+    auto raw = current_connector(drm_fd, id);
+    if (!raw)
+    {
+        errno = 0;
+        raw = drmModeGetConnector(drm_fd, id);
+    }
+    DRMModeConnectorUPtr connector{raw, &drmModeFreeConnector};
 
     if (!connector)
     {
