+/* Umoja: blur behind surfaces that ask for it (ext-background-effect-v1).
+ *
+ * Before a renderable with a blur region is drawn, the part of the frame
+ * behind it is grabbed (glBlitFramebuffer, or glCopyTexSubImage2D on GLES2),
+ * blurred with a few dual-Kawase down/up passes at reduced resolution, and
+ * drawn back over the blur region. The blurred background is weighted by
+ * the surface's own alpha, so rounded corners and soft shadows inside the
+ * region stay unblurred, and by the renderable's alpha so fades work. Then
+ * the surface itself is drawn on top as usual.
+ */
+namespace
+{
+#ifndef GL_READ_FRAMEBUFFER
+#define GL_READ_FRAMEBUFFER 0x8CA8
+#endif
+#ifndef GL_DRAW_FRAMEBUFFER
+#define GL_DRAW_FRAMEBUFFER 0x8CA9
+#endif
+#ifndef GL_READ_FRAMEBUFFER_BINDING
+#define GL_READ_FRAMEBUFFER_BINDING 0x8CAA
+#endif
+
+using BlitFramebufferFn = void (*)(GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLbitfield, GLenum);
+
+auto blur_env(char const* name, float fallback, float min, float max) -> float
+{
+    if (auto const value = getenv(name))
+    {
+        try
+        {
+            return std::clamp(std::stof(value), min, max);
+        }
+        catch (std::exception const&)
+        {
+        }
+    }
+    return fallback;
+}
+
+auto blur_compile_shader(GLenum type, GLchar const* src) -> GLuint
+{
+    GLuint id = glCreateShader(type);
+    if (!id)
+    {
+        BOOST_THROW_EXCEPTION(mg::gl_error("Failed to create blur shader"));
+    }
+    glShaderSource(id, 1, &src, NULL);
+    glCompileShader(id);
+    GLint ok{0};
+    glGetShaderiv(id, GL_COMPILE_STATUS, &ok);
+    if (!ok)
+    {
+        GLchar log[1024] = "(No log info)";
+        glGetShaderInfoLog(id, sizeof log, NULL, log);
+        glDeleteShader(id);
+        BOOST_THROW_EXCEPTION(std::runtime_error(std::string("Blur shader compile failed: ") + log + " for:\n" + src));
+    }
+    return id;
+}
+
+auto blur_link_program(GLuint vertex, GLuint fragment) -> GLuint
+{
+    GLuint program = glCreateProgram();
+    glAttachShader(program, vertex);
+    glAttachShader(program, fragment);
+    glLinkProgram(program);
+    GLint ok{0};
+    glGetProgramiv(program, GL_LINK_STATUS, &ok);
+    if (!ok)
+    {
+        GLchar log[1024] = "(No log info)";
+        glGetProgramInfoLog(program, sizeof log - 1, NULL, log);
+        log[sizeof log - 1] = '\0';
+        glDeleteProgram(program);
+        BOOST_THROW_EXCEPTION(std::runtime_error(std::string("Linking blur shader failed: ") + log));
+    }
+    return program;
+}
+
+GLchar const* const blur_pass_vertex_src =
+    "attribute vec2 position;\n"
+    "attribute vec2 texcoord;\n"
+    "varying vec2 v_texcoord;\n"
+    "void main() {\n"
+    "    gl_Position = vec4(position, 0.0, 1.0);\n"
+    "    v_texcoord = texcoord;\n"
+    "}\n";
+
+// Dual-Kawase ("dual filter") blur, as in KWin and most compositors.
+GLchar const* const blur_down_src =
+    "#ifdef GL_ES\n"
+    "precision mediump float;\n"
+    "#endif\n"
+    "uniform sampler2D tex;\n"
+    "uniform vec2 halfpixel;\n"
+    "uniform float offset;\n"
+    "varying vec2 v_texcoord;\n"
+    "void main() {\n"
+    "    vec2 uv = v_texcoord;\n"
+    "    vec2 o = halfpixel * offset;\n"
+    "    vec4 sum = texture2D(tex, uv) * 4.0;\n"
+    "    sum += texture2D(tex, uv - o);\n"
+    "    sum += texture2D(tex, uv + o);\n"
+    "    sum += texture2D(tex, uv + vec2(o.x, -o.y));\n"
+    "    sum += texture2D(tex, uv - vec2(o.x, -o.y));\n"
+    "    gl_FragColor = sum / 8.0;\n"
+    "}\n";
+
+GLchar const* const blur_up_src =
+    "#ifdef GL_ES\n"
+    "precision mediump float;\n"
+    "#endif\n"
+    "uniform sampler2D tex;\n"
+    "uniform vec2 halfpixel;\n"
+    "uniform float offset;\n"
+    "varying vec2 v_texcoord;\n"
+    "void main() {\n"
+    "    vec2 uv = v_texcoord;\n"
+    "    vec2 o = halfpixel * offset;\n"
+    "    vec4 sum = texture2D(tex, uv + vec2(-o.x * 2.0, 0.0));\n"
+    "    sum += texture2D(tex, uv + vec2(-o.x, o.y)) * 2.0;\n"
+    "    sum += texture2D(tex, uv + vec2(0.0, o.y * 2.0));\n"
+    "    sum += texture2D(tex, uv + vec2(o.x, o.y)) * 2.0;\n"
+    "    sum += texture2D(tex, uv + vec2(o.x * 2.0, 0.0));\n"
+    "    sum += texture2D(tex, uv + vec2(o.x, -o.y)) * 2.0;\n"
+    "    sum += texture2D(tex, uv + vec2(0.0, -o.y * 2.0));\n"
+    "    sum += texture2D(tex, uv + vec2(-o.x, -o.y)) * 2.0;\n"
+    "    gl_FragColor = sum / 12.0;\n"
+    "}\n";
+
+struct BlurPassProgram
+{
+    explicit BlurPassProgram(GLuint id)
+        : id{id},
+          position{glGetAttribLocation(id, "position")},
+          texcoord{glGetAttribLocation(id, "texcoord")},
+          tex{glGetUniformLocation(id, "tex")},
+          halfpixel{glGetUniformLocation(id, "halfpixel")},
+          offset{glGetUniformLocation(id, "offset")}
+    {
+    }
+
+    ProgramHandle id;
+    GLint position, texcoord, tex, halfpixel, offset;
+};
+
+/// The program that draws the blurred background into the frame: the
+/// renderer's vertex shader, so it lands exactly where the surface does,
+/// and a fragment shader built on the surface texture's sample_to_rgba(),
+/// so it can use the surface's alpha as a mask.
+struct BlurMaskProgram : mg::gl::Program
+{
+    explicit BlurMaskProgram(GLuint handle)
+        : handle{handle},
+          uniforms{handle},
+          blur_tex{glGetUniformLocation(handle, "blur_tex")},
+          blur_box{glGetUniformLocation(handle, "blur_box")},
+          use_alpha_mask{glGetUniformLocation(handle, "use_alpha_mask")}
+    {
+    }
+
+    ProgramHandle handle;
+    mrg::Renderer::Program uniforms;
+    GLint blur_tex, blur_box, use_alpha_mask;
+};
+
+class BlurMaskProgramFactory : public mg::gl::ProgramFactory
+{
+public:
+    // NOTE: This must be called with a current GL context
+    BlurMaskProgramFactory()
+        : vertex_shader{blur_compile_shader(GL_VERTEX_SHADER, vertex_shader_src)}
+    {
+    }
+
+    auto compile_fragment_shader(void const* id, char const* extension_fragment, char const* fragment_fragment)
+        -> mg::gl::Program& override
+    {
+        for (auto const& [cached_id, program] : programs)
+        {
+            if (cached_id == id)
+            {
+                return *program;
+            }
+        }
+
+        std::stringstream fragment;
+        fragment
+            << extension_fragment
+            << "\n"
+            << "#ifdef GL_ES\n"
+               "precision mediump float;\n"
+               "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+               "#define BLUR_HIGHP highp\n"
+               "#else\n"
+               "#define BLUR_HIGHP mediump\n"
+               "#endif\n"
+               "#else\n"
+               "#define BLUR_HIGHP\n"
+               "#endif\n"
+            << "\n"
+            << fragment_fragment
+            << "\n"
+            << "varying vec2 v_texcoord;\n"
+               "uniform float alpha;\n"
+               "uniform float use_alpha_mask;\n"
+               "uniform sampler2D blur_tex;\n"
+               "uniform BLUR_HIGHP vec4 blur_box;\n"
+               "void main() {\n"
+               // Blur behind the opaque-ish body of the surface only: not
+               // behind its transparent corners or its faint shadow.
+               "    float a = mix(1.0, sample_to_rgba(v_texcoord).a, use_alpha_mask);\n"
+               "    float coverage = smoothstep(0.3, 0.6, a) * alpha;\n"
+               "    BLUR_HIGHP vec2 uv = (gl_FragCoord.xy - blur_box.xy) * blur_box.zw;\n"
+               "    gl_FragColor = vec4(texture2D(blur_tex, uv).rgb, 1.0) * coverage;\n"
+               "}\n";
+
+        GLuint const fragment_shader = blur_compile_shader(GL_FRAGMENT_SHADER, fragment.str().c_str());
+        GLuint program{0};
+        try
+        {
+            program = blur_link_program(vertex_shader, fragment_shader);
+        }
+        catch (...)
+        {
+            glDeleteShader(fragment_shader);
+            throw;
+        }
+        glDeleteShader(fragment_shader);
+
+        programs.emplace_back(id, std::make_unique<BlurMaskProgram>(program));
+        return *programs.back().second;
+    }
+
+private:
+    ShaderHandle const vertex_shader;
+    std::vector<std::pair<void const*, std::unique_ptr<BlurMaskProgram>>> programs;
+};
+
+struct BlurLevel
+{
+    BlurLevel(GLsizei width, GLsizei height)
+        : width{width},
+          height{height},
+          texture{make_texture(width, height)},
+          framebuffer{make_framebuffer(texture)}
+    {
+    }
+
+    static auto make_texture(GLsizei width, GLsizei height) -> GLuint
+    {
+        GLuint tex{0};
+        glGenTextures(1, &tex);
+        glBindTexture(GL_TEXTURE_2D, tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        return tex;
+    }
+
+    static auto make_framebuffer(GLuint tex) -> GLuint
+    {
+        GLint previous{0};
+        glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+        GLuint fb{0};
+        glGenFramebuffers(1, &fb);
+        glBindFramebuffer(GL_FRAMEBUFFER, fb);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+        glBindFramebuffer(GL_FRAMEBUFFER, previous);
+        return fb;
+    }
+
+    GLsizei const width;
+    GLsizei const height;
+    TextureHandle const texture;
+    FramebufferHandle const framebuffer;
+};
+
+/// Blur textures for one surface: levels[0] is half the grabbed box, each
+/// further level half the one before. `grab` holds the full-size copy when
+/// glBlitFramebuffer is not available.
+struct BlurChain
+{
+    GLsizei box_width{0};
+    GLsizei box_height{0};
+    std::optional<TextureHandle> grab;
+    std::vector<std::unique_ptr<BlurLevel>> levels;
+    long long last_used_frame{0};
+};
+}
+
+/// Per-output blur state, owned by the OutputFilter so it lives and dies on
+/// the output's GL context.
+class mrg::Renderer::BackgroundBlur
+{
+public:
+    // NOTE: This must be called with a current GL context
+    BackgroundBlur()
+        : passes{static_cast<int>(blur_env("MIR_BLUR_PASSES", 3, 1, 6))},
+          offset{blur_env("MIR_BLUR_OFFSET", 2.0f, 0.5f, 8.0f)},
+          blit{find_blit()}
+    {
+        ShaderHandle const vertex{blur_compile_shader(GL_VERTEX_SHADER, blur_pass_vertex_src)};
+        ShaderHandle const down_fragment{blur_compile_shader(GL_FRAGMENT_SHADER, blur_down_src)};
+        ShaderHandle const up_fragment{blur_compile_shader(GL_FRAGMENT_SHADER, blur_up_src)};
+        down = std::make_unique<BlurPassProgram>(blur_link_program(vertex, down_fragment));
+        up = std::make_unique<BlurPassProgram>(blur_link_program(vertex, up_fragment));
+        mir::log_info(
+            "Background blur: %d passes, offset %.1f, %s",
+            passes, offset, blit ? "glBlitFramebuffer" : "glCopyTexSubImage2D");
+    }
+
+    /// How far (in framebuffer pixels) the blur reaches outside the region.
+    auto padding() const -> int
+    {
+        return static_cast<int>(std::ceil(offset * static_cast<float>(4 << passes)));
+    }
+
+    /// Grabs `box` (framebuffer pixels, GL's bottom-left origin) from
+    /// `target` and blurs it. Returns the texture holding the result, which
+    /// covers exactly `box`. Leaves `target` bound for drawing.
+    auto blur(void const* id, GLint target, GLint read_target, std::array<GLint, 4> box, long long frame) -> GLuint
+    {
+        auto& chain = chain_for(id, box[2], box[3]);
+        chain.last_used_frame = frame;
+
+        glDisable(GL_BLEND);
+        glDisable(GL_SCISSOR_TEST);
+
+        auto& first = *chain.levels.front();
+        if (blit)
+        {
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, target);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, first.framebuffer);
+            blit(box[0], box[1], box[0] + box[2], box[1] + box[3],
+                 0, 0, first.width, first.height,
+                 GL_COLOR_BUFFER_BIT, GL_LINEAR);
+        }
+        else
+        {
+            glBindFramebuffer(GL_FRAMEBUFFER, target);
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, *chain.grab);
+            glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, box[0], box[1], box[2], box[3]);
+            run_pass(*down, *chain.grab, box[2], box[3], first);
+        }
+
+        for (size_t i = 0; i + 1 < chain.levels.size(); ++i)
+        {
+            run_pass(*down, chain.levels[i]->texture, chain.levels[i]->width, chain.levels[i]->height, *chain.levels[i + 1]);
+        }
+        for (size_t i = chain.levels.size() - 1; i > 0; --i)
+        {
+            run_pass(*up, chain.levels[i]->texture, chain.levels[i]->width, chain.levels[i]->height, *chain.levels[i - 1]);
+        }
+
+        if (blit)
+        {
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, read_target);
+            glBindFramebuffer(GL_DRAW_FRAMEBUFFER, target);
+        }
+        else
+        {
+            glBindFramebuffer(GL_FRAMEBUFFER, target);
+        }
+        return first.texture;
+    }
+
+    /// Drop the textures of surfaces that stopped asking for blur.
+    void end_frame(long long frame)
+    {
+        std::erase_if(chains, [frame](auto const& entry) { return frame - entry.second.last_used_frame > 120; });
+    }
+
+    BlurMaskProgramFactory mask_programs;
+
+private:
+    static auto find_blit() -> BlitFramebufferFn
+    {
+        // glBlitFramebuffer is GLES 3.0 (and desktop GL 3.0).
+        auto const version = reinterpret_cast<char const*>(glGetString(GL_VERSION));
+        if (!version)
+        {
+            return nullptr;
+        }
+        std::string const v{version};
+        auto const es = v.find("OpenGL ES ");
+        auto const number = es == std::string::npos ? v : v.substr(es + 10);
+        if (number.empty() || number[0] < '3' || number[0] > '9')
+        {
+            return nullptr;
+        }
+        return reinterpret_cast<BlitFramebufferFn>(eglGetProcAddress("glBlitFramebuffer"));
+    }
+
+    auto chain_for(void const* id, GLsizei width, GLsizei height) -> BlurChain&
+    {
+        auto& chain = chains[id];
+        if (chain.box_width != width || chain.box_height != height || chain.levels.empty())
+        {
+            chain.levels.clear();
+            chain.grab.reset();
+            chain.box_width = width;
+            chain.box_height = height;
+            if (!blit)
+            {
+                GLuint tex{0};
+                glGenTextures(1, &tex);
+                glBindTexture(GL_TEXTURE_2D, tex);
+                // GL_RGB: glCopyTexSubImage2D needs a subset of the
+                // framebuffer's channels, which may not include alpha.
+                glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, width, height, 0, GL_RGB, GL_UNSIGNED_BYTE, nullptr);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+                chain.grab.emplace(tex);
+            }
+            for (int level = 1; level <= passes + 1; ++level)
+            {
+                chain.levels.push_back(std::make_unique<BlurLevel>(
+                    std::max<GLsizei>(1, width >> level),
+                    std::max<GLsizei>(1, height >> level)));
+            }
+        }
+        return chain;
+    }
+
+    void run_pass(BlurPassProgram const& program, GLuint source, GLsizei source_width, GLsizei source_height,
+                  BlurLevel const& destination) const
+    {
+        glBindFramebuffer(GL_FRAMEBUFFER, destination.framebuffer);
+        glViewport(0, 0, destination.width, destination.height);
+        glUseProgram(program.id);
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, source);
+        glUniform1i(program.tex, 0);
