+namespace mw = mir::wayland;
+namespace geom = mir::geometry;
+
+namespace
+{
+// Surfaces that already have an effect object (background_effect_exists).
+// Only touched on the Wayland thread.
+std::unordered_set<mf::WlSurface const*> surfaces_with_effect;
+
+class BackgroundEffectSurfaceV1 : public mw::BackgroundEffectSurfaceV1
+{
+public:
+    BackgroundEffectSurfaceV1(wl_resource* resource, mf::WlSurface* surface)
+        : mw::BackgroundEffectSurfaceV1{resource, Version<1>()},
+          surface{surface},
+          raw_surface{surface},
+          stream{surface->stream.get()},
+          surface_destroyed_id{surface->add_destroy_listener([this]() { surface_gone(); })}
+    {
+        surfaces_with_effect.insert(raw_surface);
+    }
+
+    ~BackgroundEffectSurfaceV1()
+    {
+        if (surface)
+        {
+            surface.value().remove_destroy_listener(surface_destroyed_id);
+            surface_gone();
+        }
+    }
+
+private:
+    void set_blur_region(std::optional<wl_resource*> const& region) override
+    {
+        if (!surface)
+        {
+            throw mw::ProtocolError{
+                resource, Error::surface_destroyed, "ext_background_effect_surface_v1 used after its surface was destroyed"};
+        }
+
+        // The protocol makes the region double-buffered state. Applying it
+        // straight away is close enough: clients set it and commit together,
+        // and the renderer clips it to whatever the surface is showing.
+        std::optional<geom::Rectangles> blur;
+        if (region)
+        {
+            geom::Rectangles rects;
+            for (auto const& rect : mf::WlRegion::from(region.value())->rectangle_vector())
+            {
+                rects.add(rect);
+            }
+            blur = rects;
+        }
+        mg::background_blur::set_region(stream, blur);
+    }
+
+    void surface_gone()
+    {
+        mg::background_blur::set_region(stream, std::nullopt);
+        surfaces_with_effect.erase(raw_surface);
+        surface = {};
+    }
+
+    mw::Weak<mf::WlSurface> surface;
+    mf::WlSurface const* const raw_surface;
+    void const* const stream;
+    mw::DestroyListenerId const surface_destroyed_id;
+};
+
+class BackgroundEffectManagerV1 : public mw::BackgroundEffectManagerV1
+{
+public:
+    BackgroundEffectManagerV1(wl_resource* resource)
+        : mw::BackgroundEffectManagerV1{resource, Version<1>()}
+    {
+        send_capabilities_event(Capability::blur);
+    }
+
+private:
+    void get_background_effect(wl_resource* id, wl_resource* surface) override
+    {
+        auto const wl_surface = mf::WlSurface::from(surface);
+        if (surfaces_with_effect.contains(wl_surface))
+        {
+            throw mw::ProtocolError{
+                resource, Error::background_effect_exists, "Surface already has a background effect object"};
+        }
+        new BackgroundEffectSurfaceV1{id, wl_surface};
+    }
+};
+
+class BackgroundEffectManagerV1Global : public mw::BackgroundEffectManagerV1::Global
+{
+public:
+    BackgroundEffectManagerV1Global(wl_display* display)
+        : Global{display, Version<1>()}
+    {
+    }
+
+private:
+    void bind(wl_resource* new_resource) override
+    {
+        new BackgroundEffectManagerV1{new_resource};
+    }
+};
+}
+
+auto mf::create_background_effect_manager_v1(wl_display* display)
+    -> std::shared_ptr<mw::BackgroundEffectManagerV1::Global>
+{
+    return std::make_shared<BackgroundEffectManagerV1Global>(display);
+}
