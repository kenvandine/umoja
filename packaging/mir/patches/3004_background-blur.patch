+#include <mir/graphics/background_blur.h>
+
+#include <atomic>
+#include <mutex>
+#include <unordered_map>
+
+namespace mg = mir::graphics;
+namespace geom = mir::geometry;
+
+namespace
+{
+std::mutex regions_mutex;
+std::unordered_map<void const*, geom::Rectangles> regions;
+std::atomic<bool> have_regions{false};
+}
+
+void mg::background_blur::set_region(void const* stream, std::optional<geom::Rectangles> const& region)
+{
+    std::lock_guard lock{regions_mutex};
+    if (region && region->bounding_rectangle().size != geom::Size{})
+    {
+        regions[stream] = region.value();
+    }
+    else
+    {
+        regions.erase(stream);
+    }
+    have_regions = !regions.empty();
+}
+
+auto mg::background_blur::region(void const* stream) -> std::optional<geom::Rectangles>
+{
+    if (!have_regions)
+    {
+        return std::nullopt;
+    }
+    std::lock_guard lock{regions_mutex};
+    auto const i = regions.find(stream);
+    if (i == regions.end())
+    {
+        return std::nullopt;
+    }
+    return i->second;
+}
+
+auto mg::background_blur::any() -> bool
+{
+    return have_regions;
+}
