+namespace
+{
+/// How long frame callbacks wait for the compositor to use their buffer
+/// before they are answered anyway.
+auto const unconsumed_frame_timeout = std::chrono::milliseconds{500};
+}
+
+/* Frame callbacks committed with a buffer are answered when a compositor
+ * uses (consumes) that buffer. A surface that is fully covered, such as a
+ * window starting under a full-screen layer surface, has its buffers
+ * skipped as occluded, so its callbacks wait, and toolkits that draw only
+ * on a frame callback (GTK) stop drawing. Uncovering the surface does not
+ * always lead to a composite that uses the waiting buffer, so the client
+ * stayed frozen (input still worked) until something redrew the whole
+ * screen, such as a VT switch.
+ *
+ * So answer callbacks whose buffer has not been used after a while, as
+ * other compositors throttle hidden surfaces rather than stall them. A
+ * hidden client animates at about 1 Hz; a visible one has its buffer used
+ * within a frame and never gets here.
+ */
+void mf::WlSurface::schedule_unconsumed_frame_fallback()
+{
+    if (!unconsumed_frame_executor || unconsumed_frame_fallback_scheduled)
+        return;
+    unconsumed_frame_fallback_scheduled = true;
+    unconsumed_frame_executor->spawn(
+        [executor = wayland_executor, weak_self = mw::make_weak(this)]
+        {
+            executor->spawn(
+                [weak_self]()
+                {
+                    if (!weak_self)
+                        return;
+                    auto& self = weak_self.value();
+                    self.unconsumed_frame_fallback_scheduled = false;
+                    if (self.frame_callbacks.empty())
+                        return;
+                    if (std::chrono::steady_clock::now() - self.frame_callbacks_since < unconsumed_frame_timeout)
+                    {
+                        // Committed just before this batch fired: give it a full wait.
+                        self.schedule_unconsumed_frame_fallback();
+                        return;
+                    }
+                    self.send_frame_callbacks(self.frame_callbacks);
+                });
+        });
+}
