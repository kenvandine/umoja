+/* The compositor's own logind session, if XDG_SESSION_ID names one.
+ *
+ * seat0's ActiveSession is only ours when we start in the foreground. A
+ * compositor restarted inside its login (after a crash) while the user is on
+ * another VT took control of *that* session instead: it was paused when the
+ * user switched back, and as its own session's Active changes were never
+ * watched it stayed paused for good.
+ */
+std::optional<std::string> object_path_for_own_session(GDBusConnection* connection)
+{
+    auto const id = getenv("XDG_SESSION_ID");
+    if (!id || !*id)
+    {
+        return std::nullopt;
+    }
+
+    GErrorPtr error;
+    std::unique_ptr<GVariant, decltype(&g_variant_unref)> const result{
+        g_dbus_connection_call_sync(
+            connection,
+            "org.freedesktop.login1",
+            "/org/freedesktop/login1",
+            "org.freedesktop.login1.Manager",
+            "GetSession",
+            g_variant_new("(s)", id),
+            G_VARIANT_TYPE("(o)"),
+            G_DBUS_CALL_FLAGS_NO_AUTO_START,
+            10000,
+            nullptr,
+            &error),
+        &g_variant_unref};
+
+    if (!result)
+    {
+        mir::log_warning(
+            "logind has no session %s (%s); using the seat's active session",
+            id, error ? error->message : "unknown error");
+        return std::nullopt;
+    }
+
+    gchar const* path = nullptr;
+    g_variant_get(result.get(), "(&o)", &path);
+    mir::log_debug("Discovered object path for own session %s = %s", id, path);
+    return std::string{path};
+}
+
+std::string object_path_for_session(GDBusConnection* connection, LogindSeat* seat_proxy)
+{
+    if (auto own = object_path_for_own_session(connection))
+    {
+        return *own;
+    }
+    return object_path_for_current_session(seat_proxy);
+}
