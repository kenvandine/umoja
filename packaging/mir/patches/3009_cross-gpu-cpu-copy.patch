+/* Buffers for the cross-GPU CPU copies (see DmabufTexBuffer::cpu_copy).
+ *
+ * A window on the other GPU's monitor is copied on every commit. Taking a
+ * fresh buffer each time meant zeroing and faulting in megabytes of new
+ * memory per frame (19 MB for a 3368x1408 window) and a new texture
+ * allocation on the drawing GPU; a buffer nobody holds any more is reused
+ * instead, keeping its texture.
+ */
+class CrossGpuCopyPool
+{
+public:
+    auto take(geom::Size size) -> std::shared_ptr<mgc::MemoryBackedShmBuffer>
+    {
+        std::lock_guard lock{mutex};
+        for (auto const& b : buffers)
+        {
+            // Only the pool holds it: no texture or client buffer uses it.
+            if (b.use_count() == 1 && b->size() == size)
+            {
+                return b;
+            }
+        }
+        if (buffers.size() >= max_buffers)
+        {
+            std::erase_if(buffers, [](auto const& b) { return b.use_count() == 1; });
+        }
+        auto b = std::make_shared<mgc::MemoryBackedShmBuffer>(size, mir_pixel_format_argb_8888);
+        if (buffers.size() < max_buffers)
+        {
+            buffers.push_back(b);
+        }
+        return b;
+    }
+
+private:
+    static std::size_t constexpr max_buffers{8};
+    std::mutex mutex;
+    std::vector<std::shared_ptr<mgc::MemoryBackedShmBuffer>> buffers;
+};
+
+auto cross_gpu_copy_pool() -> CrossGpuCopyPool&
+{
+    static CrossGpuCopyPool pool;
+    return pool;
+}
+
+/* While $XDG_RUNTIME_DIR/umoja-debug-windows exists (Umoja's window debug
+ * switch), log how much cross-GPU copying happened every 10 s. */
+class CrossGpuCopyStats
+{
+public:
+    void add(std::size_t bytes, std::chrono::nanoseconds took, geom::Size size)
+    {
+        copies.fetch_add(1, std::memory_order_relaxed);
+        total_bytes.fetch_add(bytes, std::memory_order_relaxed);
+        total_ns.fetch_add(took.count(), std::memory_order_relaxed);
+        {
+            std::lock_guard lock{sizes_mutex};
+            ++sizes[{size.width.as_int(), size.height.as_int()}];
+        }
+
+        auto const now = std::chrono::steady_clock::now().time_since_epoch().count();
+        auto last = last_report.load(std::memory_order_relaxed);
+        if (last == 0)
+        {
+            last_report.compare_exchange_strong(last, now);
+            return;
+        }
+        auto const interval = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+            std::chrono::seconds{10}).count();
+        if (now - last < interval || !last_report.compare_exchange_strong(last, now))
+        {
+            return;
+        }
+        auto const n = copies.exchange(0);
+        auto const b = total_bytes.exchange(0);
+        auto const ns = total_ns.exchange(0);
+        // Which windows (by buffer size) were copied most.
+        std::vector<std::pair<unsigned, std::pair<int, int>>> by_count;
+        {
+            std::lock_guard lock{sizes_mutex};
+            for (auto const& [wh, count] : sizes)
+            {
+                by_count.emplace_back(count, wh);
+            }
+            sizes.clear();
+        }
+        if (!debugging())
+        {
+            return;
+        }
+        std::sort(by_count.rbegin(), by_count.rend());
+        std::string top;
+        for (std::size_t i = 0; i < by_count.size() && i < 4; ++i)
+        {
+            top += (i ? ", " : "") + std::to_string(by_count[i].second.first) + "x" +
+                std::to_string(by_count[i].second.second) + " x" + std::to_string(by_count[i].first);
+        }
+        mir::log_info(
+            "Cross-GPU CPU copies in the last %.1f s: %llu buffers, %.1f MB, %.1f ms copying; most: %s",
+            static_cast<double>(now - last) / static_cast<double>(interval) * 10.0,
+            static_cast<unsigned long long>(n),
+            static_cast<double>(b) / 1e6, static_cast<double>(ns) / 1e6, top.c_str());
+    }
+
+private:
+    static auto debugging() -> bool
+    {
+        auto const dir = getenv("XDG_RUNTIME_DIR");
+        return dir && access((std::string{dir} + "/umoja-debug-windows").c_str(), F_OK) == 0;
+    }
+
+    std::atomic<unsigned long long> copies{0};
+    std::atomic<unsigned long long> total_bytes{0};
+    std::atomic<long long> total_ns{0};
+    std::mutex sizes_mutex;
+    std::map<std::pair<int, int>, unsigned> sizes;
+    std::atomic<std::chrono::steady_clock::rep> last_report{0};
+};
+
+auto cross_gpu_copy_stats() -> CrossGpuCopyStats&
+{
+    static CrossGpuCopyStats stats;
+    return stats;
+}
+}
