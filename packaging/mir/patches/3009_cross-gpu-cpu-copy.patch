+namespace
+{
+/* Draw buffers from another GPU via a CPU copy (MIR_CROSS_GPU_CPU_COPY=0 turns it off). */
+auto cross_gpu_cpu_copy() -> bool
+{
+    static bool const enabled = []
+        {
+            auto const env = getenv("MIR_CROSS_GPU_CPU_COPY");
+            return !env || strcmp(env, "0") != 0;
+        }();
+    return enabled;
+}
