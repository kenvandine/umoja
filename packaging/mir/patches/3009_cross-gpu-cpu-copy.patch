+    /* The buffer's pixels, read back through the GPU that imported it.
+     *
+     * Used to draw the buffer on a different GPU: NVIDIA renders garbage
+     * stripes from buffers that Intel clients (and Intel blits) hand it on
+     * hybrid laptops, while plain memory uploads (as for wl_shm) are fine.
+     * Read once per committed buffer; a committed buffer doesn't change.
+     */
+    auto cpu_copy() -> std::shared_ptr<mgc::MemoryBackedShmBuffer>
+    {
+        std::lock_guard lock{cpu_copy_mutex};
+        if (cpu_copy_ || cpu_copy_failed)
+        {
+            return cpu_copy_;
+        }
+
+        auto const started = std::chrono::steady_clock::now();
+        auto copy = cross_gpu_copy_pool().take(size_);
+        auto mapping = copy->map_writeable();
+        auto* const dest = mapping->data();
+        GLsizei const width = size_.width.as_int();
+        GLsizei const height = size_.height.as_int();
+        GLuint const src = tex.tex_id();
+
+        std::promise<bool> done;
+        auto result = done.get_future();
+        egl_executor->spawn(
+            [&done, dest, width, height, src]()
+            {
+                bool ok = false;
+                GLuint fbo{0};
+                glGenFramebuffers(1, &fbo);
+                glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+                glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src, 0);
+                if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE)
+                {
+                    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+                    while (glGetError() != GL_NO_ERROR) {}
+                    // ARGB8888 is B,G,R,A in memory: GL_BGRA_EXT gives it directly.
+                    glReadPixels(0, 0, width, height, GL_BGRA_EXT, GL_UNSIGNED_BYTE, dest);
+                    if (glGetError() == GL_NO_ERROR)
+                    {
+                        ok = true;
+                    }
+                    else
+                    {
+                        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, dest);
+                        if (glGetError() == GL_NO_ERROR)
+                        {
+                            auto* px = reinterpret_cast<unsigned char*>(dest);
+                            for (size_t i = 0; i < static_cast<size_t>(width) * height; ++i)
+                            {
+                                std::swap(px[i * 4], px[i * 4 + 2]);
+                            }
+                            ok = true;
+                        }
+                    }
+                }
+                glBindFramebuffer(GL_FRAMEBUFFER, 0);
+                glDeleteFramebuffers(1, &fbo);
+                done.set_value(ok);
+            });
+        bool const ok = result.get();
+        // Unmapping marks the copy's textures for upload, also when reused.
+        mapping.reset();
+        cross_gpu_copy_stats().add(
+            static_cast<std::size_t>(width) * height * 4,
+            std::chrono::steady_clock::now() - started,
+            size_);
+
+        if (ok)
+        {
+            cpu_copy_ = std::move(copy);
+        }
+        else
+        {
+            cpu_copy_failed = true;
+            mir::log_warning("Cross-GPU buffer: CPU copy failed, falling back to direct import");
+        }
+        return cpu_copy_;
+    }
 private:
+    std::mutex cpu_copy_mutex;
+    std::shared_ptr<mgc::MemoryBackedShmBuffer> cpu_copy_;
+    bool cpu_copy_failed{false};
