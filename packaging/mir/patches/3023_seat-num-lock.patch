+auto mircv::XKBMapperRegistrar::XkbMappingState::num_lock() const -> bool
+{
+    auto const num_mod = xkb_keymap_mod_get_index(compiled_keymap.get(), XKB_MOD_NAME_NUM);
+    if (num_mod == XKB_MOD_INVALID)
+        return (modifier_state & mir_input_event_modifier_num_lock) != 0;
+    return xkb_state_mod_index_is_active(state.get(), num_mod, XKB_STATE_MODS_LOCKED) > 0;
+}
+
+auto mircv::XKBMapperRegistrar::XkbMappingState::set_num_lock(bool on) -> bool
+{
+    if (on)
+        modifier_state |= mir_input_event_modifier_num_lock;
+    else
+        modifier_state &= ~mir_input_event_modifier_num_lock;
+
+    auto const num_mod = xkb_keymap_mod_get_index(compiled_keymap.get(), XKB_MOD_NAME_NUM);
+    if (num_mod == XKB_MOD_INVALID || num_lock() == on)
+        return false;
+
+    xkb_mod_mask_t locked = xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_LOCKED);
+    if (on)
+        locked |= 1u << num_mod;
+    else
+        locked &= ~(1u << num_mod);
+    xkb_state_update_mask(
+        state.get(),
+        xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_DEPRESSED),
+        xkb_state_serialize_mods(state.get(), XKB_STATE_MODS_LATCHED),
+        locked,
+        xkb_state_serialize_layout(state.get(), XKB_STATE_LAYOUT_DEPRESSED),
+        xkb_state_serialize_layout(state.get(), XKB_STATE_LAYOUT_LATCHED),
+        xkb_state_serialize_layout(state.get(), XKB_STATE_LAYOUT_LOCKED));
+    return true;
+}
