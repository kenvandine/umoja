+
+// Num Lock for the shell. A server that exports mir_num_lock_initial_hook
+// gets one Num Lock for the whole seat, like mutter's: the hook answers
+// whether it starts on (1) or off (0), every keyboard (including ones
+// plugged in later) follows it, and toggling it on any keyboard toggles it
+// on all of them, LEDs included. mir_num_lock_changed_hook, if exported,
+// hears each change, so the server can remember it for the next session.
+// Without the hooks each keyboard keeps its own lock state, as before.
+using NumLockInitialHook = int (*)();
+using NumLockChangedHook = void (*)(int on);
+
+auto num_lock_changed_hook() -> NumLockChangedHook
+{
+    static NumLockChangedHook const hook =
+        reinterpret_cast<NumLockChangedHook>(dlsym(RTLD_DEFAULT, "mir_num_lock_changed_hook"));
+    return hook;
+}
+
+auto initial_num_lock() -> std::optional<bool>
+{
+    auto const hook = reinterpret_cast<NumLockInitialHook>(dlsym(RTLD_DEFAULT, "mir_num_lock_initial_hook"));
+    if (!hook)
+        return std::nullopt;
+    return hook() > 0;
+}
 }
 
