    s.text(500, 76, "Thu 12 Nov  10:04", size=14, fill="#ffffff")
    for i in range(4):
        s.add(f'<circle cx="{86 + i * 14}" cy="76" r="{5 if i else 6}" fill="{"#ffffff" if i == 0 else "#a58aa2"}"/>')
    s.text(880, 76, "◉  ▾", size=14, fill="#ffffff")
    s.rect(72, 130, 46, 330, fill="#26122a", stroke="#26122a", r=12)
    for i in range(6):
        s.add(f'<rect x="80" y="{142 + i * 46}" width="30" height="30" rx="7" fill="{[ORANGE, "#c7a54b", "#4a90d9", "#5fa05a", "#9b59b6", "#888"][i]}"/>')
    s.text(95, 440, "⋮⋮", size=16, fill="#ffffff")
    win(s, 200, 130, 380, 260, "Files")
    win(s, 520, 190, 360, 240, "Text Editor")
    notes = [
        (100, 76, 200, 30, "Workspaces: click for the overview"),
        (500, 76, 500, 30, "Clock: calendar, events and notifications"),

        (880, 76, 840, 30, "Status: Quick Settings"),
        (118, 300, 190, 530, "Dock: favourites and running apps"),
        (95, 440, 470, 530, "Show Apps: the app grid"),
        (700, 310, 790, 530, "Windows"),
    ]
    for x1, y1, x2, y2, label in notes:
        s.add(f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2 + (12 if y2 < y1 else -12)}" stroke="{ORANGE}" stroke-width="2"/>')
        s.add(f'<circle cx="{x1}" cy="{y1}" r="5" fill="{ORANGE}"/>')
        s.text(x2, y2, label, size=16, weight="bold", fill=AUBERGINE)
    return s


def tiling():
    s = Svg(1000, 470, "Tiling windows")
    s.text(500, 38, "Snap windows to halves and quarters", size=26, weight="bold")
    cells = [
        ("Left half", "Super+Left", [(0, 0, 0.5, 1)]),
        ("Right half", "Super+Right", [(0.5, 0, 0.5, 1)]),
        ("Top-left quarter", "Super+KP 7", [(0, 0, 0.5, 0.5)]),
        ("Maximize", "Super+Up", [(0, 0, 1, 1)]),
    ]
    for i, (name, combo, rects) in enumerate(cells):
        x = 40 + i * 235
        screen(s, x, 70, 210, 140)
        for rx, ry, rw, rh in rects:
            s.rect(x + 6 + rx * 198, 88 + ry * 116, rw * 198 - 4, rh * 116 - 4, fill=ORANGE, stroke=ORANGE, r=5, sw=1, extra='fill-opacity="0.85"')
        s.text(x + 105, 232, name, size=17, weight="bold")
        kw = 0
        # centre the key caps under the screen
        tmp = Svg(10, 10, "")
        kw = tmp.keys(0, 0, combo, size=14)
        s.keys(x + 105 - kw / 2, 250, combo, size=14)
    s.text(500, 330, "Or drag a window by its title bar:", size=19, weight="bold")
    s.text(500, 362, "to the left or right edge for a half, into a corner for a quarter, to the top to maximize.", size=16, fill=MUTED)
    s.text(500, 392, "Pause at the top edge for the layout picker; drop the window on the tile you want.", size=16, fill=MUTED)
    s.text(500, 432, "Tiled side by side? Drag the line between them to resize both.", size=16, fill=MUTED)
    return s


def workspaces():
    s = Svg(1000, 360, "Workspaces")
    s.text(500, 38, "Workspaces come and go as you need them", size=26, weight="bold")
    labels = ["Workspace 1", "Workspace 2", "Workspace 3", "(empty)"]
    for i, lab in enumerate(labels):
        x = 50 + i * 235
        screen(s, x, 80, 200, 130)
        if i == 0:
            win(s, x + 14, 104, 100, 80, "Mail")
            win(s, x + 90, 120, 96, 76, "Web")
        elif i == 1:
            win(s, x + 20, 104, 160, 92, "Code")
        elif i == 2:
            win(s, x + 40, 110, 120, 84, "Music")
        else:
            s.text(x + 100, 150, "+", size=40, fill="#a58aa2")
        s.text(x + 100, 232, lab, size=16, weight="bold" if i < 3 else "normal", fill=INK if i < 3 else MUTED)
        if i < 3:
            s.arrow(x + 204, 145, x + 231, 145)
    w = s.keys(60, 270, "Super+Page Down")
    s.text(60 + w + 12, 288, "next workspace", size=15, fill=MUTED, anchor="start")
    w = s.keys(470, 270, "Super+Shift+Page Down")
    s.text(470 + w + 12, 288, "take the window along", size=15, fill=MUTED, anchor="start")
    s.text(500, 336, "There is always one empty workspace at the end; an empty one in the middle closes by itself.", size=15, fill=MUTED)
    return s


