#!/usr/bin/python3
"""Draw the user guide's diagrams as SVG (docs/guide/images/*.svg).

Plain SVG with a light card behind it, so the pictures read the same on
GitHub (light or dark) and in the PDF. Edit the scenes below and run

    tools/guide/make-diagrams [--out docs/guide/images]
"""

import argparse
from html import escape
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]

ORANGE = "#E95420"
AUBERGINE = "#77216F"
INK = "#2c2c2c"
MUTED = "#6b6b6b"
CARD = "#fbf9f8"
LINE = "#d8d2cf"
SOFT = "#f3e9e4"
SCREEN = "#3b1f38"
WINDOW = "#e9e5e3"
FONT = "Ubuntu, 'Noto Sans', 'DejaVu Sans', Arial, sans-serif"


class Svg:
    def __init__(self, w, h, title):
        self.w, self.h, self.title = w, h, title
        self.parts = []

    def add(self, s):
        self.parts.append(s)

    def rect(self, x, y, w, h, fill=CARD, stroke=LINE, r=12, sw=2, extra=""):
        self.add(f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="{r}" fill="{fill}" stroke="{stroke}" stroke-width="{sw}" {extra}/>')

    def text(self, x, y, s, size=18, fill=INK, weight="normal", anchor="middle", italic=False):
        style = ' font-style="italic"' if italic else ""
        lines = s.split("\n")
        for i, line in enumerate(lines):
            dy = (i - (len(lines) - 1) / 2) * size * 1.25
            self.add(
                f'<text x="{x}" y="{y + dy:.1f}" font-family="{FONT}" font-size="{size}" fill="{fill}" '
                f'font-weight="{weight}" text-anchor="{anchor}" dominant-baseline="central"{style}>{escape(line)}</text>'
            )

    def box(self, x, y, w, h, title, sub=None, fill="#ffffff", stroke=LINE, title_fill=INK, size=19):
        self.rect(x, y, w, h, fill=fill, stroke=stroke)
        if sub:
            self.text(x + w / 2, y + h / 2 - 14, title, size=size, weight="bold", fill=title_fill)
            self.text(x + w / 2, y + h / 2 + 16, sub, size=size - 4, fill=MUTED)
        else:
            self.text(x + w / 2, y + h / 2, title, size=size, weight="bold", fill=title_fill)

    def key(self, x, y, label, w=None, size=17):
        w = w or max(44, 12 + len(label) * size * 0.62)
        self.add(f'<rect x="{x}" y="{y}" width="{w:.0f}" height="36" rx="7" fill="#ffffff" stroke="{INK}" stroke-width="1.6"/>')
        self.add(f'<rect x="{x + 2}" y="{y + 30}" width="{w - 4:.0f}" height="4" rx="2" fill="{LINE}"/>')
        self.text(x + w / 2, y + 16, label, size=size, weight="bold")
        return w

    def keys(self, x, y, combo, size=17):
        """'Super+Shift+A' as key caps; returns the width used."""
        cx = x
        for i, k in enumerate(combo.split("+")):
            if i:
                self.text(cx + 9, y + 17, "+", size=size, fill=MUTED)
                cx += 18
            cx += self.key(cx, y, k, size=size)
        return cx - x

    def arrow(self, x1, y1, x2, y2, color=MUTED, label=None, dashed=False):
        dash = ' stroke-dasharray="7 6"' if dashed else ""
        self.add(f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}" stroke="{color}" stroke-width="2.5" marker-end="url(#ah)"{dash}/>')
        if label:
            self.text((x1 + x2) / 2, (y1 + y2) / 2 - 14, label, size=15, fill=MUTED, italic=True)

    def render(self):
        return (
            f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {self.w} {self.h}" width="{self.w}" height="{self.h}" role="img" aria-label="{escape(self.title)}">\n'
            f"<title>{escape(self.title)}</title>\n"
            f'<defs><marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">'
            f'<path d="M0,0 L10,5 L0,10 z" fill="{MUTED}"/></marker></defs>\n'
            f'<rect x="1" y="1" width="{self.w - 2}" height="{self.h - 2}" rx="18" fill="{CARD}" stroke="{LINE}" stroke-width="2"/>\n'
            + "\n".join(self.parts)
            + "\n</svg>\n"
        )


def screen(s, x, y, w, h, bar=True):
    s.rect(x, y, w, h, fill=SCREEN, stroke=INK, r=10, sw=3)
    if bar:
        s.add(f'<rect x="{x + 3}" y="{y + 3}" width="{w - 6}" height="14" rx="6" fill="#1d0f1c"/>')


def win(s, x, y, w, h, label="", fill=WINDOW):
    s.rect(x, y, w, h, fill=fill, stroke="#b9b1ad", r=6, sw=1.5)
    s.add(f'<rect x="{x}" y="{y}" width="{w}" height="12" rx="5" fill="#cfc8c5"/>')
    if label:
        s.text(x + w / 2, y + h / 2 + 6, label, size=14, fill=INK, weight="bold")


def four_keys():
    s = Svg(1000, 330, "Four keys to remember")
    s.text(500, 40, "Four keys get you everywhere", size=26, weight="bold")
    rows = [
        ("Copilot", "or tap Alt", "Ask Umoja", "launch, switch, change settings, ask anything"),
        ("Super", None, "Activities overview", "every window and workspace; type to search"),
        ("Print", None, "Screenshot", "a selection, the screen or a window; or record"),
        ("Super+/", None, "Shortcuts guide", "every keyboard shortcut, searchable"),
    ]
    for i, (k, alt, what, sub) in enumerate(rows):
        y = 80 + i * 60
        w = s.keys(60, y, k)
        if alt:
            s.text(60 + w + 16, y + 17, alt, size=15, fill=MUTED, anchor="start", italic=True)
        s.arrow(300, y + 18, 360, y + 18)
        s.text(380, y + 8, what, size=19, weight="bold", anchor="start", fill=AUBERGINE)
        s.text(380, y + 30, sub, size=15, fill=MUTED, anchor="start")
    return s


