def t_stop(run):
    run.ensure_ready()
    tid = run.submit("Wait a while [[slow 300]]")
    run.wait_for(lambda: (run.task(tid) or {}).get("step"), 60, "the task to start a step")
    run.wait(3)
    run.menu(True)
    run.shot("running", "A long task, with Stop")
