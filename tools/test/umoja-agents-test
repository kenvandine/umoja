@test("command-approval", "Careful preset: a risky command waits; Deny then Allow", real=False)
def t_command(run):
    run.ensure_ready()
    run.agent("SetPreset", "(s)", "careful", timeout=120_000)
    run.cleanups.append(("the Balanced preset", lambda: run.agent("SetPreset", "(s)", "balanced", timeout=120_000)))
    run.wait(5)
    old = run.ws_file("umoja-test-old")
    old.mkdir(exist_ok=True)
    (old / "keep.txt").write_text(MARK)
    tid = run.submit("Tidy up [[danger]]")
    a = run.wait_approval(tid, "command")
    run.check("rm -rf" in a.get("command", ""), "the card shows the command", a)
    run.menu(True)
    run.shot("card", "Hermes asks before deleting")
    run.agent("Answer", "(ss)", a["id"], "deny")
    run.wait(1.0)
    run.menu(False)
    t = run.wait_task(tid)
    run.check(old.exists(), "Deny: the folder is still there", t.get("result"))
    tid = run.submit("Tidy up, I'm sure [[danger]]")
    a = run.wait_approval(tid, "command")
    run.agent("Answer", "(ss)", a["id"], "allow")
    t = run.wait_task(tid)
    run.check(not old.exists(), "Allow: the folder is gone", t.get("result"))
    run.agent("SetPreset", "(s)", "balanced", timeout=120_000)
    run.cleanups.pop()


