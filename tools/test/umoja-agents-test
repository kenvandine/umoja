    run.check("SEE host:631" not in out, "host services (CUPS) aren't reachable", out)
    run.check("NO " in out, "the check really ran", out)
    run.check("uid=0" not in out, "Hermes doesn't run as root", out)


def limit_mb(limit):
    """An LXD limits.memory value ("4096MiB", "4GB", "4294967296") in MiB."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([KMGT]i?B|[KMGT])?", limit.strip())
    if not m:
        return None
    n, unit = float(m.group(1)), (m.group(2) or "B").rstrip("B") or "B"
    scale = {"B": 1, "K": 1e3, "Ki": 1024, "M": 1e6, "Mi": 1024**2, "G": 1e9, "Gi": 1024**3,
             "T": 1e12, "Ti": 1024**4}.get(unit, 1024**2)
    return round(n * scale / 1024**2)


@test("memory-cap", "The sandbox has a memory cap in LXD")
def t_memory(run):
    s = run.ensure_ready()
    code, out = run.lxc("list", "--format", "json")
    try:
        instances = json.loads(out) if code == 0 else []
    except json.JSONDecodeError:
        instances = []
    run.check(bool(instances), "the test project has the sandbox", out[:300])
    # The agent's own container; OpenShell's supervisor container has no cap.
    for inst in [i for i in instances if not i["name"].startswith("openshell-sup-")]:
        limit = inst.get("expanded_config", {}).get("limits.memory") or inst.get("config", {}).get("limits.memory")
        run.check(bool(limit), f"{inst['name']} has limits.memory", limit)
        if limit and s.get("memory_mb"):
            mb = limit_mb(limit)
            run.check(mb is None or abs(mb - s["memory_mb"]) <= 1, "it matches what the panel shows",
                      f"{limit} vs {s['memory_mb']} MB")
    run.note(f"memory used: {s.get('memory_used_mb')} MB of {s.get('memory_mb')} MB")


@test("shared-folder", "Shared folders: read-only stays read-only, writable takes writes", real=False)
def t_shared(run):
    run.ensure_ready()
    ro = run.out / "shared" / "ReadOnly"
    rw = run.out / "shared" / "Writable"
    for d in (ro, rw):
        d.mkdir(parents=True, exist_ok=True)
    (ro / "read-me.txt").write_text(MARK)
    inside_ro = run.agent("ShareFolder", "(sb)", str(ro), False, reply="(s)", timeout=120_000)[0]
    inside_rw = run.agent("ShareFolder", "(sb)", str(rw), True, reply="(s)", timeout=120_000)[0]
    run.cleanups.append(("unshare the test folders", lambda: [run.agent("Unshare", "(s)", str(d)) for d in (ro, rw)]))
    run.save_state("shared")
    run.menu(True)
    run.shot("shared", "Two shared folders")
    run.menu(False)
    t = run.wait_task(run.submit(f"[[writeto {inside_ro}/nope.txt {MARK}]]"))
    run.check("REFUSED" in t.get("result", "") and not (ro / "nope.txt").exists(),
              "a write to the read-only folder fails", t.get("result"))
    t = run.wait_task(run.submit(f"[[writeto {inside_rw}/yes.txt {MARK}]]"))
    run.check("WROTE" in t.get("result", "") and (rw / "yes.txt").exists(),
              "a write to the writable folder lands on the host", t.get("result"))
    t = run.wait_task(run.submit(f"[[writeto {Path.home()}/umoja-escape-{MARK}.txt x]]"))
    run.check(not (Path.home() / f"umoja-escape-{MARK}.txt").exists(), "an unshared host folder can't be written",
              t.get("result"))
    for d in (ro, rw):
        run.agent("Unshare", "(s)", str(d), timeout=120_000)
    run.cleanups.pop()


