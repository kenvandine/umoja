@test("pause", "Pause stops the sandbox; Resume brings it back", real=False)
def t_pause(run):
    run.ensure_ready()
    tid = run.submit("Wait a bit [[slow 300]]")
    run.wait(5)
    run.agent("SetPaused", "(b)", True, timeout=300_000)
    s = run.wait_for(lambda: (lambda s: s if s.get("paused") else None)(run.state()), 60, "paused")
    run.menu(True)
    run.shot("paused", "Agents paused")
    run.menu(False)
    run.check((run.task(tid) or {}).get("status") == "cancelled", "the running task was stopped", run.task(tid))
    code, out = run.lxc("list", "--format", "csv", "-c", "ns")
    run.check("RUNNING" not in out, "the container isn't running", out)
    run.save_state("paused")
    run.agent("SetPaused", "(b)", False, timeout=400_000)
    run.wait_for(lambda: (lambda s: s if not s.get("paused") and s.get("setup") == "ready" else None)(run.state()),
                 120, "resumed")
    code, out = run.lxc("list", "--format", "csv", "-c", "ns")
    run.check("RUNNING" in out, "the container runs again", out)
    if not run.opts.real_model:
        t = run.wait_task(run.submit(f"After the pause [[write umoja-resume-{MARK}.txt back]]"))
        run.check(t["status"] == "done", "a new task works after Resume", t)


@test("sleep-resume", "A task carries on after the laptop sleeps mid-task", real=False)
def t_sleep(run):
    """Simulated by default: the sandbox is frozen (lxc pause, like a
    suspend freezes it), the model goes away so the request in flight
    drops (like a cloud connection across a lid close), and agentd gets
    logind's PrepareForSleep through its test hook. --suspend does a real
    suspend with rtcwake instead (needs sudo)."""
    run.ensure_ready()
    name = f"steps-{MARK}.txt"
    f = run.ws_file(name)
    f.unlink(missing_ok=True)
    tid = run.submit(f"Do six steps [[steps 6 {name}]]")
    run.wait_for(lambda: f.exists() and len(f.read_text().splitlines()) >= 2, 90, "two steps done")
    run.menu(True)
    run.shot("before", "Working, before the lid closes")
    run.menu(False)
    if run.opts.suspend:
        run.note("real suspend for 30 s (rtcwake)")
        r = subprocess.run(["sudo", "-n", "rtcwake", "-m", "mem", "-s", "30"], capture_output=True, text=True)
        run.check(r.returncode == 0, "the laptop suspended and woke", r.stderr.strip())
        run.wait(5)
    else:
        code, out = run.lxc("list", "--format", "csv", "-c", "n")
        inst = out.splitlines()[0].strip() if code == 0 and out else ""
        run.agent("TestSleep", "(b)", True)
        code, out = run.lxc("pause", inst)
        run.check(code == 0, "the sandbox froze", out)
        if run.model:
            run.model.terminate()
            run.model.wait(10)
        run.note("asleep for 25 s; the model is gone")
        run.wait(25)
        run.start_model()
        code, out = run.lxc("start", inst)
        run.check(code == 0, "the sandbox thawed", out)
        run.agent("TestSleep", "(b)", False)
    t = run.wait_task(tid, timeout=run.opts.task_timeout * 2)
    run.save_state("after")
    run.menu(True)
    run.shot("after", "After waking up")
    run.menu(False)
    lines = f.read_text().splitlines() if f.exists() else []
    run.note(f"steps written: {lines}; carried on {t.get('resumes', 0)} time(s)")
    run.check(t["status"] == "done", "the task finished after waking", t.get("result"))
    run.check(all(f"step {i}" in lines for i in range(1, 7)), "all six steps are there", lines)
    run.check(lines.count("step 1") == 1, "it didn't start over from step 1", lines)


@test("isolation", "The sandbox can't see the desktop, the user's home or LXD", real=False)
def t_isolation(run):
    run.ensure_ready()
    t = run.wait_task(run.submit(f"Look around [[escape {Path.home()}]]"))
    out = t.get("result", "")
    run.note(out.replace("\n", " | ")[:600])
