def heard_speech(run, listener, voice, started, what):
    """Wait for Piper to speak and finish, then check what was heard."""
    # The first time, the voice downloads (about 60 MB) before Piper starts.
    seen = run.wait(180, piper_voice_running)
    run.check(seen is not None, f"Piper started {what}", seen or "no piper process within 180 s")
    if seen:
        run.check(seen == f"{voice}.onnx", f"Piper speaks with the {voice} voice", seen)
        run.note(f"Piper started {time.monotonic() - started:.1f} s after the request")
        run.wait(90, lambda: piper_voice_running() is None)
    run.wait(1.5)  # the player drains its buffer
    secs, peak = listener.stop()
    run.current.setdefault("audio", []).append(str(listener.path.relative_to(run.out)))
    run.note(f"sound for {secs:.1f} s, peak {peak:.2f} (audio/{listener.path.name})")
    run.check(secs >= 2.0, "the speakers played speech", f"{secs:.1f} s of sound, peak {peak:.2f}")
    text = transcribe(listener.path) if secs >= 1.0 else ""
    hits = [w for w in SPOKEN_WORDS if w in text.lower()]
    run.check(len(hits) >= 4, "Whisper understands what was said (four of its words)",
              f"{text!r}, matched {hits}")


