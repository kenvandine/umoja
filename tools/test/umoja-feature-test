PIPER_CLI = "/snap/bin/piper-tts.piper-cli"
LEMONADE = "http://127.0.0.1:13345"
SPOKEN = ("Hello Ken. This is Alan, reading aloud on the Umoja desktop. "
          "The meeting moved to Thursday at three o'clock.")
