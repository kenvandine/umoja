class Run:
    def __init__(self, opts):
        self.opts = opts
        self.out = opts.out
        (self.out / "images").mkdir(parents=True, exist_ok=True)
        (self.out / "videos").mkdir(exist_ok=True)
        (self.out / "audio").mkdir(exist_ok=True)
        self.logf = open(self.out / "log.txt", "w")
        self.bus = Bus(self.log)
        self.video = not opts.no_video
        self.audio_source = None if opts.no_audio else monitor_source()
        self.recorder = Recorder(self)
        self.tmp = tempfile.mkdtemp(prefix="umoja-test-")
        self.events = []
        self.results = []
        self.current = None
        self.pads = []
        self.cleanups = []
        self.started = datetime.datetime.now()
        self.inhibit_cookie = None

    # ---- plumbing ------------------------------------------------------

    def log(self, msg):
        line = f"{datetime.datetime.now():%H:%M:%S} {msg}"
        print(line, flush=True)
        self.logf.write(line + "\n")
        self.logf.flush()

    def check_screen(self):
        res = self.bus.call(SCREENSAVER, "GetActive", None, "(b)", quiet=True)
        if res and res[0]:
            raise Stop("the screen is blanked")
        if self.bus.session_locked():
            raise Stop("the session is locked")

    def wait(self, seconds, until=None):
        end = time.monotonic() + seconds
        ctx = GLib.MainContext.default()
        last = 0.0
        while True:
            while ctx.iteration(False):
                pass
            if until:
                v = until()
                if v:
                    return v
            now = time.monotonic()
            if now >= end:
                return None
            if now - last > 1.0:
                self.check_screen()
                last = now
            time.sleep(0.1)

    def wait_for(self, fn, timeout, what):
        v = self.wait(timeout, fn)
        if not v:
            raise AssertionError(f"timed out after {timeout:g} s waiting for {what}")
        return v

    def shot(self, name, caption):
        path = self.out / "images" / f"{self.current['name']}-{name}.png"
        r = subprocess.run(["grim", "-s", "1", str(path)], capture_output=True, text=True)
        if r.returncode == 0:
            self.current["shots"].append({"file": str(path.relative_to(self.out)), "caption": caption})
            self.log(f"  shot {path.name}")
        else:
            self.log(f"  ! grim: {r.stderr.strip()}")

    def check(self, ok, what, detail=""):
        self.current["checks"].append({"ok": bool(ok), "check": what, "detail": str(detail)[:2000]})
        self.log(f"  {'✓' if ok else '✗'} {what}" + (f": {str(detail)[:200]}" if detail else ""))
        return bool(ok)

    def note(self, text):
        self.current["notes"].append(text)
        self.log(f"  · {text}")

    def mcp(self, tool, args=None):
        r = subprocess.run(["umoja-mcp", "call", tool, json.dumps(args or {})],
                           capture_output=True, text=True, timeout=120)
        self.log(f"  mcp {tool} -> {r.returncode}: {r.stdout.strip()[:200]}")
        return r.returncode, r.stdout.strip(), r.stderr.strip()

    def windows(self):
        rows = self.bus.call(COMPOSITOR, "GetWindows", None, "(a(tssiiiiu))", quiet=True)
        return rows[0] if rows else []

    def window_id(self, title=None, app=None):
        for w in self.windows():
            if (title and w[2] == title) or (app and w[1] == app):
                return w[0]
        return None

    def flags(self, wid):
        return next((w[7] for w in self.windows() if w[0] == wid), 0)

    def tiles(self):
        rows = self.bus.call(COMPOSITOR, "GetWindowTiles", None, "(a(tu))", quiet=True)
        return dict(rows[0]) if rows else {}

    def notify(self, summary, body, app="Umoja test"):
        res = self.bus.call(NOTIFY, "Notify", GLib.Variant(
            "(susssasa{sv}i)", (app, 0, "dialog-information", summary, body, [], {}, -1)), "(u)")
        return res[0] if res else 0

    def notifications(self):
        res = self.bus.call(NOTIFICATIONS, "GetNotifications", None, "(a(ussssx))", quiet=True)
        return res[0] if res else []

    def gset(self, schema, key, value=None):
        s = settings(schema)
        if not s:
            return None
        if value is None:
            return s.get_value(key).unpack()
        s.set_value(key, value)
        Gio.Settings.sync()
        return value

    # ---- Ask Umoja -------------------------------------------------------

    def ask_type(self, text):
        """Type into Ask Umoja and wait for its rows to settle: the search
        runs a moment after the text changes, so the first rows read can
        still be the previous query's."""
        self.bus.call(OVERLAY, "AskType", GLib.Variant("(sb)", (text, False)))
        self.wait(0.4)
        state = {"last": None, "since": time.monotonic()}

        def settled():
            now = self.rows()
            if now != state["last"]:
                state["last"], state["since"] = now, time.monotonic()
                return None
            return now if now and time.monotonic() - state["since"] >= 0.5 else None

        rows = self.wait(5, settled) or state["last"] or []
        self.wait(0.2)  # let the frame with these rows reach the screen
        return rows

    def rows(self):
        res = self.bus.call(OVERLAY, "AskRows", None, "(a(sss))", quiet=True)
        return res[0] if res else []

    def row_index(self, kind=None, title_has=None):
        for i, (k, title, _sub) in enumerate(self.rows()):
            if (kind is None or k == kind) and (title_has is None or title_has.lower() in title.lower()):
                return i
        return None

    def activate(self, index):
        res = self.bus.call(OVERLAY, "AskActivate", GLib.Variant("(u)", (index,)), "(b)")
        return bool(res and res[0])

    def action(self, name):
        res = self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", (name,)), "(bs)")
        return res if res else (False, "")

    def hide(self):
        self.bus.call(OVERLAY, "Hide", quiet=True)
        self.wait(0.8)

    def ask(self, question, confirm=None, timeout=None):
        """Ask the assistant. `confirm`: True/False answers an Allow prompt.
        Returns (answer, steps, confirm_label)."""
        self.events.clear()
        self.log(f"  ask {question!r}")
        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (question, 0)))
        timeout = timeout or self.opts.answer_timeout
        label = None
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            ev = self.wait(deadline - time.monotonic(),
                           lambda: next((e for e in self.events if e[0] in ("AnswerFinished", "ConfirmShown")), None))
            if not ev:
                break
            self.events.remove(ev)
            if ev[0] == "ConfirmShown":
                label = ev[1][0]
                self.log(f"  confirm shown: {label!r}")
                if confirm is None:
                    return "", [], label
                self.bus.call(OVERLAY, "AnswerConfirm", GLib.Variant("(b)", (confirm,)), "(b)")
                continue
            answer, steps = ev[1]
            self.log(f"  answer: {answer[:240]!r} steps={steps}")
            return answer, list(steps), label
        raise AssertionError(f"the assistant didn't answer within {timeout:g} s")

    # ---- setup and teardown -------------------------------------------

    def flag(self, on):
        f = Path(GLib.get_user_runtime_dir()) / "umoja-demo"
        if on:
            f.touch()
        else:
            f.unlink(missing_ok=True)

    def preflight(self):
        problems = []
        for target, method in [(OVERLAY, "AskRows"), (OVERLAY, "TestAction"), (OVERLAY, "ToggleCaptions"),
                               (COMPOSITOR, "GetWindowTiles"), (NOTIFICATIONS, "GetNotifications")]:
            if not self.bus.has_method(target, method):
                problems.append(f"{target[2]}.{method} is missing: install the debs with the new features and log in again")
        for tool in ("grim", "umoja-mcp"):
            if not shutil.which(tool):
                problems.append(f"{tool} is not installed")
        if problems:
            for p in problems:
                self.log(f"! {p}")
            sys.exit(1)
        if not shutil.which("wf-recorder"):
            self.log("wf-recorder is missing: no videos")
            self.video = False
        if self.audio_source:
            self.log(f"recording sound from {self.audio_source}")
        elif not self.opts.no_audio:
            self.log("no default output found (pactl): videos have no sound")
        res = self.bus.call(SCREENSAVER, "Inhibit",
                            GLib.Variant("(ss)", ("umoja-feature-test", "Testing the desktop")), "(u)")
        self.inhibit_cookie = res[0] if res else None
        self.bus.conn.signal_subscribe(
            OVERLAY[0], OVERLAY[2], None, OVERLAY[1], None, Gio.DBusSignalFlags.NONE,
            lambda _c, _s, _p, _i, name, params: self.events.append((name, params.unpack(), time.monotonic())))
        self.flag(True)
        # Banners on for the run (Do Not Disturb would hide what we test).
        n = settings("org.gnome.desktop.notifications")
        if n and not n.get_boolean("show-banners"):
            n.set_boolean("show-banners", True)
            self.cleanups.append(("Do Not Disturb back on", lambda: n.set_boolean("show-banners", False)))

    def teardown(self):
        self.recorder.stop()
        self.hide()
        for pad in self.pads:
            pad.close()
        for what, fn in reversed(self.cleanups):
            try:
                fn()
                self.log(f"restored: {what}")
            except Exception as e:  # noqa: BLE001
                self.log(f"! could not restore {what}: {e}")
        Gio.Settings.sync()
        self.flag(False)
        if self.inhibit_cookie is not None:
            self.bus.call(SCREENSAVER, "UnInhibit", GLib.Variant("(u)", (self.inhibit_cookie,)), quiet=True)
        shutil.rmtree(self.tmp, ignore_errors=True)

    def pad(self, name):
        p = Pad(self, name)
        self.pads.append(p)
        return p

    # ---- running -------------------------------------------------------

    def run(self, selected):
        self.preflight()
        self.log(f"umoja-feature-test: {len(selected)} tests, output in {self.out}")
        try:
            for name, title, fn in selected:
                self.current = {"name": name, "title": title, "status": "pass", "checks": [], "notes": [],
                                "shots": [], "video": None, "seconds": 0}
                self.results.append(self.current)
                self.log(f"== {name}: {title}")
                t0 = time.monotonic()
                try:
                    self.check_screen()
                    self.hide()
                    if name not in ("auto-dnd-recording",):
                        self.recorder.start(name)
                    fn(self)
                except Skip as e:
                    self.current["status"] = "skip"
                    self.note(f"skipped: {e}")
                except Stop:
                    raise
                except AssertionError as e:
                    self.check(False, str(e))
                except Exception as e:  # noqa: BLE001
                    self.check(False, f"crashed: {e}", traceback.format_exc())
                finally:
                    self.recorder.stop()
                    self.hide()
                    for pad in self.pads:  # each test starts with no pads
                        pad.close()
                    self.pads = []
                if self.current["status"] != "skip":
                    self.current["status"] = "pass" if all(c["ok"] for c in self.current["checks"]) else "fail"
                self.current["seconds"] = round(time.monotonic() - t0, 1)
                self.log(f"   -> {self.current['status'].upper()}")
        except Stop as e:
            self.log(f"stopped: {e}")
            self.current["status"] = "stopped"
            self.current["notes"].append(f"stopped: {e}")
        finally:
            self.teardown()
            self.write_report()

    def write_report(self):
        journal = subprocess.run(
            ["journalctl", "--user", "--since", self.started.strftime("%Y-%m-%d %H:%M:%S"), "-o", "short-precise",
             "--no-pager"], capture_output=True, text=True)
        keep = [ln for ln in journal.stdout.splitlines() if "umoja" in ln.lower() or "lemonade" in ln.lower()]
        (self.out / "journal.txt").write_text("\n".join(keep) + "\n")
        version = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "umoja-desktop"],
                                 capture_output=True, text=True).stdout.strip()
        mir = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "libmiral7"],
                             capture_output=True, text=True).stdout.strip()
        summary = {
            "started": self.started.isoformat(timespec="seconds"),
            "umoja_desktop": version,
            "mir": mir,
            "backend": self.gset("org.umoja.shell", "assistant-backend") if settings("org.umoja.shell") else None,
            "results": self.results,
        }
        (self.out / "results.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False))
        icon = {"pass": "✅", "fail": "❌", "skip": "⏭️", "stopped": "⏹️"}
        lines = [
            "# Umoja feature test",
            "",
            f"Run {summary['started']} on umoja-desktop {version or '?'} (Mir {mir or '?'}), "
            f"assistant backend {summary['backend'] or '?'}.",
            "",
            "| Test | Result | Checks | Time |",
            "| --- | --- | --- | --- |",
        ]
        for r in self.results:
            ok = sum(c["ok"] for c in r["checks"])
            lines.append(f"| [{r['name']}](#{r['name']}) {r['title']} | {icon.get(r['status'], '')} {r['status']} "
                         f"| {ok}/{len(r['checks'])} | {r['seconds']} s |")
        for r in self.results:
            lines += ["", f"## {r['name']}", "", f"**{r['title']}**: {icon.get(r['status'], '')} {r['status']}", ""]
            for c in r["checks"]:
                lines.append(f"- {'✓' if c['ok'] else '✗'} {c['check']}"
                             + (f"\n  ```\n  {c['detail'][:600]}\n  ```" if c["detail"] and not c["ok"] else ""))
            for n in r["notes"]:
                lines.append(f"- _{n}_")
            if r["video"]:
                lines.append(f"- video: [{Path(r['video']).name}]({r['video']})")
            for a in r.get("audio", []):
                lines.append(f"- heard: [{Path(a).name}]({a})")
            for s in r["shots"]:
                lines += ["", f"![{s['caption']}]({s['file']})", f"_{s['caption']}_"]
        (self.out / "REPORT.md").write_text("\n".join(lines) + "\n")
        passed = sum(r["status"] == "pass" for r in self.results)
