def test(name, title):
    def wrap(fn):
        TESTS.append((name, title, fn))
        return fn

    return wrap


class Skip(Exception):
    pass


class Stop(Exception):
    pass


def settings(schema):
    src = Gio.SettingsSchemaSource.get_default()
    return Gio.Settings.new(schema) if src and src.lookup(schema, True) else None


