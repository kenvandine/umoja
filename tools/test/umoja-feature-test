class Bus:
    def __init__(self, log):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.system = None
        self.log = log

    def call(self, target, method, args=None, reply=None, timeout=10_000, quiet=False):
        name, path, iface = target
        try:
            res = self.conn.call_sync(name, path, iface, method, args,
                                      GLib.VariantType(reply) if reply else None,
                                      Gio.DBusCallFlags.NONE, timeout, None)
        except GLib.Error as e:
            if not quiet:
                self.log(f"  ! {iface}.{method}: {e.message}")
            return None
        return res.unpack() if res is not None else None

    def prop(self, target, prop, quiet=True):
        res = self.call(target[:2] + ("org.freedesktop.DBus.Properties",), "Get",
                        GLib.Variant("(ss)", (target[2], prop)), "(v)", quiet=quiet)
        return res[0] if res else None

    def has_method(self, target, method):
        name, path, iface = target
        try:
            res = self.conn.call_sync(name, path, "org.freedesktop.DBus.Introspectable", "Introspect",
                                      None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 5000, None)
        except GLib.Error:
            return False
        info = Gio.DBusNodeInfo.new_for_xml(res.unpack()[0])
        i = info.lookup_interface(iface)
        return bool(i and i.lookup_method(method))

    def session_locked(self):
        try:
            if self.system is None:
                self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            res = self.system.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", "LockedHint")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None)
            return bool(res.unpack()[0])
        except GLib.Error:
            return False


class Pad:
    """tools/test/testpad.py: a real GTK window whose text we can read back."""

    def __init__(self, run, name):
        self.run = run
        self.file = Path(run.tmp) / f"{name}.txt"
        self.title = f"Umoja test pad {name} {MARK}"
        self.proc = subprocess.Popen(
            [sys.executable, str(HERE / "testpad.py"), str(self.file)],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        line = self.proc.stdout.readline().strip()
        if line != "ready":
            self.proc.kill()
            raise Skip(f"the test pad didn't start (got {line!r}; it needs gir1.2-gtk-4.0)")
        self.cmd("title", self.title)
        self.id = run.wait_for(lambda: run.window_id(title=self.title), 10, "the pad's window")

    def cmd(self, *words):
        self.proc.stdin.write(" ".join(words) + "\n")
        self.proc.stdin.flush()
        self.proc.stdout.readline()

    def settled_text(self, seconds, changed_from):
        """Wait for the text to change and then stop changing (typing takes a
        while), and return it."""
        state = {"last": None, "since": time.monotonic()}

        def done():
            now = self.text()
            if now != state["last"]:
                state["last"], state["since"] = now, time.monotonic()
                return None
            return now if now != changed_from and time.monotonic() - state["since"] >= 1.0 else None

        return self.run.wait(seconds, done) or (state["last"] if state["last"] != changed_from else None)

    def text(self):
        try:
            return self.file.read_text(encoding="utf-8")
        except OSError:
            return ""

    def set_title(self, title):
        self.title = title
        self.cmd("title", title)

    def focus(self):
        self.run.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (self.id,)))
        self.cmd("present")
        self.run.wait(0.6)

    def close(self):
        if self.proc.poll() is not None:
            return
        try:
            self.cmd("quit")
            self.proc.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired, BrokenPipeError):
            self.proc.kill()


def monitor_source():
    """The monitor of the default output: what the speakers play."""
    if not shutil.which("pactl"):
        return None
    r = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True)
    sink = r.stdout.strip()
    return f"{sink}.monitor" if r.returncode == 0 and sink else None


class Recorder:
    def __init__(self, run):
        self.run = run
        self.proc = None

    def start(self, name):
        if not self.run.video or not shutil.which("wf-recorder"):
            return
        path = self.run.out / "videos" / f"{name}.webm"
        cmd = ["wf-recorder", "-y", "-D", "-c", "libvpx", "-x", "yuv420p", "-p", "deadline=realtime",
               "-p", "cpu-used=8", "-p", "b=6M", "-f", str(path)]
        # The sound too (read-aloud, captions): what the speakers play.
        if self.run.audio_source:
            cmd[1:1] = [f"--audio={self.run.audio_source}", "-C", "libopus"]
        self.proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
        time.sleep(1.0)
        if self.proc.poll() is not None:
            self.proc = None
            return
        self.run.current["video"] = str(path.relative_to(self.run.out))

    def stop(self):
        if not self.proc:
            return
        time.sleep(1.5)  # wf-recorder drops the tail
        self.proc.send_signal(signal.SIGINT)
        try:
            self.proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.proc = None


