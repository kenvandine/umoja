# ---------------------------------------------------------------------------


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--only", nargs="+", metavar="TEST", help="run only these tests")
    p.add_argument("--skip", nargs="+", metavar="TEST", default=[], help="leave these out")
    p.add_argument("--list", action="store_true", help="list the tests and exit")
    p.add_argument("--out", type=Path, help="output folder (default ~/umoja-feature-test-<time>)")
    p.add_argument("--no-video", action="store_true", help="screenshots only")
    p.add_argument("--no-audio", action="store_true", help="videos without sound")
    p.add_argument("--answer-timeout", type=float, default=150, help="seconds to wait for the assistant")
    p.add_argument("--countdown", type=int, default=5, help="seconds before the first test")
    opts = p.parse_args()
    if opts.list:
        for name, title, _ in TESTS:
            print(f"{name:22} {title}")
        return
    names = {n for n, _, _ in TESTS}
    for n in (opts.only or []) + opts.skip:
        if n not in names:
            sys.exit(f"no test called {n}; see --list")
    selected = [t for t in TESTS if (not opts.only or t[0] in opts.only) and t[0] not in opts.skip]
    if not os.environ.get("WAYLAND_DISPLAY"):
        sys.exit("run this inside your Umoja session")
    opts.out = opts.out or Path.home() / f"umoja-feature-test-{datetime.datetime.now():%Y%m%d-%H%M%S}"
    run = Run(opts)
    for n in range(opts.countdown, 0, -1):
        print(f"starting in {n}… hands off the keyboard and mouse", flush=True)
        time.sleep(1)
    run.run(selected)
    failed = sum(r["status"] == "fail" for r in run.results)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
