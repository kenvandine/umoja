@test("activity-recall", "Activity recall finds a window title and a notification")
def t_recall(run):
    s = settings("org.umoja.shell")
    if s.get_boolean("activity-recall"):
        raise Skip("activity recall is already on: not touching your timeline")
    folder = Path(GLib.get_user_data_dir()) / "umoja" / "recall"
    existed = folder.exists()
    s.set_boolean("activity-recall", True)
    Gio.Settings.sync()

    def tidy():
        s.set_boolean("activity-recall", False)
        Gio.Settings.sync()
        if not existed:
            shutil.rmtree(folder, ignore_errors=True)
        else:
            for f in folder.glob("*.jsonl"):
                lines = [ln for ln in f.read_text().splitlines() if MARK not in ln]
                f.write_text("\n".join(lines) + ("\n" if lines else ""))

    run.cleanups.append(("activity recall off, test entries removed", tidy))
    a, b = run.pad("recall-a"), run.pad("recall-b")
    a.set_title(f"Unicorn research notes {MARK}")
    a.focus()
    run.wait(9)
    b.focus()
    run.wait(3)
    run.notify(f"Zebra crossing {MARK}", "A notification for activity recall to find.")
    run.wait(3)
    code, out, _ = run.mcp("recall_activity", {"query": "unicorn"})
    run.check(code == 0 and "Unicorn research notes" in out, "the window title is in the timeline", out)
    code, out, _ = run.mcp("recall_activity", {"query": "zebra"})
    run.check(code == 0 and "Zebra crossing" in out, "the notification is in the timeline", out)
    answer, steps, _ = run.ask("What was that window about unicorns I had open a minute ago?")
    run.shot("answer", "Asking the assistant about it")
    run.check("unicorn" in answer.lower(), "the assistant found it", f"steps={steps} answer={answer[:300]}")


