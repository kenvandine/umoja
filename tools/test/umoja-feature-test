def _from_overlay(pid):
    """Whether umoja-overlay started this process (a few levels up)."""
    for _ in range(5):
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return False
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        if comm.startswith("umoja-overlay"):
            return True
        pid = stat[stat.rindex(")") + 2:].split()[1]
        if pid in ("0", "1"):
            return False
    return False


def piper_voice_running():
    """The voice of a Piper that Umoja's read aloud is running, e.g.
    en_GB-alan-medium.onnx. The piper-tts snap also runs a system daemon
    (root, its own voice, never exits), so only the user's processes started
    by umoja-overlay count, and the last voice on the command line wins (the
    snap's wrapper puts its default first)."""
    uid = str(os.getuid())
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            args = (d / "cmdline").read_bytes().split(b"\0")
            status = (d / "status").read_text()
        except OSError:
            continue
        if not any(b"piper" in a for a in args[:2]):
            continue
        owner = next((ln.split()[1] for ln in status.splitlines() if ln.startswith("Uid:")), "")
        if owner != uid or not _from_overlay(d.name):
            continue
        voices = [a for a in args if a.endswith(b".onnx")]
        if voices:
            return Path(voices[-1].decode(errors="replace")).name
    return None


class Listener:
    """Record what the speakers play (parec on the monitor) to a WAV."""

    RATE = 16000

    def __init__(self, run, name):
        self.path = run.out / "audio" / f"{name}.wav"
        self.raw = Path(run.tmp) / f"{name}.raw"
        self.proc = None
        if run.audio_source and shutil.which("parec"):
            self.f = open(self.raw, "wb")
            self.proc = subprocess.Popen(
                ["parec", f"--device={run.audio_source}", "--raw", "--format=s16le",
                 f"--rate={self.RATE}", "--channels=1"],
                stdout=self.f, stderr=subprocess.DEVNULL)

    def stop(self):
        """Stop and return (seconds of sound, peak level 0..1)."""
        if not self.proc:
            return 0.0, 0.0
        self.proc.terminate()
        self.proc.wait(timeout=5)
        self.f.close()
        import array
        import wave
        data = array.array("h", self.raw.read_bytes()[: (self.raw.stat().st_size // 2) * 2])
        with wave.open(str(self.path), "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(self.RATE)
            w.writeframes(data.tobytes())
        # 50 ms windows louder than about -40 dBFS count as sound.
        win = self.RATE // 20
        loud = 0
        peak = 0
        for i in range(0, len(data) - win, win):
            chunk = data[i:i + win]
            rms = (sum(x * x for x in chunk) / win) ** 0.5
            peak = max(peak, max(abs(x) for x in chunk))
            if rms > 330:
                loud += 1
        return loud / 20, peak / 32768


def transcribe(path, model="Whisper-Base"):
    """What Lemonade's Whisper hears in a WAV ('' if it can't)."""
    import urllib.request
    import uuid
    boundary = uuid.uuid4().hex
    body = b"".join([
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\n{model}\r\n".encode(),
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"speech.wav\"\r\n"
        "Content-Type: audio/wav\r\n\r\n".encode(),
        Path(path).read_bytes(),
        f"\r\n--{boundary}--\r\n".encode(),
    ])
    req = urllib.request.Request(f"{LEMONADE}/api/v1/audio/transcriptions", data=body,
                                 headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            return json.loads(r.read()).get("text", "")
    except Exception as e:  # noqa: BLE001
        return f"(transcription failed: {e})"


