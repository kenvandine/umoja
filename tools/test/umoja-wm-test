    run.close_overview()


@test("thumbnail-place", "Drop a window inside a thumbnail to place it there (O4)")
def t_thumbnail_place(run):
    need_workspaces(run)
    cur, _ = run.go_to_new_workspace()
    a = Pad(run, "a", size=(600, 400))
    before = a.rect()
    st = run.open_overview()
    small = next((r for r in st.get("thumb_window_rects", []) if r[0] == a.id), None)
    tr = _thumb_rect(st, cur)
    if not small or not tr:
        raise AssertionError("no thumbnail for the window")
    tx, ty, tw, th = tr
    # To the bottom right quarter of the same thumbnail.
    sx, sy = centre(small[1:])
    end = (tx + tw * 0.72, ty + th * 0.72)
    run.input.drag((sx, sy), end, seconds=0.8)
    run.wait(1.0)
    after = a.rect()
    m = run.primary
    want = (m["x"] + 0.72 * m["w"], m["y"] + 0.72 * m["h"])
    got = centre(after)
    run.shot("placed", "after the drop inside the thumbnail")
    run.check(after != before, "the window moved", f"{before} -> {after}")
    run.check(abs(got[0] - want[0]) < m["w"] * 0.12 and abs(got[1] - want[1]) < m["h"] * 0.15,
              "it sits near the drop point (or as close as the screen edge allows)",
              f"centre {got}, dropped at {want}")
    run.check(run.workspace_of(a.id) == cur, "it stayed on its workspace")
    run.close_overview()


