class Bus:
    def __init__(self, log):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.system = None
        self.log = log

    def call(self, target, method, args=None, reply=None, timeout=10_000, quiet=False, path=None, iface=None):
        name, default_path, default_iface = target
        try:
            res = self.conn.call_sync(name, path or default_path, iface or default_iface, method, args,
                                      GLib.VariantType(reply) if reply else None,
                                      Gio.DBusCallFlags.NONE, timeout, None)
        except GLib.Error as e:
            if not quiet:
                self.log(f"  ! {iface or default_iface}.{method}: {e.message}")
            return None
        return res.unpack() if res is not None else None

    def ok(self, target, method, args=None, path=None, iface=None):
        """Call a method with no reply; whether it worked."""
        name, default_path, default_iface = target
        try:
            self.conn.call_sync(name, path or default_path, iface or default_iface, method, args, None,
                                Gio.DBusCallFlags.NONE, 10_000, None)
            return True
        except GLib.Error as e:
            self.log(f"  ! {iface or default_iface}.{method}: {e.message}")
            return False

    def has_method(self, target, method):
        name, path, iface = target
        try:
            res = self.conn.call_sync(name, path, "org.freedesktop.DBus.Introspectable", "Introspect",
                                      None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 5000, None)
        except GLib.Error:
            return False
        info = Gio.DBusNodeInfo.new_for_xml(res.unpack()[0])
        i = info.lookup_interface(iface)
        return bool(i and i.lookup_method(method))

    def session_locked(self):
        try:
            if self.system is None:
                self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            res = self.system.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", "LockedHint")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None)
            return bool(res.unpack()[0])
        except GLib.Error:
            return False


class Input:
    """A RemoteDesktop session: umoja-mir's virtual keyboard and pointer."""

    def __init__(self, run):
        self.run = run
        res = run.bus.call(REMOTE, "CreateSession", None, "(o)")
        if not res:
            raise Stop("could not create a RemoteDesktop session (org.gnome.Mutter.RemoteDesktop)")
        self.path = res[0]
        if not run.bus.ok(REMOTE, "Start", path=self.path, iface=REMOTE_SESSION):
            raise Stop("could not start the RemoteDesktop session")
        self.held = []
        self.pointer = (0.0, 0.0)
        self.checked = 0.0

    def _call(self, method, sig, *args):
        # Never type or click into a blanked or locked screen.
        now = time.monotonic()
        if now - self.checked > 0.5:
            self.run.check_screen()
            self.checked = now
        self.run.bus.call(REMOTE, method, GLib.Variant(sig, args), path=self.path, iface=REMOTE_SESSION)

    def key(self, name, down):
        self._call("NotifyKeyboardKeysym", "(ub)", keysym(name), down)
        if down:
            self.held.append(name)
        elif name in self.held:
            self.held.remove(name)

    def press(self, *names, hold=0.05):
        """Press keys together (modifiers first), then let go in reverse."""
        for n in names:
            self.key(n, True)
            time.sleep(0.03)
        time.sleep(hold)
        for n in reversed(names):
            self.key(n, False)
            time.sleep(0.03)
        self.run.wait(0.25)

    def type(self, text):
        for ch in text:
            name = {" ": "space", "-": "minus", ".": "period"}.get(ch, ch)
            self.press(name, hold=0.01)

    def move(self, x, y):
        self._call("NotifyPointerMotionAbsolute", "(sdd)", "", float(x), float(y))
        self.pointer = (float(x), float(y))

    def rel(self, dx, dy):
        self._call("NotifyPointerMotionRelative", "(dd)", float(dx), float(dy))
        self.pointer = (self.pointer[0] + dx, self.pointer[1] + dy)

    def glide(self, x, y, seconds=0.5):
        x0, y0 = self.pointer
        steps = max(4, int(seconds / 0.016))
        for i in range(1, steps + 1):
            t = i / steps
            e = t * t * (3 - 2 * t)
            self.move(x0 + (x - x0) * e, y0 + (y - y0) * e)
            time.sleep(0.016)

    def button(self, btn, down):
        self._call("NotifyPointerButton", "(ib)", btn, down)

    def click(self, x, y, btn=BTN_LEFT, glide=True):
        if glide:
            self.glide(x, y, 0.35)
        else:
            self.move(x, y)
        time.sleep(0.15)
        self.button(btn, True)
        time.sleep(0.08)
        self.button(btn, False)
        self.run.wait(0.4)

    def drag(self, start, end, seconds=1.0, hold=0.4):
        self.glide(*start, seconds=0.35)
        time.sleep(0.15)
        self.button(BTN_LEFT, True)
        time.sleep(0.15)
        # Past the drag threshold first, as a hand would.
        self.move(start[0] + 12, start[1] + 6)
        time.sleep(0.05)
        self.glide(*end, seconds=seconds)
        time.sleep(hold)
        self.button(BTN_LEFT, False)
        self.run.wait(0.8)

    def scroll(self, steps):
        self._call("NotifyPointerAxisDiscrete", "(ui)", 0, int(steps))

    def release_all(self):
        for n in list(reversed(self.held)):
            try:
                self.key(n, False)
            except Stop:
                pass

    def close(self):
        self.release_all()
        self.run.bus.call(REMOTE, "Stop", path=self.path, iface=REMOTE_SESSION, quiet=True)


class Pad:
    """tools/test/testpad.py: a real GTK window the test can steer."""

    def __init__(self, run, name, app=PAD_APP, size=None):
        self.run = run
        self.file = Path(run.tmp) / f"{name}.txt"
        self.title = f"WM test {name} {MARK}"
        cmd = [sys.executable, str(HERE / "testpad.py"), str(self.file), "--app-id", app]
        if size:
            cmd += ["--size", f"{size[0]}x{size[1]}"]
        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True)
        line = self.proc.stdout.readline().strip()
        if line != "ready":
            self.proc.kill()
            raise Skip(f"the test pad didn't start (got {line!r}; it needs gir1.2-gtk-4.0)")
        self.cmd("title", self.title)
        self.id = run.wait_for(lambda: run.window_id(title=self.title), 10, f"{name}'s window")
        run.pads.append(self)
        run.wait(0.4)

    def cmd(self, *words):
        self.proc.stdin.write(" ".join(str(w) for w in words) + "\n")
        self.proc.stdin.flush()
        return self.proc.stdout.readline().strip()

    def state(self):
        reply = self.cmd("state")
        try:
            return int(reply.split()[-1])
        except (ValueError, IndexError):
            return 0

    def rect(self):
        return self.run.rect(self.id)

    def flags(self):
        return self.run.flags(self.id)

    def titlebar(self):
        x, y, w, _h = self.rect()
        return x + w / 2, y + 14

    def focus(self):
        self.run.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (self.id,)))
        self.run.wait(0.5)

    def close(self):
        if self.proc.poll() is not None:
            return
        try:
            self.cmd("quit")
            self.proc.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired, BrokenPipeError, ValueError):
            self.proc.kill()


class Recorder:
    """One wf-recorder per monitor, so every screen is on camera."""

    def __init__(self, run):
        self.run = run
        self.procs = []

    def start(self, name):
        if not self.run.video:
            return
        for mon in self.run.monitors:
            path = self.run.out / "videos" / f"{name}-{mon['output']}.mp4"
            cmd = ["wf-recorder", "-y", "-o", mon["output"], "-c", "libx264", "-p", "preset=ultrafast",
                   "-p", "crf=26", "-f", str(path)]
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
            self.procs.append((p, path))
        time.sleep(1.0)
        for p, path in self.procs:
            if p.poll() is None:
                self.run.current["videos"].append(str(path.relative_to(self.run.out)))
            else:
                self.run.log(f"  ! wf-recorder stopped at once for {path.name}")

    def stop(self):
        if not self.procs:
            return
        time.sleep(1.2)  # wf-recorder drops the tail
        for p, _ in self.procs:
            if p.poll() is None:
                p.send_signal(signal.SIGINT)
        for p, _ in self.procs:
            try:
                p.wait(timeout=15)
            except subprocess.TimeoutExpired:
                p.kill()
        self.procs = []


