KEYS = {
    "Super": 0xFFEB, "Shift": 0xFFE1, "Ctrl": 0xFFE3, "Alt": 0xFFE9,
    "Escape": 0xFF1B, "Return": 0xFF0D, "Tab": 0xFF09, "BackSpace": 0xFF08,
    "Left": 0xFF51, "Up": 0xFF52, "Right": 0xFF53, "Down": 0xFF54,
    "Page_Up": 0xFF55, "Page_Down": 0xFF56, "Home": 0xFF50, "End": 0xFF57,
    "F2": 0xFFBF, "space": 0x20, "grave": 0x60, "minus": 0x2D, "period": 0x2E,
}
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112

TESTS = []


def test(name, title, monitors=1):
    """Register a test; `monitors` is how many it needs."""

    def wrap(fn):
        TESTS.append((name, title, monitors, fn))
        return fn

    return wrap


class Skip(Exception):
    pass


class Stop(Exception):
    pass


def settings(schema):
    src = Gio.SettingsSchemaSource.get_default()
    return Gio.Settings.new(schema) if src and src.lookup(schema, True) else None


def keysym(name):
    if name in KEYS:
        return KEYS[name]
    if len(name) == 1:
        return ord(name.lower())
    raise ValueError(f"no keysym for {name!r}")


def centre(rect):
    x, y, w, h = rect[:4]
    return x + w / 2, y + h / 2


