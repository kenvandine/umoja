def _thumb_rect(st, index):
    return next((r[1:] for r in st.get("thumbnail_rects", []) if r[0] == index), None)


@test("thumbnail-drag", "Drag a small window from one thumbnail to another (O1)")
def t_thumbnail_drag(run):
    need_workspaces(run)
