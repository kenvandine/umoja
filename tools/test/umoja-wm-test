    run.check(small is not None, "the window shows in its workspace thumbnail", st.get("thumb_window_rects"))
    if not small:
        return
    target = cur + 1
    tr = _thumb_rect(st, target)
    if not tr:
        raise AssertionError(f"no thumbnail {target}: {st.get('thumbnail_rects')}")
    run.input.drag(centre(small[1:]), centre(tr), seconds=1.0)
    run.wait(1.0)
