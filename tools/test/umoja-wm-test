# umoja_shim.h UMOJA_WINDOW_* flags.
FOCUSED, MINIMIZED, CURRENT_WS, MAXIMIZED, FULLSCREEN, TILED = 1, 2, 4, 8, 16, 32
ATTENTION = 512
