def write_report(run):
    passed = sum(1 for r in run.results if r["status"] == "pass")
    failed = sum(1 for r in run.results if r["status"] == "fail")
    skipped = sum(1 for r in run.results if r["status"] == "skip")
    lines = [f"# Umoja window management test, {run.started:%Y-%m-%d %H:%M}", "",
             f"{passed} passed, {failed} failed, {skipped} skipped.", "", "Monitors:", ""]
    for m in run.monitors:
        lines.append(f"- {m['output']} ({m['connector']}) {m['w']}x{m['h']} at {m['x']},{m['y']}, "
                     f"scale {m['scale']:g}{', primary' if m['primary'] else ''}")
    lines += ["", "| Test | Result | |", "| --- | --- | --- |"]
    for r in run.results:
        lines.append(f"| `{r['name']}` | {r['status']} | {r['title']} |")
    for r in run.results:
        lines += ["", f"## {r['name']}: {r['status']}", "", r["title"], ""]
        if r.get("reason"):
            lines += [f"> {r['reason']}", ""]
        for c in r["checks"]:
            lines.append(f"- {'✓' if c['ok'] else '✗'} {c['check']}" + (f" (`{c['detail']}`)" if c["detail"] else ""))
        for n in r["notes"]:
            lines.append(f"- note: {n}")
        for v in r["videos"]:
            lines.append(f"- video: [{v}]({v})")
        for s in r["shots"]:
            lines += ["", f"![{s['caption']}]({s['file']})"]
    (run.out / "REPORT.md").write_text("\n".join(lines) + "\n")
    (run.out / "results.json").write_text(json.dumps(
        {"monitors": run.monitors, "results": run.results}, indent=2))


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--only", nargs="*", default=[])
    p.add_argument("--skip", nargs="*", default=[])
    p.add_argument("--list", action="store_true")
    p.add_argument("--out", type=Path)
    p.add_argument("--no-video", action="store_true")
    p.add_argument("--countdown", type=int, default=5)
    opts = p.parse_args()
    if opts.list:
        for name, title, mons, _ in TESTS:
            print(f"{name:28} {title}" + ("  [2 monitors]" if mons > 1 else ""))
        return 0
    if not os.environ.get("WAYLAND_DISPLAY"):
        sys.exit("run it inside the Umoja session (no WAYLAND_DISPLAY)")
    opts.out = opts.out or Path.home() / f"umoja-wm-test-{datetime.datetime.now():%Y%m%d-%H%M%S}"
    run = Run(opts)
    names = {n for n, *_ in TESTS}
    for n in opts.only + opts.skip:
        if n not in names:
            sys.exit(f"no test called {n!r} (--list shows them)")
    chosen = [t for t in TESTS if (not opts.only or t[0] in opts.only) and t[0] not in opts.skip]
    status = 0
    try:
        run.preflight()
        run.log(f"{len(chosen)} tests, writing to {run.out}")
        for i in range(opts.countdown, 0, -1):
            run.log(f"starting in {i}... hands off the keyboard and mouse")
            time.sleep(1)
        for name, title, mons, fn in chosen:
            run.current = {"name": name, "title": title, "status": "pass", "checks": [], "notes": [],
                           "shots": [], "videos": [], "reason": ""}
            run.results.append(run.current)
            run.log(f"== {name}: {title}")
            if len(run.monitors) < mons:
                run.current["status"] = "skip"
                run.current["reason"] = f"needs {mons} monitors"
                run.log("  skipped: needs more monitors")
                continue
            run.recorder.start(name)
            try:
                run.check_screen()
                fn(run)
            except Skip as e:
                run.current["status"] = "skip"
                run.current["reason"] = str(e)
                run.log(f"  skipped: {e}")
            except Stop:
                raise
            except AssertionError as e:
                run.check(False, str(e))
            except Exception:  # noqa: BLE001
                run.check(False, "the test crashed", traceback.format_exc())
            finally:
                run.recorder.stop()
                try:
                    run.reset()
                except Stop:
                    raise
                except Exception as e:  # noqa: BLE001
                    run.log(f"  ! reset: {e}")
            if run.current["status"] != "skip" and not all(c["ok"] for c in run.current["checks"]):
                run.current["status"] = "fail"
                status = 1
    except Stop as e:
        run.log(f"stopped: {e}")
        status = 2
    except KeyboardInterrupt:
        run.log("interrupted")
        status = 130
    finally:
        run.recorder.stop()
        run.teardown()
        write_report(run)
        run.log(f"report: {run.out / 'REPORT.md'}")
    return status


if __name__ == "__main__":
    sys.exit(main())
