def dock_point(run, icon):
    """Where an icon is on screen, from TestIcons (the dock on the primary
    monitor, centred on its edge as Mir places it)."""
    position, (dw, dh), _ = run.dock_icons()
    _id, _n, _f, _a, x, y, w, h = icon
    m = run.primary
    ax, ay, aw, ah = run.area(dock=False)
    if position == "left":
        ox, oy = m["x"], ay + (ah - dh) / 2
    elif position == "right":
        ox, oy = m["x"] + m["w"] - dw, ay + (ah - dh) / 2
    elif position == "bottom":
        ox, oy = m["x"] + (m["w"] - dw) / 2, m["y"] + m["h"] - dh
    else:
        ox, oy = m["x"] + (m["w"] - dw) / 2, ay
    return ox + x + w / 2, oy + y + h / 2


def pad_icon(run, app=PAD_APP):
    for i, icon in enumerate(run.dock_icons()[2]):
        if icon[0] == f"{app}.desktop":
            return i, icon
    return None, None


