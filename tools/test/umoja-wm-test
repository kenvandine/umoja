class Run:
    def __init__(self, opts):
        self.opts = opts
        self.out = opts.out
        (self.out / "images").mkdir(parents=True, exist_ok=True)
        (self.out / "videos").mkdir(exist_ok=True)
        (self.out / ".nomedia").touch()
        self.logf = open(self.out / "log.txt", "w")
        self.bus = Bus(self.log)
        self.video = not opts.no_video
        self.recorder = Recorder(self)
        self.tmp = tempfile.mkdtemp(prefix="umoja-wm-test-")
        self.results = []
        self.current = None
        self.pads = []
        self.restore = []  # (what, fn) to put back at the end
        self.input = None
        self.monitors = []
        self.inhibit_cookie = None
        self.signals = []
        self.started = datetime.datetime.now()

    # ---- plumbing ------------------------------------------------------

    def log(self, msg):
        line = f"{datetime.datetime.now():%H:%M:%S} {msg}"
        print(line, flush=True)
        self.logf.write(line + "\n")
        self.logf.flush()

    def check_screen(self):
        res = self.bus.call(SCREENSAVER, "GetActive", None, "(b)", quiet=True)
        if res and res[0]:
            raise Stop("the screen is blanked")
        if self.bus.session_locked():
            raise Stop("the session is locked")

    def wait(self, seconds, until=None):
        end = time.monotonic() + seconds
        ctx = GLib.MainContext.default()
        last = 0.0
        while True:
            while ctx.iteration(False):
                pass
            if until:
                v = until()
                if v:
                    return v
            now = time.monotonic()
            if now >= end:
                return None
            if now - last > 1.0:
                self.check_screen()
                last = now
            time.sleep(0.05)

    def wait_for(self, fn, timeout, what):
        v = self.wait(timeout, fn)
        if not v:
            raise AssertionError(f"timed out after {timeout:g} s waiting for {what}")
        return v

    def shot(self, name, caption):
        for mon in self.monitors:
            path = self.out / "images" / f"{self.current['name']}-{name}-{mon['output']}.png"
            r = subprocess.run(["grim", "-o", mon["output"], "-s", "1", str(path)],
                               capture_output=True, text=True)
            if r.returncode == 0:
                self.current["shots"].append({"file": str(path.relative_to(self.out)),
                                              "caption": f"{caption} ({mon['output']})"})
            else:
                self.log(f"  ! grim: {r.stderr.strip()}")
        self.log(f"  shot {name}")

    def check(self, ok, what, detail=""):
        self.current["checks"].append({"ok": bool(ok), "check": what, "detail": str(detail)[:2000]})
        self.log(f"  {'✓' if ok else '✗'} {what}" + (f": {str(detail)[:200]}" if detail else ""))
        return bool(ok)

    def note(self, text):
        self.current["notes"].append(text)
        self.log(f"  · {text}")

    # ---- what the desktop reports ----------------------------------------

    def windows(self):
        rows = self.bus.call(COMPOSITOR, "GetWindows", None, "(a(tssiiiiu))", quiet=True)
        return rows[0] if rows else []

    def window_id(self, title=None, app=None):
        for w in self.windows():
            if (title and w[2] == title) or (app and w[1] == app):
                return w[0]
        return None

    def window(self, wid):
        return next((w for w in self.windows() if w[0] == wid), None)

    def rect(self, wid):
        w = self.window(wid)
        return tuple(w[3:7]) if w else (0, 0, 0, 0)

    def flags(self, wid):
        w = self.window(wid)
        return w[7] if w else 0

    def focused(self):
        return next((w[0] for w in self.windows() if w[7] & FOCUSED), None)

    def workspaces(self):
        res = self.bus.call(COMPOSITOR, "GetWorkspaces", None, "(uu)", quiet=True)
        return res if res else (0, 1)

    def workspace_of(self, wid):
        rows = self.bus.call(COMPOSITOR, "GetWindowWorkspaces", None, "(a(ti))", quiet=True)
        return dict(rows[0]).get(wid) if rows else None

    def tiles(self):
        rows = self.bus.call(COMPOSITOR, "GetWindowTiles", None, "(a(tu))", quiet=True)
        return dict(rows[0]) if rows else {}

    def overview(self):
        res = self.bus.call(OVERLAY, "OverviewState", None, "(a{sv})", quiet=True)
        return res[0] if res else {}

    def overview_visible(self):
        return bool(self.overview().get("visible"))

    def dock_icons(self):
        res = self.bus.call(DOCK, "TestIcons", None, "(s(ii)a(subbiiii))", quiet=True)
        return res if res else ("left", (0, 0), [])

    def monitor_of(self, rect):
        cx, cy = centre(rect)
        for m in self.monitors:
            if m["x"] <= cx < m["x"] + m["w"] and m["y"] <= cy < m["y"] + m["h"]:
                return m
        return self.monitors[0]

    @property
    def primary(self):
        return self.monitors[0]

    def area(self, mon=None, dock=True):
        """The work area, roughly: the monitor less the top bar and, when
        it reserves space, the dock."""
        m = mon or self.primary
        x, y, w, h = m["x"], m["y"] + PANEL_HEIGHT, m["w"], m["h"] - PANEL_HEIGHT
        d = settings("org.gnome.shell.extensions.dash-to-dock")
        if dock and (not d or d.get_boolean("dock-fixed")):
            position, (dw, dh), _ = self.dock_icons()
            if position == "left":
                x, w = x + dw, w - dw
            elif position == "right":
                w -= dw
            elif position == "bottom":
                h -= dh
            elif position == "top":
                y, h = y + dh, h - dh
        return (x, y, w, h)

    def gset(self, schema, key, value):
        """Set a GSettings key for the run; it is put back at the end."""
        s = settings(schema)
        if not s or not s.settings_schema.has_key(key):
            raise Skip(f"{schema} {key} isn't installed")
        old = s.get_value(key)
        user_set = s.get_user_value(key) is not None
        s.set_value(key, value)
        Gio.Settings.sync()
        self.restore.append((f"{schema} {key}",
                             lambda: (s.set_value(key, old) if user_set else s.reset(key), Gio.Settings.sync())))
        self.wait(0.5)

    # ---- the session ----------------------------------------------------

    def read_monitors(self):
        res = self.bus.call(DISPLAY, "GetCurrentState", None, None)
        if not res:
            raise Stop("org.gnome.Mutter.DisplayConfig.GetCurrentState failed")
        _serial, monitors, logical, _props = res
        size = {}
        for spec, modes, _mprops in monitors:
            for mode in modes:
                if mode[6].get("is-current"):
                    size[spec[0]] = (mode[1], mode[2])
        mons = []
        for x, y, scale, _transform, primary, specs, _p in logical:
            spec = specs[0]
            w, h = size.get(spec[0], (1920, 1080))
            mons.append({"connector": spec[0], "output": spec[2], "x": x, "y": y,
                         "w": round(w / scale), "h": round(h / scale), "scale": scale, "primary": primary})
        mons.sort(key=lambda m: (not m["primary"], m["x"], m["y"]))
        self.monitors = mons
        return mons

    def flag(self, on):
        f = Path(GLib.get_user_runtime_dir()) / "umoja-demo"
        if on:
            f.touch()
        else:
            f.unlink(missing_ok=True)

    def install_pad_apps(self):
        apps = Path.home() / ".local/share/applications"
        apps.mkdir(parents=True, exist_ok=True)
        for app, name in ((PAD_APP, "WM Test Pad"), (PAD_APP2, "WM Test Pad Two")):
            path = apps / f"{app}.desktop"
            path.write_text(
                "[Desktop Entry]\nType=Application\n"
                f"Name={name} {MARK}\n"
                f"Exec={sys.executable} {HERE / 'testpad.py'} /dev/null --app-id {app}\n"
                "Icon=accessories-text-editor\nTerminal=false\n"
                "Actions=new-window;\n\n[Desktop Action new-window]\nName=New Window\n"
                f"Exec={sys.executable} {HERE / 'testpad.py'} /dev/null --app-id {app}\n")
            self.restore.append((f"remove {path.name}", lambda p=path: p.unlink(missing_ok=True)))
        subprocess.run(["update-desktop-database", str(apps)], capture_output=True)

    def preflight(self):
        problems = []
        for target, method in [(OVERLAY, "OverviewState"), (DOCK, "TestIcons"), (DOCK, "ActivateApp"),
                               (COMPOSITOR, "PlaceWindow"), (COMPOSITOR, "SendWindowToNewWorkspace"),
                               (PANEL, "FocusNotification"), (REMOTE, "CreateSession")]:
            if not self.bus.has_method(target, method):
                problems.append(f"{target[2]}.{method} is missing: install the debs with the window "
                                "management work and log in again")
        for tool in ("grim",):
            if not shutil.which(tool):
                problems.append(f"{tool} is not installed")
        if problems:
            for p in problems:
                self.log(f"! {p}")
            sys.exit(1)
        if self.video and not shutil.which("wf-recorder"):
            self.log("wf-recorder is missing: no videos")
            self.video = False
        self.check_screen()
        self.read_monitors()
        for m in self.monitors:
            self.log(f"monitor {m['output']} ({m['connector']}) {m['w']}x{m['h']}+{m['x']}+{m['y']} "
                     f"scale {m['scale']:g}{' primary' if m['primary'] else ''}")
        res = self.bus.call(SCREENSAVER, "Inhibit",
                            GLib.Variant("(ss)", ("umoja-wm-test", "Testing window management")), "(u)")
        self.inhibit_cookie = res[0] if res else None
        self.flag(True)
        self.install_pad_apps()
        self.input = Input(self)
        # Banners on (Do Not Disturb would hide what some tests check).
        n = settings("org.gnome.desktop.notifications")
        if n and not n.get_boolean("show-banners"):
            self.gset("org.gnome.desktop.notifications", "show-banners", GLib.Variant("b", True))
        (self.out / "setup.json").write_text(json.dumps({
            "monitors": self.monitors, "workspaces": list(self.workspaces()),
            "versions": versions(), "started": self.started.isoformat()}, indent=2))

    def reset(self):
        """Between tests: nothing held, no overview or popups, test windows
        gone, back on the last (empty) workspace."""
        if self.input:
            self.input.release_all()
        if self.overview_visible():
            self.bus.call(OVERLAY, "ToggleOverview", quiet=True)
        self.bus.call(OVERLAY, "HideSwitcher", quiet=True)
        for p in self.pads:
            p.close()
        self.pads = []
        self.wait(0.8)
        cur, count = self.workspaces()
        if cur != count - 1:
            self.bus.call(COMPOSITOR, "SwitchWorkspace", GLib.Variant("(u)", (count - 1,)), quiet=True)
            self.wait(0.6)

    def teardown(self):
        try:
            self.reset()
        except Stop:
            pass
        if self.input:
            self.input.close()
        for what, fn in reversed(self.restore):
            try:
                fn()
                self.log(f"put back: {what}")
            except Exception as e:  # noqa: BLE001
                self.log(f"! could not put back {what}: {e}")
        self.flag(False)
        if self.inhibit_cookie is not None:
            self.bus.call(SCREENSAVER, "UnInhibit", GLib.Variant("(u)", (self.inhibit_cookie,)), quiet=True)
        since = self.started.strftime("%Y-%m-%d %H:%M:%S")
        with open(self.out / "journal.txt", "w") as f:
            subprocess.run(["journalctl", "--user", "--since", since, "--no-pager", "-o", "short-precise",
                            "-u", "umoja-*"], stdout=f, stderr=subprocess.DEVNULL)
        shutil.rmtree(self.tmp, ignore_errors=True)

    # ---- common steps ------------------------------------------------------

    def open_overview(self):
        if not self.overview_visible():
            self.input.press("Super")
        return self.wait_for(lambda: self.overview_visible() and self.overview().get("card") is not None
                             and self.overview(), 5, "the overview")

    def close_overview(self):
        if self.overview_visible():
            self.input.press("Escape")
            self.wait(0.6, lambda: not self.overview_visible())

    def go_to_new_workspace(self):
        cur, count = self.workspaces()
        if cur != count - 1:
            self.bus.call(COMPOSITOR, "SwitchWorkspace", GLib.Variant("(u)", (count - 1,)))
            self.wait(0.6)
        return self.workspaces()


def versions():
    out = {}
    for pkg in ("umoja-desktop", "umoja-mir", "libmiral7", "libmirserver64"):
        r = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", pkg], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout:
            out[pkg] = r.stdout
    return out


def need_workspaces(run):
    dyn = settings("org.gnome.mutter")
    if dyn and not dyn.get_boolean("dynamic-workspaces"):
        raise Skip("needs dynamic workspaces (org.gnome.mutter dynamic-workspaces)")


