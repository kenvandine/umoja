    # ---- a clean start ------------------------------------------------

    def open_apps(self):
        self.reset_agent()
        self.editor_sessions(False)
        super().open_apps()

    def reset_agent(self):
        """No jobs, cards, shares or files from earlier runs on camera."""
        s = self.agent_state()
        if not s:
            return
        for sh in s.get("shared", []):
            log(f"  unshare {sh.get('path')}")
            self.bus.call(AGENTS, "Unshare", GLib.Variant("(s)", (sh["path"],)), quiet=True, timeout=120_000)
        if self.dry or self.bus.has_method(AGENTS, "ClearFinished"):
            log("  clear finished jobs and waiting requests")
            self.bus.call(AGENTS, "ClearFinished", quiet=True, timeout=60_000)
        else:
            log("  ! this umoja-agentd can't clear old jobs (needs newer debs): they'll show")
        ws = self.workspace()
        if ws.is_dir() and not self.dry:
            keep = ".earlier demo runs"
            old = ws / keep / time.strftime("%Y%m%d-%H%M%S")
            for f in ws.iterdir():
                if f.name == keep or f.name.startswith("."):
                    continue
                old.mkdir(parents=True, exist_ok=True)
                shutil.move(str(f), str(old / f.name))
            if old.exists():
                log(f"  moved earlier files aside to {old}")
        self.editor_restore = None

    def editor_sessions(self, on):
        """Text Editor reopening last session's files (Lisbon weekend.md
        from an earlier run, before the agent writes it) off for the run."""
        s = tour.settings("org.gnome.TextEditor")
        if s is None or "restore-session" not in s.props.settings_schema.list_keys() or self.dry:
            return
        if not on:
            self.editor_restore = s.get_boolean("restore-session")
            s.set_boolean("restore-session", False)
        elif getattr(self, "editor_restore", None) is not None:
            s.set_boolean("restore-session", self.editor_restore)
            self.editor_restore = None

    def deny_stray(self):
        """Requests no running job waits on (a site the last job reached
        for after it finished) are turned down before the next job."""
        if self.dry:
            return
        s = self.agent_state()
        running = {t["id"] for t in s.get("tasks", []) if t.get("status") in ("running", "waiting")}
        for a in s.get("approvals", []):
            if a.get("task") not in running and a.get("kind") != "question":
                log(f"  turn down a leftover request: {a.get('title')}")
                self.bus.call(AGENTS, "Answer", GLib.Variant("(ss)", (a["id"], "deny")), quiet=True)

    # ---- helpers ------------------------------------------------------

    def workspace(self):
        s = self.agent_state()
        return Path.home() / "Agents" / (s.get("agent_name") or "Hermes")

    def clear_old(self, names):
        """Move files of an earlier run aside, so this one starts clean."""
        ws = self.workspace()
        old = ws / f".earlier demo runs/{time.strftime('%Y%m%d-%H%M%S')}"
        for n in names:
            f = ws / n
            if f.exists() and not self.dry:
                old.mkdir(parents=True, exist_ok=True)
                shutil.move(str(f), str(old / n))
                log(f"  moved an earlier {n} aside")

    def demo_folder(self, name, files):
        """A folder of demo files under ~/Umoja Agent Demo."""
        root = Path.home() / DEMO_DIR_NAME
        if self.agent_dir is None and not self.dry:
            if root.exists():
                shutil.rmtree(root, ignore_errors=True)
            root.mkdir()
            self.agent_dir = root
        d = root / name
        if not self.dry:
            d.mkdir(parents=True, exist_ok=True)
            for rel, text in files.items():
                (d / rel).write_text(text)
        return d

    def share(self, path, writable):
        """Shares a host folder with the agent; returns where it sees it."""
        if self.dry:
            log(f"  share {path} ({'writable' if writable else 'read-only'})")
            return f"/sandbox/shared/{path.name}"
        res = self.bus.call(AGENTS, "ShareFolder", GLib.Variant("(sb)", (str(path), writable)), "(s)",
                            timeout=180_000)
        if not res:
            return None
        self.shares.append(path)
        log(f"  shared {path} as {res[0]}")
        return res[0]

    def show_folder(self, path):
        """Files on `path`, as a window of its own (closed at the end)."""
        if self.dry:
            return None
        before = {w[0] for w in self.windows()}
        try:
            tour.DesktopAppInfo.new("org.gnome.Nautilus.desktop").launch_uris(
                [Gio.File.new_for_path(str(path)).get_uri()], None)
        except (GLib.Error, TypeError, AttributeError) as e:
            log(f"  ! couldn't open {path} in Files: {e}")
            return None
        t0 = time.monotonic()
        wid = self.wait_for_window(before)
        self.recorder.waited(t0, time.monotonic())
        if wid is not None:
            self.extra_windows.append(wid)
            self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (wid,)), quiet=True)
        self.wait(1.0)
        return wid

    def close_window(self, wid):
        if wid is not None:
            self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (wid,)), quiet=True)
            if wid in self.extra_windows:
                self.extra_windows.remove(wid)
            self.wait(0.6)

    def job(self, name, prompt, caption, handed_caption, done_caption, result_caption, check=None,
            allow=True, show_result=True, before_follow=None, scroll_to=None, hold=2.5):
        """One filmed job: hand it over in Ask Umoja, follow it (consent
        cards answered on camera), then the result. `check(task)` says
        whether it really did the job. Returns the task, or None (the clip
        is dropped)."""
        if not self.agent_ready():
            return None
        n = self.agent_name()
        self.deny_stray()
        self.recorder.start(name)
        try:
            tid = self.hand_to_agent(prompt, f"{name}-handed", handed_caption.format(n=n))
            if not tid:
                log(f"  ! the hand-off didn't make a task, leaving {name} out")
                self.recorder.discard()
                return None
            if before_follow:
                before_follow(tid)
            t = self.follow_agent(tid, name, allow=allow)
            ok = bool(t) and t.get("status") == "done" and (check(t) if check and not self.dry else True)
            if not ok:
                log(f"  ! {name}: {(t or {}).get('status')}: {(t or {}).get('result', '')[:160]!r}, leaving it out")
                self.recorder.discard()
                return None
            self.wait(2.0)  # its "done" notification
            self.shot(f"{name}-done", done_caption.format(n=n))
            if show_result:
                # Its notification's Open: the whole answer in Ask Umoja
                # (which closes the notification).
                self.show_agent_answer(tid, f"{name}-answer", result_caption.format(n=n),
                                       scroll_to=scroll_to, hold=hold)
            elif not self.dry and self.bus.has_method(AGENTS, "Viewing"):
                # Read here: its notification goes, so it can't cover Ask
                # Umoja when the next job is typed.
                self.bus.call(AGENTS, "Viewing", GLib.Variant("(s)", (tid,)), quiet=True)
                self.bus.call(AGENTS, "Viewing", GLib.Variant("(s)", ("",)), quiet=True)
            self.recorder.stop(caption.format(n=n))
            return t
        finally:
            self.agent_menu(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.scrub_overlay()

    # ---- scenes -------------------------------------------------------

    def scene_agent_intro(self):
        """Where the agent lives: its row in Ask Umoja's settings (which
        agent, how often it asks first), and the Agents button."""
        if not self.agent_ready():
            return
        n = self.agent_name()
        self.demo_flag(True)
        self.recorder.start("agent-intro")
        try:
            self.bus.call(OVERLAY, "ToggleAsk", quiet=True)
            self.wait(1.2)
            res = self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", ("settings-open",)), "(bs)", quiet=True)
            if res and res[0] or self.dry:
                self.wait(1.8)
                self.shot("agent-intro-settings", f"{n} is set up from Ask Umoja's settings: pick how often it "
                          "asks you first. It runs in a sandbox and only sees what you share.")
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.8)
            self.agent_menu(True)
            self.shot("agent-intro-menu", f"The Agents button on the top bar: {n}'s jobs, and anything it needs "
                      "from you.")
            self.wait(1.5)
            self.agent_menu(False)
            self.open_menu("quick-settings")
            self.wait(0.8)
            self.shot("agent-intro-tile", f"And a tile in Quick Settings: what {n} is doing, and a switch to pause it.")
            self.wait(1.2)
            self.bus.call(tour.PANEL, "ToggleMenu", GLib.Variant("(s)", ("quick-settings",)))
            self.wait(0.6)
            self.recorder.stop(f"Meet {n}: an agent that works on longer jobs in the background, safely in its "
                               "own sandbox. You hand it jobs from Ask Umoja.")
        finally:
            self.demo_flag(False)
            self.agent_menu(False)
            self.scrub_overlay()

    def scene_agent_trip(self):
        self.clear_old([TRIP_FILE])
        self.trip_task = self.job(
            "agent-trip", TRIP,
            caption="“@agent plan a weekend in Lisbon”: {n} plans it while you get on with your day, "
                    "and saves the plan for you.",
            handed_caption="Type “@agent” and the job in Ask Umoja: {n} takes it from there.",
            done_caption="Done: a notification says so.",
            result_caption="Three days in Lisbon, planned: where to go, where to eat, how to get around, what it costs.",
            check=lambda t: (self.workspace() / TRIP_FILE).exists())

    def scene_agent_followup(self):
        """A reply under the finished plan, in Ask Umoja: the agent carries
        on in the same conversation and the plan is updated."""
        t = self.trip_task
        if not t and not self.dry:
            log("  needs agent-trip first, skipping")
            return
        if not self.agent_ready():
            return
        n = self.agent_name()
        tid = (t or {}).get("id", "dry-task")
        self.recorder.start("agent-followup")
        opened = None
        try:
            self.show_agent_answer(tid, "agent-followup-answer",
                                   f"The plan in Ask Umoja, with a reply box: talk to {n} about it.")
            follow = self.reply_to_agent(tid, FOLLOWUP, "agent-followup-reply",
                                         f"“Add a rainy-day plan for Saturday”: {n} picks up the same plan.")
            if not follow:
                self.recorder.discard()
                return
            t2 = self.follow_agent(follow, "agent-followup", working_shot=False)
            if not t2 or t2.get("status") != "done":
                log(f"  ! the follow-up: {(t2 or {}).get('status')}, leaving agent-followup out")
                self.recorder.discard()
                return
            self.wait(2.0)
            self.show_agent_answer(follow, "agent-followup", "Updated: a rainy Saturday indoors, same budget.")
            self.wait(1.5)
            self.recorder.stop(f"Not quite right? Reply under the answer: {n} carries on from the same plan.")
        finally:
            self.agent_menu(False)
            self.close_window(opened)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.scrub_overlay()

    def scene_agent_phone(self):
        """Typing "telegram" in Ask Umoja offers the guided setup to talk to
        the agent from Telegram; its first step is shown, then closed
        (nothing is connected)."""
        if not self.agent_ready():
            return
        n = self.agent_name()
        if not self.dry and not self.bus.has_method(OVERLAY, "ShowMessagingSetup"):
            log("  this overlay has no Telegram setup (needs newer debs), skipping")
            return
        self.recorder.start("agent-phone")
        try:
            self.bus.call(OVERLAY, "AskType", GLib.Variant("(sb)", ("telegram", not self.opts.no_typing)))
            self.wait(self.typing_time("telegram") + 1.2)
            self.shot("agent-phone-row", f"Type “telegram” in Ask Umoja: “Talk to {n} from Telegram”.")
            self.bus.call(OVERLAY, "ShowMessagingSetup", quiet=True)
            self.wait(2.0)
            self.shot("agent-phone", f"A guided setup: make a bot with BotFather, paste its token, say hi, "
                      f"and {n} answers only you.")
            self.wait(2.0)
            self.recorder.stop(f"Type “telegram” in Ask Umoja to connect {n} to Telegram.")
        finally:
            self.bus.call(OVERLAY, "Hide", quiet=True)
