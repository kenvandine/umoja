class AgentDemo(tour.Demo):
    SCENES = SCENES
    AI_SCENES = []
    TRAILER = TRAILER
    TITLES = TITLES
    HEADING = "Umoja's background agent"
    TAGLINE = "Hand off the busywork. Stay in charge."
    HERO = ("agent-trip", "agent-tidy", "agent-budget", "agent-weather")
    LEAD = ("agent-trip", "agent-tidy", "agent-budget")
    TOOL = "tools/demo/umoja-agent-demo"

    def __init__(self, opts):
        super().__init__(opts)
        self.agent_dir = None  # ~/Umoja Agent Demo, made by this run
        self.shares = []  # host folders shared for the demo
        self.extra_windows = []  # windows our scenes opened (Files on a folder)

    # ---- helpers ------------------------------------------------------

    def workspace(self):
        s = self.agent_state()
        return Path.home() / "Agents" / (s.get("agent_name") or "Hermes")

    def clear_old(self, names):
        """Move files of an earlier run aside, so this one starts clean."""
        ws = self.workspace()
        old = ws / f"earlier demo runs/{time.strftime('%Y%m%d-%H%M%S')}"
        for n in names:
            f = ws / n
            if f.exists() and not self.dry:
                old.mkdir(parents=True, exist_ok=True)
                shutil.move(str(f), str(old / n))
                log(f"  moved an earlier {n} aside")

    def demo_folder(self, name, files):
        """A folder of demo files under ~/Umoja Agent Demo."""
        root = Path.home() / DEMO_DIR_NAME
        if self.agent_dir is None and not self.dry:
            if root.exists():
                shutil.rmtree(root, ignore_errors=True)
            root.mkdir()
            self.agent_dir = root
        d = root / name
        if not self.dry:
            d.mkdir(parents=True, exist_ok=True)
            for rel, text in files.items():
                (d / rel).write_text(text)
        return d

    def share(self, path, writable):
        """Shares a host folder with the agent; returns where it sees it."""
        if self.dry:
            log(f"  share {path} ({'writable' if writable else 'read-only'})")
            return f"/sandbox/shared/{path.name}"
        res = self.bus.call(AGENTS, "ShareFolder", GLib.Variant("(sb)", (str(path), writable)), "(s)",
                            timeout=180_000)
        if not res:
            return None
        self.shares.append(path)
        log(f"  shared {path} as {res[0]}")
        return res[0]

    def show_folder(self, path):
        """Files on `path`, as a window of its own (closed at the end)."""
        if self.dry:
            return None
        before = {w[0] for w in self.windows()}
        try:
            tour.DesktopAppInfo.new("org.gnome.Nautilus.desktop").launch_uris(
                [Gio.File.new_for_path(str(path)).get_uri()], None)
        except (GLib.Error, TypeError, AttributeError) as e:
            log(f"  ! couldn't open {path} in Files: {e}")
            return None
        wid = self.wait_for_window(before)
        if wid is not None:
            self.extra_windows.append(wid)
            self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (wid,)), quiet=True)
        self.wait(1.0)
        return wid

    def close_window(self, wid):
        if wid is not None:
            self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (wid,)), quiet=True)
            if wid in self.extra_windows:
                self.extra_windows.remove(wid)
            self.wait(0.6)

    def job(self, name, prompt, caption, handed_caption, done_caption, result_caption, check=None,
            allow=True, show_result=True, before_follow=None):
        """One filmed job: hand it over in Ask Umoja, follow it (consent
        cards answered on camera), then the result. `check(task)` says
        whether it really did the job. Returns the task, or None (the clip
        is dropped)."""
        if not self.agent_ready():
            return None
        n = self.agent_name()
        self.recorder.start(name)
        opened = None
        try:
            tid = self.hand_to_agent(prompt, f"{name}-handed", handed_caption.format(n=n))
            if not tid:
                log(f"  ! the hand-off didn't make a task, leaving {name} out")
                self.recorder.discard()
                return None
            if before_follow:
                before_follow(tid)
            t = self.follow_agent(tid, name, allow=allow)
            ok = bool(t) and t.get("status") == "done" and (check(t) if check and not self.dry else True)
            if not ok:
                log(f"  ! {name}: {(t or {}).get('status')}: {(t or {}).get('result', '')[:160]!r}, leaving it out")
                self.recorder.discard()
                return None
            self.wait(2.0)  # its "done" notification
            self.shot(f"{name}-done", done_caption.format(n=n))
            if show_result and (t.get("files") or self.dry):
                opened = self.open_agent_result(t, name, result_caption.format(n=n))
                self.wait(2.0)
            self.recorder.stop(caption.format(n=n))
            return t
        finally:
            self.agent_menu(False)
            if opened is not None:
                self.close_window(opened)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.scrub_overlay()

    # ---- scenes -------------------------------------------------------

    def scene_agent_intro(self):
        """Where the agent lives: its row in Ask Umoja's settings (which
        agent, how often it asks first), and the Agents button."""
        if not self.agent_ready():
            return
        n = self.agent_name()
        self.demo_flag(True)
        self.recorder.start("agent-intro")
        try:
            self.bus.call(OVERLAY, "ToggleAsk", quiet=True)
            self.wait(1.2)
            res = self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", ("settings-open",)), "(bs)", quiet=True)
            if res and res[0] or self.dry:
                self.wait(1.8)
                self.shot("agent-intro-settings", f"{n} is set up from Ask Umoja's settings: pick how often it "
                          "asks you first. It runs in a sandbox and only sees what you share.")
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.8)
            self.agent_menu(True)
            self.shot("agent-intro-menu", f"The Agents button on the top bar: {n}'s jobs, and anything it needs "
                      "from you.")
            self.wait(1.5)
            self.agent_menu(False)
            self.recorder.stop(f"Meet {n}: an agent that works on longer jobs in the background, safely in its "
                               "own sandbox. You hand it jobs from Ask Umoja.")
        finally:
            self.demo_flag(False)
            self.agent_menu(False)
            self.scrub_overlay()

    def scene_agent_trip(self):
        self.clear_old([TRIP_FILE])
        self.job(
            "agent-trip", TRIP,
            caption="“@agent plan a weekend in Lisbon”: {n} plans it while you get on with your day, "
                    "and saves the plan for you.",
            handed_caption="Type “@agent” and the job in Ask Umoja: {n} takes it from there.",
            done_caption="Done: a notification says so.",
            result_caption="Three days in Lisbon, planned: where to go, where to eat, how to get around, what it costs.",
            check=lambda t: (self.workspace() / TRIP_FILE).exists())

    def scene_agent_weather(self):
        trip = self.workspace() / TRIP_FILE
        prompt = WEATHER if (trip.exists() or self.dry) else WEATHER.replace(
            f"add the forecast as a line at the top of {TRIP_FILE}", "save the forecast in Lisbon weather.md")
        before = trip.read_text() if trip.exists() else ""
        self.job(
            "agent-weather", prompt,
            caption="It only goes online where you let it: {n} asks before reaching a new site, "
                    "you Allow, and the forecast lands in your plan.",
            handed_caption="“@agent check this weekend's weather in Lisbon”",
            done_caption="Allowed once, and done.",
            result_caption="The forecast, at the top of the plan.",
            check=lambda t: (trip.exists() and trip.read_text() != before) or
                            (self.workspace() / "Lisbon weather.md").exists())

    def scene_agent_tidy(self):
        downloads = self.demo_folder("Downloads", DOWNLOADS)
        inside = self.share(downloads, writable=True)
        if not inside:
            log("  ! couldn't share the Downloads folder, skipping")
            return
        files_window = self.show_folder(downloads)
        self.shot("agent-tidy-before", "A Downloads folder like everyone's: invoices, photos, installers, "
                  "receipts, all in one heap.")

        def tidied(_t):
            loose = [p.name for p in downloads.iterdir() if p.is_file() and p.name != TIDY_NOTE]
            return (downloads / TIDY_NOTE).exists() and len(loose) <= 2

        try:
            t = self.job(
                "agent-tidy", TIDY.format(inside=inside),
                caption="Share a folder and say what you want: {n} sorts your Downloads into folders "
                        "and leaves a note of what went where. Nothing is deleted.",
                handed_caption="Shared with {n}, writable: “sort my Downloads into folders”.",
                done_caption="Sorted.",
                result_caption="Documents, Images, Receipts, Installers, and a note of what it moved.",
                check=tidied, show_result=False)
            if t and files_window is not None:
                self.recorder.start("agent-tidy-after")
                self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (files_window,)), quiet=True)
                self.wait(2.0)
                self.shot("agent-tidy-after", "After: four folders and a note. Everything is still there.")
                self.recorder.stop("Before and after: four tidy folders, and a note of what moved where.")
        finally:
            self.close_window(files_window)

    def scene_agent_budget(self):
        finances = self.demo_folder("Finances", {BANK_FILE: BANK})
        inside = self.share(finances, writable=False)
        if not inside:
            log("  ! couldn't share the Finances folder, skipping")
            return
        self.clear_old([BUDGET_FILE])
        self.job(
            "agent-budget", BUDGET.format(inside=inside),
            caption="Share a bank export, read-only: {n} turns it into a budget, with the "
                    "subscriptions you could cancel. It can read the file, never change it.",
            handed_caption="A bank statement, shared read-only: “make me a budget summary”.",
            done_caption="Done, and the statement is untouched.",
            result_caption="October at a glance: by category, the biggest costs, subscriptions to cancel, one tip.",
            check=lambda t: (self.workspace() / BUDGET_FILE).exists() and
                            (finances / BANK_FILE).read_text() == BANK)

    def scene_agent_lid(self):
        """Close the lid mid-job: a real 25 s suspend (sudo -n rtcwake). The
        agent carries on from where it was when the laptop wakes."""
        if not self.opts.suspend:
            log("  needs --suspend (a real 25 s suspend of this computer), skipping")
            return
        if not self.dry and subprocess.run(["sudo", "-n", "rtcwake", "--help"], capture_output=True).returncode:
            log("  needs passwordless sudo for rtcwake, skipping")
            return
        if not self.agent_ready():
            return
        n = self.agent_name()
        ws = self.workspace()
        self.clear_old(QUIZ_FILES)
        self.recorder.start("agent-lid")
        tid = self.hand_to_agent(QUIZ, "agent-lid-handed", f"A job with a few steps for {n}…")
        if not tid:
            self.recorder.discard()
            return
        # Wait for the first file, then close the lid.
        got = self.wait_for(lambda: (ws / QUIZ_FILES[0]).exists(), 180)
        if not got and not self.dry:
            log("  ! the first step never came, leaving agent-lid out")
            self.recorder.discard()
            return
        self.shot("agent-lid-before", "One question written…")
        self.recorder.stop(f"Halfway through a job for {n}…")
        log("  suspending for 25 s")
        if not self.dry:
            subprocess.run(["sudo", "-n", "rtcwake", "-m", "mem", "-s", "25"], capture_output=True)
            time.sleep(8)  # the session comes back
        self.check_screen()
        self.recorder.start("agent-lid-after")
        t = self.follow_agent(tid, "agent-lid", working_shot=False)
        made = [f for f in QUIZ_FILES if (ws / f).exists()]
        if not t or t.get("status") != "done" or (len(made) < len(QUIZ_FILES) and not self.dry):
            log(f"  ! after the wake: {(t or {}).get('status')}, {len(made)} files, leaving the second clip out")
            self.recorder.discard()
            return
        self.wait(2.0)
        self.shot("agent-lid", f"…and after the lid opens, {n} picks up where it left off.")
        opened = self.open_agent_result(t, "agent-lid-result", "The whole quiz, answers included.")
        self.wait(1.5)
        self.recorder.stop(f"Close the lid mid-job: when the laptop wakes, {n} carries on from where it was.")
        self.close_window(opened)

    def scene_agent_wrap(self):
        if not self.agent_ready():
            return
        n = self.agent_name()
        self.recorder.start("agent-wrap")
        wid = self.show_folder(self.workspace())
        self.wait(1.0)
        self.shot("agent-wrap", f"Everything {n} made is in ~/Agents/{n}, yours to keep.")
        self.agent_menu(True)
        self.shot("agent-wrap-menu", f"Every job in the Agents menu: what {n} did, and the files it made.")
        self.wait(1.5)
        self.agent_menu(False)
        self.recorder.stop(f"Everything {n} made, in one folder. Hand off the busywork; stay in charge.")
        self.close_window(wid)

    # ---- tidying ------------------------------------------------------

    def tidy(self):
        for wid in list(self.extra_windows):
            self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (wid,)), quiet=True)
        for path in self.shares:
            self.bus.call(AGENTS, "Unshare", GLib.Variant("(s)", (str(path),)), quiet=True, timeout=120_000)
        super().tidy()
        if self.agent_dir:
            shutil.rmtree(self.agent_dir, ignore_errors=True)

    def missing_tools(self, scenes, trailer_only=False):
        missing = super().missing_tools(scenes, trailer_only)
        if not trailer_only and not self.dry and not self.bus.has_name(AGENTS[0]):
            missing.append(("umoja-agentd", "umoja-agents", "the background agent"))
        return missing


def main():
    p = tour.parser(AgentDemo, "agent-demo",
                    "Film the background agent doing real jobs, hands-free, with clips and a trailer.")
    p.add_argument("--suspend", action="store_true",
                   help="film agent-lid: really suspend this computer for 25 s mid-job (sudo -n rtcwake)")
    opts = p.parse_args()
    for attr, default in (("ask", None), ("local", False), ("reinstall_agent", False)):
        if not hasattr(opts, attr):
            setattr(opts, attr, default)
    sys.exit(AgentDemo(opts).run())


if __name__ == "__main__":
    main()
