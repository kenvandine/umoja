    def missing_tools(self, scenes, trailer_only=False):
        """What this run needs and isn't installed, as (what, Ubuntu package,
        why). The tour refuses to start without them rather than leaving
        scenes or clips out half-way through."""
        need = []  # (command, package, why)
        if trailer_only:
            need += [("ffmpeg", "ffmpeg", "stitches the trailer"),
                     ("fc-match", "fontconfig", "finds the trailer's caption font")]
        else:
            need.append(("grim", "grim", "takes the stills"))
            if self.video:
                if not self.opts.no_audio:
                    need.append(("pactl", "pulseaudio-utils", "finds the speakers to record the clips' sound from"))
                need += [("wf-recorder", "wf-recorder", "films the clips"),
                         ("ffmpeg", "ffmpeg", "turns clips into GIFs and MP4s, and stitches the trailer")]
                if not self.opts.no_trailer:
                    need.append(("fc-match", "fontconfig", "finds the trailer's caption font"))
            if "ai-captions" in scenes:
                need.append(("parec", "pulseaudio-utils", "feeds Live Captions in the ai-captions scene"))
            if "screensaver" in scenes:
                need.append(("umoja-screensaver", "umoja-desktop", "the screensaver scene"))
            if "ai-btop" in scenes or "ai-opencode" in scenes:
                need.append(("snap", "snapd", "the ai-btop and ai-opencode scenes install snaps"))
            need += [("dpkg-query", "dpkg", "reads the umoja-desktop version"),
                     ("pgrep", "procps", "finds btop and the terminal")]
        missing = [(cmd, pkg, why) for cmd, pkg, why in need if not shutil.which(cmd)]
        if not trailer_only:
            if not self.opts.no_apps:
                for app, pkg in (("org.gnome.Nautilus.desktop", "nautilus"),
                                 ("org.gnome.TextEditor.desktop", "gnome-text-editor")):
                    if DesktopAppInfo.new(app) is None:
                        missing.append((app, pkg, "most scenes show Files and Text Editor"))
            if "ai-rewrite" in scenes:
                r = subprocess.run([sys.executable, "-c", "import gi; gi.require_version('Gtk', '4.0'); "
                                    "from gi.repository import Gtk"], capture_output=True)
                if r.returncode != 0:
                    missing.append(("GTK 4 for Python", "gir1.2-gtk-4.0", "the ai-rewrite scene's note window"))
        return missing

    def check_tools(self, scenes, trailer_only=False):
        missing = self.missing_tools(scenes, trailer_only)
        if not missing:
            return
        for what, pkg, why in missing:
            log(f"! {what} is missing ({pkg}): {why}")
        pkgs = sorted({pkg for _w, pkg, _y in missing if pkg != "umoja-desktop"})
        if pkgs:
            log(f"install them with: sudo apt install {' '.join(pkgs)}")
        if any(pkg == "umoja-desktop" for _w, pkg, _y in missing):
            log("umoja-screensaver comes with umoja-desktop; or leave the scene out with --skip screensaver")
        if self.dry:
            log("(dry run: carrying on anyway)")
            return
        sys.exit(1)

    def preflight(self):
        problems = []
        if not os.environ.get("WAYLAND_DISPLAY"):
            problems.append("run this inside the Umoja session (no WAYLAND_DISPLAY)")
        if "Umoja" not in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            problems.append("XDG_CURRENT_DESKTOP doesn't say Umoja; is this an Umoja session?")
        for target in (OVERLAY, PANEL, COMPOSITOR):
            if not self.bus.has_name(target[0]):
                problems.append(f"{target[0]} isn't on the session bus")
        if problems and not self.dry:
            for p in problems:
                log(f"! {p}")
            sys.exit(1)
        self.ffmpeg = bool(shutil.which("ffmpeg"))
        self.output, self.area = self.monitor()
        if self.opts.output:
            self.output = self.opts.output
        log(f"capturing monitor {self.output or '(all)'}; writing to {self.out}")
        if self.video and not self.opts.no_audio:
            self.audio = self.monitor_source()
            log(f"recording sound from {self.audio}" if self.audio else
                "! no default audio output found (pactl), the clips will be silent")
        if not self.dry and not self.bus.has_method(COMPOSITOR, "DragWindow"):
            log("note: the running compositor has no DragWindow, so there's no tiling scene and "
                "the windows can't be laid out. If you just installed newer debs, log out and back in.")

    def monitor_source(self):
        """The default output's monitor source (what the speakers play),
        or None. Not the default source: that is the microphone."""
        if self.dry:
            return "@DEFAULT_MONITOR@"
        r = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True)
        sink = r.stdout.strip() if r.returncode == 0 else ""
        return f"{sink}.monitor" if sink else None

    def monitor(self):
        """(connector, (x, y, w, h)) of the primary monitor, in layout pixels."""
        res = self.bus.call(DISPLAY_CONFIG, "GetCurrentState", None, quiet=True)
        if not res:
            return None, (0, 0, 1920, 1080)
        _serial, monitors, logical, props = res
        physical_layout = props.get("layout-mode") == 2
        pick = next((lm for lm in logical if lm[4] and lm[5]), logical[0] if logical else None)
        if not pick or not pick[5]:
            return None, (0, 0, 1920, 1080)
        x, y, scale, _transform, _primary, mons, _p = pick
        connector = mons[0][0]
        w, h = 1920, 1080
        for (spec, modes, _mp) in monitors:
            if spec[0] != connector:
                continue
            for mode in modes:
                if mode[6].get("is-current"):
                    w, h = mode[1], mode[2]
        if not physical_layout and scale:
            w, h = round(w / scale), round(h / scale)
        if pick[3] in (1, 3, 5, 7):  # rotated 90/270
            w, h = h, w
        return connector, (x, y, w, h)

    def keep_previous(self, rerun):
        """Loads the shots and clips of the scenes not in `rerun` from the
        earlier run's README.md, so they stay (prepare_out leaves their
        files, and the page and trailer include them)."""
        import re
        readme = self.out / "README.md"
        if not readme.exists():
            return
        by_title = {t: sc for sc, t in self.TITLES.items()}
        shot = re.compile(r"^!\[(?P<cap>.*)\]\((?P<path>[^)]*)\)$")
        clip = re.compile(r"^\[!\[(?P<cap>.*)\]\((?P<gif>[^)]*)\)\]\((?P<mp4>[^)]*\.mp4)\)$")
        bare = re.compile(r"^\[(?P<cap>.*) \(video\)\]\((?P<mp4>[^)]*)\)$")
        scene = None
        kept = 0
        for line in readme.read_text().splitlines():
            line = line.strip()
            if line.startswith("## "):
                scene = by_title.get(line[3:])
                continue
            if scene is None or scene in rerun:
                continue
            if m := clip.match(line):
                if (self.out / m["mp4"]).exists():
                    gif = self.out / m["gif"]
                    self.videos.setdefault(scene, []).append((gif if gif.exists() else None, self.out / m["mp4"], m["cap"]))
                    kept += 1
            elif m := bare.match(line):
                if (self.out / m["mp4"]).exists():
                    self.videos.setdefault(scene, []).append((None, self.out / m["mp4"], m["cap"]))
                    kept += 1
            elif m := shot.match(line):
                if (self.out / m["path"]).exists():
                    self.shots.setdefault(scene, []).append((self.out / m["path"], m["cap"]))
                    kept += 1
        if kept:
            log(f"keeping {kept} shots and clips of the earlier run's other scenes")
            try:
                self.layout.update(json.loads((self.img_dir / "layout.json").read_text()))
            except (OSError, ValueError):
                pass

    def prepare_out(self):
        if self.dry:
            return
        manifest = self.out / ".umoja-demo-files"
        keep = {self.rel(p) for v in self.shots.values() for p, _ in v}
        keep |= {self.rel(p) for v in self.videos.values() for g, m, _ in v for p in (g, m) if p}
        if keep:
            # Rewritten at the end anyway; an interrupted run (Ctrl+C while
            # the trailer encodes) shouldn't leave the tour without them.
            keep |= {self.rel(self.img_dir / "layout.json"), "README.md", "snippet.md",
                     self.rel(self.vid_dir / "trailer.mp4")}
        if manifest.exists():  # remove what an earlier run wrote, nothing else
            for line in manifest.read_text().splitlines():
                if line in keep:
                    continue
                p = self.out / line
                if p.is_file() and p.resolve().is_relative_to(self.out.resolve()):
                    p.unlink()
        for d in (self.img_dir, self.vid_dir, self.raw_dir):
            d.mkdir(parents=True, exist_ok=True)

    def inhibit(self):
        res = self.bus.call(
            SCREENSAVER, "Inhibit",
            GLib.Variant("(ss)", ("umoja-demo", "Recording a demo of the desktop")), "(u)",
        )
        self.inhibit_cookie = res[0] if res else None

    def uninhibit(self):
        if self.inhibit_cookie is not None:
            self.bus.call(SCREENSAVER, "UnInhibit", GLib.Variant("(u)", (self.inhibit_cookie,)),
                          quiet=True)

    def notifications_on(self):
        """Do Not Disturb would hide the bubbles; lift it for the tour."""
        if self.dry:
            return
        s = settings("org.gnome.desktop.notifications")
        if not s:
            return
        self.banners = s.get_boolean("show-banners")
        if not self.banners:
            log("turning Do Not Disturb off for the tour (restored afterwards)")
            s.set_boolean("show-banners", True)
            Gio.Settings.sync()

    def windows(self):
        rows = self.bus.call(COMPOSITOR, "GetWindows", None, "(a(tssiiiiu))", quiet=True)
        return rows[0] if rows else []

    def open_apps(self):
        if self.opts.no_apps:
            return
        found = []
        for desktop_id in APP_CANDIDATES:
            try:
                info = DesktopAppInfo.new(desktop_id)
            except TypeError:
                info = None
            if info:
                found.append(info)
            if len(found) == 3:
                break
        demo = self.make_demo_dir()
        uris = {
            "org.gnome.Nautilus.desktop": demo,
            "org.gnome.TextEditor.desktop": demo / "Release notes.md" if demo else None,
        }
        before = {w[0] for w in self.windows()}
        for info in found:
            log(f"  open {info.get_id()}")
            if self.dry:
                continue
            ids = {w[0] for w in self.windows()}
            try:
                target = uris.get(info.get_id())
                if target:
                    info.launch_uris([Gio.File.new_for_path(str(target)).get_uri()], None)
                else:
                    info.launch([], None)
            except GLib.Error as e:
                log(f"  ! could not open {info.get_id()}: {e.message}")
                continue
            new = self.wait_for_window(ids)
            if new is not None:
                self.opened.append(new)
        if self.dry:
            return
        self.opened = [w for w in self.opened if w not in before]
        for wid, info in zip(self.opened, found):
            self.names[wid] = info.get_name()
        # Nothing maximized or full screen: the wallpaper should show.
        for w in self.windows():
            if w[0] in self.opened and w[7] & (F_MAXIMIZED | F_FULLSCREEN | F_TILED):
                self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (w[0], TILE_RESTORE)))
        self.wait(0.6)
        self.arrange_floating()
        if len(self.opened) >= 3 and self.bus.has_method(COMPOSITOR, "SendWindowToWorkspace"):
            cur, _count = self.workspaces()
            self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                          GLib.Variant("(tu)", (self.opened[2], cur + 1)))
        self.wait(1.5)

    def make_demo_dir(self):
        if self.dry or self.opts.no_demo_folder:
            return None
        d = Path.home() / DEMO_DIR_NAME
        if d.exists():
            log(f"  ~/{DEMO_DIR_NAME} already exists; using it as it is")
            return d
        for rel, text in DEMO_FILES.items():
            f = d / rel
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text)
        self.demo_dir = d
        return d

    def can_drag(self):
        return self.bus.has_method(COMPOSITOR, "DragWindow")

    def drag(self, wid, x, y, ms=900):
        """Drag a window by its title bar to (x, y), as a person would."""
        self.check_screen()
        log(f"  drag {self.names.get(wid, wid)} -> {x},{y}")
        self.bus.call(COMPOSITOR, "DragWindow", GLib.Variant("(tiiu)", (wid, int(x), int(y), ms)),
                      "(b)", timeout=ms + 5000)
        # The dock slides away or back when windows touch it: let it finish.
        self.wait(1.2)

    def park_pointer(self):
        """Warp the pointer to the right screen edge, where almost all of
        it is off screen and it hovers nothing (no tooltips in the shots).
        A warp, not input: no clicks or motion reach any app."""
        if self.can_park is None:
            self.can_park = self.bus.has_method(COMPOSITOR, "MovePointer")
        if not self.can_park:
            return
        x, y, w, h = self.area
        self.bus.call(COMPOSITOR, "MovePointer",
                      GLib.Variant("(ii)", (x + w - 1, y + int(h * 0.75))), quiet=True)

    def editor_to_front(self):
        """Text Editor in front of Files: its text is the more interesting."""
        editor = next((wid for wid, n in self.names.items()
                       if wid in self.opened[:2] and "Text" in (n or "")), None)
        if editor is None and len(self.opened) >= 2:
            editor = self.opened[1]
        if editor is not None and not self.dry:
            self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (editor,)), quiet=True)
            self.wait(0.4)

    def arrange_floating(self):
        """Two windows floating, overlapping a little, with desktop around them."""
        if not self.can_drag():
            return
        x, y, w, h = self.area
        sizes = {r[0]: (r[5], r[6]) for r in self.windows()}
        # The first window near the left (clear of the dock), the second
        # against the right edge, so they overlap as little as the screen
        # allows; the third (sent to another workspace) in the middle.
        # Points are where the title bar is grabbed: its middle.
        for i, wid in enumerate(self.opened[:3]):
            ww, _wh = sizes.get(wid, (w // 2, h // 2))
            if i == 0:
                gx = x + 90 + ww // 2
                gy = y + int(h * 0.10)
            elif i == 1:
                gx = x + w - 30 - ww // 2
                gy = y + int(h * 0.22)
            else:
                gx, gy = x + w // 2, y + int(h * 0.18)
            self.spots[wid] = (gx, gy)
            self.drag(wid, gx, gy, ms=450)
        self.editor_to_front()

    def find_terminal(self):
        """The window we were started from: focused when the tour begins."""
        if self.opts.keep_terminal or self.dry:
            return
        focused = [w for w in self.windows() if w[7] & F_FOCUSED]
        if focused:
            self.terminal = focused[0][0]
            self.terminal_name = focused[0][1] or focused[0][2]

    def hide_terminal(self):
        """Get the terminal out of every shot, the overview included: send it
        to its own workspace past the demo's ones, then minimize it."""
        if self.opts.keep_terminal:
            return
        if self.dry:
            log("  move this terminal to a spare workspace and minimize it")
            return
        if self.terminal is None:
            return
        log(f"  hide {self.terminal_name} (restored at the end)")
        _cur, count = self.workspaces()
        if self.bus.has_method(COMPOSITOR, "SendWindowToWorkspace") and count > 1:
            self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                          GLib.Variant("(tu)", (self.terminal, count - 1)))
            self.wait(0.4)
        self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (self.terminal, MINIMIZE)))
        self.wait(0.8)

    def wait_for_window(self, known, timeout=10):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            time.sleep(0.4)
            new = [w[0] for w in self.windows() if w[0] not in known]
            if new:
                time.sleep(0.6)  # let it draw its first frames
                return new[-1]
        log("  ! no new window appeared")
        return None

    def workspaces(self):
        res = self.bus.call(COMPOSITOR, "GetWorkspaces", None, "(uu)", quiet=True)
        return res if res else (0, 1)

    def tidy(self):
        """Put the desktop back. D-Bus calls only, safe on a blanked screen."""
        log("tidying up")
        self.recorder.abort()
        self.demo_flag(False)
        if self.saver and self.saver.poll() is None:
            self.saver.terminate()
        self.bus.call(OVERLAY, "Hide", quiet=True)
        if self.bus.has_method(OVERLAY, "HideScreenshotUI"):
            self.bus.call(OVERLAY, "HideScreenshotUI", quiet=True)
        self.bus.call(NOTIFICATIONS, "CloseReply", quiet=True)
        for nid in self.notes:
            self.bus.call(NOTIFY, "CloseNotification", GLib.Variant("(u)", (nid,)), quiet=True)
        for wid in self.opened:
            self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (wid,)), quiet=True)
        if self.demo_dir:
            time.sleep(1.0)  # let Files and Text Editor let go of it
            shutil.rmtree(self.demo_dir, ignore_errors=True)
        if self.start_workspace is not None:
            self.bus.call(COMPOSITOR, "ShowWorkspace",
                          GLib.Variant("(u)", (self.start_workspace,)), quiet=True)
        if self.terminal is not None:
            if self.start_workspace is not None:
                self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                              GLib.Variant("(tu)", (self.terminal, self.start_workspace)), quiet=True)
            time.sleep(0.5)
            self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (self.terminal,)), quiet=True)
        self.restore_style()
        if self.agent_before is not None:
            s = settings("org.umoja.shell")
            s.set_string("ai-agent", self.agent_before)
            Gio.Settings.sync()
        if self.banners is False:
            s = settings("org.gnome.desktop.notifications")
            s.set_boolean("show-banners", False)
            Gio.Settings.sync()
        self.uninhibit()

    # ---- scenes -------------------------------------------------------

    def scene_desktop(self):
        self.shot("desktop", "The desktop: top bar, Ubuntu-style dock and floating windows over the wallpaper.")

    def scene_tiling(self):
        if not self.can_drag():
            log("  this compositor can't drag windows over D-Bus (update umoja), skipping")
            return
        if len(self.opened) < 2 and not self.dry:
            log("  needs two of the demo's windows, skipping")
            return
        a, b = (self.opened[:2] if not self.dry else (1, 2))
        x, y, w, h = self.area
        mid = y + h // 2
        self.recorder.start("tiling")
        # Drag to the screen edges: the preview shows, the window snaps.
        self.drag(a, x + 3, mid)
        self.drag(b, x + w - 3, mid)
        self.wait(0.8)
        self.shot("tiling-halves", "Drag a window to a screen edge and it snaps to that half, like Ubuntu's Tiling Assistant.")
        # A corner gives a quarter.
        self.drag(b, x + w - 3, y + 3)
        self.wait(0.8)
        self.shot("tiling-quarter", "Drag to a corner for a quarter; tiled windows resize together.")
        self.wait(0.8)
        # The clip ends on the tiles; dragging back out isn't recorded.
        self.recorder.stop("Drag-to-tile: halves at the screen edges, quarters in the corners.")
        for wid in (a, b):
            spot = self.spots.get(wid) or (x + w // 2, y + h // 3)
            self.drag(wid, *spot)
        self.editor_to_front()
        self.wait(0.8)

    def scene_ask_umoja(self):
        """Ask Umoja over Text Editor: the empty card, then rows as you type."""
        if not self.dry and not self.bus.has_method(OVERLAY, "AskType"):
            log("  this overlay has no Ask Umoja (AskType), skipping")
            return
        self.editor_to_front()
        self.recorder.start("ask-umoja")
        self.bus.call(OVERLAY, "ToggleAsk")
        self.wait(1.4)
        self.shot("ask-umoja", "Ask Umoja (the Copilot key, or a tap of Alt) floats over the window "
                  "you're in, with its launcher actions and the things you use most.")
        for text, name, caption in ASK_TYPEAHEAD:
            self.bus.call(OVERLAY, "AskType", GLib.Variant("(sb)", (text, not self.opts.no_typing)))
            self.wait((0 if self.opts.no_typing else 0.06 * len(text)) + 1.4)
            self.shot(name, caption)
        self.recorder.stop("Ask Umoja: apps, switches, Settings, sums and questions as you type.")
        self.bus.call(OVERLAY, "Hide")
        self.wait(0.8)
        self.scrub_overlay()

    def scene_app_grid(self):
        self.bus.call(OVERLAY, "Show")
        self.wait(1.5)
        self.shot("app-grid", "The app grid (Super, then type, or Show Apps): apps and files. "
                  "The assistant lives in Ask Umoja instead.")
        self.bus.call(OVERLAY, "Hide")
        self.wait(0.8)

    def scene_overview(self):
        self.recorder.start("overview")
        self.bus.call(OVERLAY, "ToggleOverview")
        self.wait(1.8)
        self.shot("overview", "The Activities overview (Super): windows, workspace thumbnails and their neighbours.")
        if self.bus.has_method(OVERLAY, "ShiftOverview"):
            # The app grid: long enough to take in (1.5 s showed it for
            # about a second once the slide in and out was over).
            self.bus.call(OVERLAY, "ShiftOverview", GLib.Variant("(b)", (True,)))
            self.wait(2.8)
            self.bus.call(OVERLAY, "ShiftOverview", GLib.Variant("(b)", (False,)))
            self.wait(1.2)
        self.bus.call(OVERLAY, "ToggleOverview")
        self.wait(1.0)
        self.recorder.stop("Desktop, overview and app grid are steps on one ladder, as in GNOME.")

    def scene_workspaces(self):
        cur, count = self.workspaces()
        target = cur + 1 if cur + 1 < count else max(cur - 1, 0)
        if target == cur:
            log("  only one workspace, skipping")
            return
        self.recorder.start("workspaces")
        self.bus.call(COMPOSITOR, "SwitchWorkspace", GLib.Variant("(u)", (target,)))
        self.wait(1.5)
        self.shot("workspace-2", "Dynamic workspaces, switched with Super+Page Down or a three-finger swipe.")
        self.bus.call(COMPOSITOR, "SwitchWorkspace", GLib.Variant("(u)", (cur,)))
        self.wait(1.5)
        self.recorder.stop("Workspaces slide like GNOME's, with a popup showing where you are.")

    def open_menu(self, menu):
        """Open a top bar menu. A focus change just after (a window settling
        from the previous scene) can close a popover as it opens, and
        OpenMenu leaves an open one alone, so asking again is safe."""
        for _ in range(2):
            self.bus.call(PANEL, "OpenMenu", GLib.Variant("(s)", (menu,)))
            self.wait(0.7)

    def scene_quick_settings(self):
        self.wait(1.0)  # let the workspace switch settle first
        self.open_menu("quick-settings")
        self.wait(0.8)
        self.shot("quick-settings", "Quick Settings: network, Bluetooth, power mode, VPN, keyboard backlight and more.")
        self.bus.call(PANEL, "ToggleMenu", GLib.Variant("(s)", ("quick-settings",)))
        self.wait(0.8)

    def notify(self, app, icon, summary, body):
        res = self.bus.call(
            NOTIFY, "Notify",
            GLib.Variant("(susssasa{sv}i)", (app, 0, icon, summary, body, [], {}, -1)),
            "(u)",
        )
        if res:
            self.notes.append(res[0])

    def clear_notifications(self):
        """Start from an empty notification list, so the date menu, its
        digest and the assistant's summary show only the tour's three
        (--keep-notifications leaves the list alone)."""
        if self.opts.keep_notifications:
            return
        res = self.bus.call(NOTIFICATIONS, "GetNotifications", None, "(a(ussssx))", quiet=True)
        rows = res[0] if res else []
        if rows:
            log(f"  clearing {len(rows)} earlier notification(s) from the list")
        for row in rows:
            self.bus.call(NOTIFY, "CloseNotification", GLib.Variant("(u)", (row[0],)), quiet=True)
        if rows:
            self.wait(0.8)

    def scene_notifications(self):
        self.clear_notifications()
        self.recorder.start("notifications")
        for i, n in enumerate(DEMO_NOTIFICATIONS):
            self.notify(*n)
            self.wait(1.0)
            if i == len(DEMO_NOTIFICATIONS) - 1:
                self.shot("notifications", "Notifications behave like GNOME's and look like Unity's notify-osd bubbles.")
        # Keep recording until every bubble has faded (4 s + 30 ms a
        # character, so about 6.5 s) and a bit more: stopping the recorder
        # just as a bubble fades leaves its last frame frozen on screen.
        self.wait(7.5)
        self.recorder.stop("Notification bubbles stack up, then fade on their own.")
        # Give the date menu's digest ("Summarizing...") time to come in.
        self.wait(1.0)
        self.open_menu("calendar")
        self.wait(6.0 if self.ready else 2.0)
        self.shot("calendar", "The date menu keeps the notification list next to the calendar.")
        self.bus.call(PANEL, "ToggleMenu", GLib.Variant("(s)", ("calendar",)))
        self.wait(0.8)

    def scene_shortcuts(self):
        if not self.bus.has_method(OVERLAY, "ToggleShortcuts"):
            log("  this overlay has no shortcuts guide, skipping")
            return
        self.bus.call(OVERLAY, "ToggleShortcuts")
        self.wait(1.5)
        self.shot("shortcuts", "Super+/ shows every keyboard shortcut, read live from the compositor.")
        self.bus.call(OVERLAY, "ToggleShortcuts")
        self.wait(0.8)

    def scene_screenshot_ui(self):
        # Closing it needs HideScreenshotUI; older overlays only close on
        # Escape, and this tour never presses keys.
        if not self.bus.has_method(OVERLAY, "HideScreenshotUI"):
            log("  this overlay can't close the screenshot UI over D-Bus (update umoja), skipping")
            return
        self.bus.call(OVERLAY, "ShowScreenshotUI")
        self.wait(1.5)
        self.shot("screenshot-ui", "The screenshot UI (Print): selection, screen or window, picture or screencast.")
        self.bus.call(OVERLAY, "HideScreenshotUI")
        self.wait(0.8)

    def scene_screensaver(self):
        exe = shutil.which("umoja-screensaver")
        if not exe and not self.dry:
            log("  umoja-screensaver isn't installed, skipping")
            return
        effect = self.opts.effect
        cmd = [exe or "umoja-screensaver"] + (["--effect", effect] if effect else [])
        log(f"  run  {' '.join(cmd)}")
        if not self.dry:
            # A preview ends on real input only; nothing here touches it.
            # Started before the recorder, so the clip doesn't open on the
            # plain desktop under the screensaver's caption.
            self.saver = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.recorder.start("screensaver")
        self.wait(2.5)
        self.shot("screensaver", "The screensaver: \"umoja\" drawn in glowing dots, a new effect each cycle.")
        self.wait(2.0)
        # End the clip on the screensaver, not the desktop after it.
        self.recorder.stop("Screensaver preview (umoja-screensaver).")
        if self.saver:
            self.saver.terminate()
            try:
                self.saver.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.saver.kill()
            self.saver = None
        self.wait(0.8)

    # ---- assistant ----------------------------------------------------

    def lemonade(self):
        url = os.environ.get("UMOJA_LEMONADE_URL", "").strip().rstrip("/")
        if not url:
            port = os.environ.get("UMOJA_LEMONADE_PORT", "").strip() or "13345"
            url = f"http://127.0.0.1:{port}"
        return url

    def local_model(self):
        s = settings("org.umoja.shell")
        model = s.get_string("lemonade-model") if s else ""
        return model or "Qwen3-4B-Instruct-2507-GGUF"

    def http(self, path, body=None, timeout=10):
        req = urllib.request.Request(
            self.lemonade() + path,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")

    def warm_model(self):
        """Load the local model first so the asks answer in seconds."""
        if self.dry:
            log(f"  warm {self.lemonade()} model {self.local_model()}")
            return True
        model = self.local_model()
        try:
            models = self.http("/api/v1/models").get("data", [])
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"  ! Lemonade isn't answering on {self.lemonade()} ({e}), skipping the assistant")
            return False
        if model not in [m.get("id") for m in models]:
            log(f"  ! the local model {model} isn't downloaded yet, skipping the assistant")
            return False
        log(f"  loading {model} (the first answer can take ~10 s)")
        try:
            self.http("/api/v1/chat/completions", {
                "model": model, "max_tokens": 1,
                "messages": [{"role": "user", "content": "Hi"}],
            }, timeout=180)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"  ! warming the model failed ({e}); asking anyway")
        return True

    def tiling_question(self):
        names = [self.names.get(w) for w in self.opened[:2]] if not self.dry else ["Files", "Text Editor"]
        if len(names) < 2 or not all(names):
            return None
        return f"Put {names[0]} on the left half of the screen and {names[1]} on the right half"

    def untile_demo_windows(self):
        for w in self.windows():
            if w[0] in self.opened and w[7] & (F_MAXIMIZED | F_FULLSCREEN | F_TILED):
                self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (w[0], TILE_RESTORE)))

    def assistant_ready(self, scenes):
        if not any(s.startswith("ai-") for s in scenes):
            return False
        if self.dry:
            return True
        self.can_ask_with = self.bus.has_method(OVERLAY, "AskWith")
        if not self.can_ask_with:
            log("note: this overlay has no AskWith, so questions aren't typed out and each answer "
                "gets a fixed wait (--answer-wait) with no checking. Install newer debs.")
        else:
            self.bus.conn.signal_subscribe(
                OVERLAY[0], OVERLAY[2], None, OVERLAY[1], None, Gio.DBusSignalFlags.NONE,
                lambda _c, _s, _p, _i, name, params: self.events.append((name, params.unpack(), time.monotonic())),
            )
        if self.opts.local:
            return self.warm_model()
        return True

    def ask(self, name, question, caption, expect=(), confirm=False, settle=1.5,
            keep_open=False, expect_steps=0, step_has=None, then=None):
        """Ask the assistant, recording it; retry until the answer checks out.

        `expect`: words, one of which the answer must contain. `confirm`:
        the ask should end at Ask Umoja's "Allow Umoja to do this?"
        confirmation, which is shot and then cancelled (the card is hidden:
        nothing is installed or sent). `then`: called after the shot, while
        still recording, for a follow-up in the same clip (Undo...).
        Returns the answer text, or None."""
        tries = 1 if self.dry else self.opts.retries
        for attempt in range(1, tries + 1):
            self.check_screen()
            self.events.clear()
            self.recorder.start(name)
            log(f"  ask  {question!r}" + (f" (try {attempt})" if attempt > 1 else ""))
            asked = time.monotonic() + self.typing_time(question)
            if self.dry or self.can_ask_with:
                flags = (1 if self.opts.local else 0) | (0 if self.opts.no_typing else 2)
                self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (question, flags)))
            else:
                self.bus.call(OVERLAY, "Ask", GLib.Variant("(s)", (question,)))
            if self.dry or not self.can_ask_with:
                self.wait(self.opts.answer_wait)
                result = ("", [])
            else:
                self.until = lambda: any(e[0] in ("AnswerFinished", "ConfirmShown") for e in self.events)
                try:
                    self.wait(self.opts.answer_timeout)
                finally:
                    self.until = None
                result = self.check_answer(expect, confirm, expect_steps, step_has)
                came = next((e[2] for e in self.events if e[0] in ("AnswerFinished", "ConfirmShown")), None)
                if came:
                    self.recorder.waited(asked, came)
            if result is not None:
                answer, steps = result
                self.wait(settle)
                self.shot(name, caption)
                if then:
                    then()
                # Stop on the result (the answer, the dialog), not on the
                # desktop after the overlay closes.
                self.wait(1.0)
                self.recorder.stop(caption)
                if not keep_open:
                    self.bus.call(OVERLAY, "Hide")
                    self.wait(0.8)
                    self.scrub_overlay()
                for st in steps:
                    log(f"       {st}")
                if answer:
                    log(f"       answer: {answer[:160]!r}")
                return answer
            self.recorder.discard()
            self.bus.call(OVERLAY, "Hide")
            self.wait(1.5)
        log(f"  ! no good answer after {tries} tries, leaving {name} out")
        return None

    def typing_time(self, text):
        """How long AskWith takes to type `text` out (38 ms a letter, then a
        pause: umoja-overlay's ask_with)."""
        return 0.0 if self.opts.no_typing else 0.038 * len(text) + 0.35

    def scrub_overlay(self):
        """Open and close the empty overlay once, off camera. Stopping the
        recorder can hold up the overlay's last paint (a compositor
        quirk), and a frame left over from this answer then flashes at
        the start of the next clip."""
        if self.dry:
            return
        # Answers show in Ask Umoja's card on builds that have it.
        opener = "ToggleAsk" if self.bus.has_method(OVERLAY, "ToggleAsk") else "Show"
        self.bus.call(OVERLAY, opener, quiet=True)
        self.wait(0.8)
        self.bus.call(OVERLAY, "Hide", quiet=True)
        self.wait(0.8)

    def check_answer(self, expect, confirm, expect_steps=0, step_has=None):
        """(answer, steps) when the answer is good, else None (logged)."""
        names = [e[0] for e in self.events]
        if confirm:
            if "ConfirmShown" in names:
                label = next(e[1][0] for e in self.events if e[0] == "ConfirmShown")
                return ("", [f"confirm:{label}"])
            log("  ! the assistant didn't ask for confirmation")
            return None
        done = [e for e in self.events if e[0] == "AnswerFinished"]
        if not done:
            if "ConfirmShown" in names:
                log("  ! it asked for confirmation; retrying")
            else:
                log(f"  ! no answer within {self.opts.answer_timeout:.0f} s")
            return None
        answer, steps = done[-1][1]
        bad = [st for st in steps if not st.startswith("done:")]
        if bad:
            log(f"  ! a step didn't work: {bad}")
            return None
        if len(steps) < expect_steps:
            log(f"  ! expected {expect_steps} steps, got {steps}")
            return None
        if step_has and not any(step_has.lower() in st.lower() for st in steps):
            log(f"  ! no step about {step_has!r}: {steps}")
            return None
        if expect and not any(w.lower() in answer.lower() for w in expect):
            log(f"  ! the answer doesn't mention any of {list(expect)}: {answer[:120]!r}")
            return None
        if not answer and not steps:
            log("  ! empty answer")
            return None
        return answer, steps

    def scene_ai_tiling(self):
        q = self.tiling_question()
        if not q:
            log("  needs Files and Text Editor open, skipping")
            return
        # The overlay closes itself once the windows are arranged; the shot
        # shows the result.
        self.ask("ai-tiling", q, "Tiling by asking for it, in plain words.", settle=1.2)
        self.wait(0.5)
        self.untile_demo_windows()
        self.wait(1.0)
        self.editor_to_front()

    def scene_ai_settings(self):
        iface = settings("org.gnome.desktop.interface")
        nl = settings(NIGHT_LIGHT[0])
        if not iface:
            log("  no org.gnome.desktop.interface, skipping")
            return
        if self.dark is None:
            self.dark = (iface.get_string("color-scheme"), iface.get_string("gtk-theme"))
        if nl and self.night_light is None:
            self.night_light = nl.get_boolean(NIGHT_LIGHT[1])
        # Dark style is Umoja's default, so always show dark -> light: start
        # from dark style with Night Light off (all put back at the end).
        if iface.get_string("color-scheme") != "prefer-dark":
            iface.set_string("color-scheme", "prefer-dark")
            theme = iface.get_string("gtk-theme")
            if theme.startswith("Yaru") and not theme.endswith("-dark"):
                iface.set_string("gtk-theme", theme + "-dark")
        if nl:
            nl.set_boolean(NIGHT_LIGHT[1], False)
        Gio.Settings.sync()
        self.wait(1.5)
        # Light style last: its row gets the answer's Undo button, and the
        # style (unlike Night Light's tint) shows in a recording.
        q = "Turn on Night Light and switch to light style"
        self.ask("ai-settings", q, "Settings in plain words: Night Light and light style in one ask, "
                 "and Undo puts the style back.", expect_steps=2, keep_open=True,
                 then=lambda: self.press_undo(iface))
        self.bus.call(OVERLAY, "Hide")
        self.wait(0.8)
        self.scrub_overlay()
        # The rest of the tour in the usual style, without Night Light's tint.
        self.restore_style()
        self.wait(1.5)

    def press_undo(self, iface):
        """Press the answer's Undo button (the last change: light style) and
        let the desktop go dark again on camera."""
        if self.dry:
            log("  press Undo")
            return
        if not self.bus.has_method(OVERLAY, "TestAction"):
            log("  this overlay has no Undo button hook (TestAction), no undo shown")
            return
        self.wait(1.0)
        self.demo_flag(True)
        try:
            ok, _label = self.test_action("undo")
        finally:
            self.demo_flag(False)
        if not ok:
            log("  ! no Undo button to press")
            return
        for _ in range(16):
            if iface.get_string("color-scheme") == "prefer-dark":
                break
            self.wait(0.5)
        else:
            log("  ! Undo didn't put the dark style back (it may have undone Night Light)")
        self.wait(2.0)
        self.shot("ai-settings-undo", "Every change the assistant makes has an Undo button.")

    def test_action(self, name):
        """org.umoja.Overlay.TestAction: press a button the rows don't cover.
        Only answers while the demo flag file exists."""
        res = self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", (name,)), "(bs)")
        return res if res else (False, "")

    def ask_rows(self):
        res = self.bus.call(OVERLAY, "AskRows", None, "(a(sss))", quiet=True)
        return res[0] if res else []

    def ask_row(self, kind=None, title_has=None):
        """The index of the first Ask Umoja row of `kind` whose title has
        `title_has`, or None."""
        for i, (k, title, _sub) in enumerate(self.ask_rows()):
            if (kind is None or k == kind) and (title_has is None or title_has.lower() in title.lower()):
                return i
        return None

    def wait_row(self, kind=None, title_has=None, seconds=6):
        """Wait for an Ask Umoja row (see ask_row); its index, or None."""
        found = self.wait_for(lambda: (lambda r: None if r is None else (r,))(self.ask_row(kind, title_has)),
                              seconds)
        return found[0] if found else None

    def wait_for(self, check, seconds):
        """Wait until check() returns something true (checked every 0.25 s);
        returns it, or None after `seconds`."""
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            got = check()
            if got:
                return got
            self.wait(0.25)
        return None

    def restore_style(self):
        """Put style and Night Light back as they were before ai-settings."""
        if self.night_light is not None:
            nl = settings(NIGHT_LIGHT[0])
            nl.set_boolean(NIGHT_LIGHT[1], self.night_light)
            Gio.Settings.sync()
        if self.dark is not None:
            s = settings("org.gnome.desktop.interface")
            s.set_string("color-scheme", self.dark[0])
            s.set_string("gtk-theme", self.dark[1])
            Gio.Settings.sync()

    # While this file exists the overlay lets AnswerConfirm press Allow.
    def demo_flag(self, on):
        if self.dry:
            return
        flag = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "umoja-demo"
        if on:
            flag.touch()
        else:
            flag.unlink(missing_ok=True)

    @staticmethod
    def btop_source():
        """"snap", "deb" or None: how btop is installed now."""
        if subprocess.run(["snap", "list", "btop"], capture_output=True).returncode == 0:
            return "snap"
        r = subprocess.run(["dpkg-query", "-W", "-f", "${Status}", "btop"], capture_output=True, text=True)
        if r.returncode == 0 and "install ok installed" in r.stdout:
            return "deb"
        return None

    @staticmethod
    def btop_pids():
        r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "btop"], capture_output=True, text=True)
        return {int(p) for p in r.stdout.split()}

    def scene_ai_btop(self):
        """Type "btop" in Ask Umoja: it isn't installed, so Umoja offers to
        install it (snap first), then to run it in a terminal. Both prompts
        are allowed, so this one really installs btop; it is removed again
        afterwards (sudo -n) so the next run can film it again."""
        if not self.dry:
            if not self.can_ask_with or not self.bus.has_method(OVERLAY, "AnswerConfirm"):
                log("  this overlay can't answer prompts for the demo (AnswerConfirm), skipping")
                return
            if self.btop_source():
                log("  btop is already installed; remove it (sudo snap remove btop) to film this scene")
                return
        self.editor_to_front()
        self.check_screen()
        before = {w[0] for w in self.windows()} if not self.dry else set()
        pids_before = self.btop_pids() if not self.dry else set()
        self.demo_flag(True)
        self.events.clear()
        self.recorder.start("ai-btop")
        log("  ask  'btop'")
        flags = (1 if self.opts.local else 0) | (0 if self.opts.no_typing else 2)
        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", ("btop", flags)))
        acted = time.monotonic() + self.typing_time("btop")  # when it was last our move
        if self.dry:
            self.wait(self.opts.answer_wait)
            self.recorder.stop("btop")
            self.demo_flag(False)
            return
        seen = 0          # events looked at so far
        allowed = []      # confirmation labels allowed
        replies = 0
        ran = False
        # Installing takes a while, so allow longer than for an answer.
        deadline = time.monotonic() + self.opts.answer_timeout * 4
        try:
            while not ran and time.monotonic() < deadline:
                self.until = lambda: len(self.events) > seen
                try:
                    self.wait(max(1.0, deadline - time.monotonic()))
                finally:
                    self.until = None
                new, seen = self.events[seen:], len(self.events)
                for name, params, when in new:
                    self.recorder.waited(acted, when)
                    if name == "ConfirmShown":
                        label = params[0]
                        running = "terminal" in label.lower()
                        self.wait(1.4)
                        self.shot(f"ai-btop-{len(allowed) + 1}",
                                  "Installed. Now it offers to run btop in your terminal." if running else
                                  "“btop” isn't installed, so Umoja offers to install it: the snap "
                                  "first, the Ubuntu package when there's no snap.")
                        self.wait(0.6)
                        self.bus.call(OVERLAY, "AnswerConfirm", GLib.Variant("(b)", (True,)))
                        acted = time.monotonic()
                        allowed.append(label)
                        log(f"       allowed: {label}")
                    elif name == "AnswerFinished":
                        answer, steps = params
                        if any("terminal" in a.lower() for a in allowed):
                            ran = True
                        elif answer.strip().endswith("?") and replies < 2:
                            # It asked first ("Shall I install it?"): say yes.
                            replies += 1
                            self.wait(1.0)
                            self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", ("Yes", flags)))
                            acted = time.monotonic() + self.typing_time("Yes")
                        else:
                            log(f"  ! it stopped before running btop: {answer[:160]!r} {steps}")
                            deadline = 0
            if not ran:
                log("  ! btop wasn't installed and run, leaving ai-btop out")
                self.recorder.discard()
                return
            # The terminal running btop.
            for _ in range(20):
                if self.btop_pids() - pids_before:
                    break
                self.wait(0.5)
            self.wait(3.5)
            self.shot("ai-btop-running", "btop running in your terminal: one word typed, two prompts allowed.")
            self.wait(1.0)
            self.recorder.stop("Type “btop”: Umoja installs it (snap first) and runs it in a terminal, "
                               "asking before each step.")
        finally:
            self.demo_flag(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            # Quit only the btop this scene started, then close its window.
            for pid in self.btop_pids() - pids_before:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
            self.wait(1.5)
            for w in self.windows():
                if w[0] not in before:
                    self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (w[0],)), quiet=True)
            self.remove_btop()
            self.wait(0.8)
            self.scrub_overlay()

    def remove_btop(self):
        """Take out the btop this scene installed, off camera, so the next
        run films the install again. Needs passwordless sudo; else says so."""
        src = self.btop_source()
        if not src:
            return
        cmd = (["sudo", "-n", "snap", "remove", "btop"] if src == "snap"
               else ["sudo", "-n", "apt-get", "remove", "-y", "btop"])
        if subprocess.run(cmd, capture_output=True).returncode == 0:
            log(f"  removed the {src} of btop again")
        else:
            log(f"  btop ({src}) stays installed; remove it to film this scene again")

    def tiles(self):
        rows = self.bus.call(COMPOSITOR, "GetWindowTiles", None, "(a(tu))", quiet=True)
        return dict(rows[0]) if rows else {}

    def scene_ai_setups(self):
        """Save the two tiled windows as a setup by asking, scatter them, then
        bring the setup back from Ask Umoja's rows (no model)."""
        if not self.dry:
            for target, method in ((OVERLAY, "AskRows"), (OVERLAY, "AskActivate"),
                                   (COMPOSITOR, "GetWindowTiles")):
                if not self.bus.has_method(target, method):
                    log(f"  no {method} (install newer debs), skipping")
                    return
            if len(self.opened) < 2:
                log("  needs two of the demo's windows, skipping")
                return
        a, b = self.opened[:2] if not self.dry else (1, 2)
        self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (a, TILE_LEFT)))
        self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (b, TILE_RIGHT)))
        self.wait(1.5)
        path = Path(GLib.get_user_config_dir()) / "umoja" / "setups.json"
        before = path.read_text() if path.exists() else None
        caption = (f"“Save this layout as my {SETUP_NAME} setup”, then later just type “{SETUP_NAME.lower()}” "
                   "and pick it: every window goes back in its place.")
        self.recorder.start("ai-setups")
        try:
            log(f"  ask  'Save this window layout as my {SETUP_NAME} setup'")
            if self.ask_once(f"Save this window layout as my {SETUP_NAME} setup",
                             expect=(SETUP_NAME, "setup", "saved")) is None:
                self.recorder.discard()
                return
            self.wait(1.5)
            self.shot("ai-setups-saved", f"Saved as the {SETUP_NAME} setup.")
            self.bus.call(OVERLAY, "Hide")
            self.wait(0.8)
            # Mess the desk up: both windows back to floating, moved about.
            self.untile_demo_windows()
            self.wait(0.8)
            x, y, w, h = self.area
            if self.can_drag():
                self.drag(a, x + w // 2 + 120, y + int(h * 0.30), ms=500)
                self.drag(b, x + w // 2 - 160, y + int(h * 0.45), ms=500)
            self.wait(0.8)
            self.bus.call(OVERLAY, "ToggleAsk")
            self.wait(0.8)
            self.bus.call(OVERLAY, "AskType", GLib.Variant("(sb)", (SETUP_NAME.lower(), not self.opts.no_typing)))
            self.demo_flag(True)
            i = 0 if self.dry else self.wait_row(kind="Setup", title_has=SETUP_NAME)
            if i is None:
                log(f"  ! Ask Umoja offers no {SETUP_NAME} setup row: {self.ask_rows()}")
                self.recorder.discard()
                return
            self.wait(1.2)
            self.shot("ai-setups-row", f"Typing “{SETUP_NAME.lower()}” offers the setup.")
            if not self.dry:
                self.bus.call(OVERLAY, "AskActivate", GLib.Variant("(u)", (i,)), "(b)")
                back = self.wait_for(lambda: self.tiles().get(a) == TILE_LEFT and self.tiles().get(b) == TILE_RIGHT, 12)
                if not back:
                    log(f"  ! the setup didn't put the windows back: {self.tiles()}")
            self.wait(1.5)
            self.shot("ai-setups", "The setup back, each window in its half.")
            self.recorder.stop(caption)
        finally:
            self.demo_flag(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            if not self.dry:
                if before is None:
                    path.unlink(missing_ok=True)
                else:
                    path.write_text(before)
            self.wait(0.8)
            self.untile_demo_windows()
            self.wait(0.8)
            for wid in (a, b):
                spot = self.spots.get(wid)
                if spot:
                    self.drag(wid, *spot, ms=450)
            self.editor_to_front()
            self.scrub_overlay()

    def ask_once(self, question, step_has=None, expect=()):
        """Ask the assistant inside a clip that is already recording (one try,
        no shots): (answer, steps), or None (logged)."""
        self.events.clear()
        asked = time.monotonic() + self.typing_time(question)
        flags = (1 if self.opts.local else 0) | (0 if self.opts.no_typing else 2)
        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (question, flags)))
        if self.dry:
            self.wait(self.opts.answer_wait)
            return ("", [])
        self.until = lambda: any(e[0] in ("AnswerFinished", "ConfirmShown") for e in self.events)
        try:
            self.wait(self.opts.answer_timeout)
        finally:
            self.until = None
        came = next((e[2] for e in self.events if e[0] in ("AnswerFinished", "ConfirmShown")), None)
        if came:
            self.recorder.waited(asked, came)
        return self.check_answer(expect, False, 0, step_has)

    def scene_ai_rewrite(self):
        """A hasty note in a scratch window: select it, Super+Shift+A, Make It
        More Formal, Replace. Umoja types the new text over the selection."""
        if not self.dry:
            for method in ("AskAboutScreen", "AskRows", "AskActivate", "TestAction"):
                if not self.bus.has_method(OVERLAY, method):
                    log(f"  no Overlay.{method} (install newer debs), skipping")
                    return
            if not TESTPAD.exists():
                log(f"  {TESTPAD} is missing (run from a checkout), skipping")
                return
        out = (self.raw_dir / "rewrite.txt")
        pad = None
        before = {w[0] for w in self.windows()} if not self.dry else set()
        try:
            if self.dry:
                log(f"  open {TESTPAD.name}, type a note and select it")
            else:
                pad = subprocess.Popen([sys.executable, str(TESTPAD), str(out)], stdin=subprocess.PIPE,
                                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                if pad.stdout.readline().strip() != "ready":
                    log("  ! the scratch window didn't start (needs gir1.2-gtk-4.0), skipping")
                    return

                def cmd(*words):
                    pad.stdin.write(" ".join(words) + "\n")
                    pad.stdin.flush()
                    pad.stdout.readline()

                cmd("title", "Note to Priya")
                cmd("font", "18")
                wid = self.wait_for_window(before)
                if wid is None:
                    return
                x, y, w, h = self.area
                self.drag(wid, x + w // 2, y + int(h * 0.22), ms=450)
                cmd("text", REWRITE_TEXT)
                cmd("select")
                self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (wid,)), quiet=True)
                self.wait(1.0)
            self.demo_flag(True)
            caption = ("Select text in any app, press Super+Shift+A and pick a rewrite: "
                       "Replace types it over your selection.")
            self.recorder.start("ai-rewrite")
            self.wait(1.0)
            self.bus.call(OVERLAY, "AskAboutScreen")
            self.wait(1.5)
            i = 0 if self.dry else self.wait_row(kind="Rewrite", title_has="Formal")
            if i is None:
                log(f"  ! no Make It More Formal row: {self.ask_rows()}")
                self.recorder.discard()
                return
            self.wait(1.0)
            self.shot("ai-rewrite-rows", "Selected text gets rewrite rows: fix it, shorter, friendlier, "
                      "more formal, translate.")
            if not self.dry:
                self.bus.call(OVERLAY, "AskActivate", GLib.Variant("(u)", (i,)), "(b)")
                started = time.monotonic()
                state = {"last": "", "stable": 0}

                def finished():
                    _ok, ans = self.test_action("answer")
                    if ans and ans == state["last"]:
                        state["stable"] += 1
                    else:
                        state["stable"], state["last"] = 0, ans
                    return ans if state["stable"] >= 6 else None

                answer = self.wait_for(finished, self.opts.answer_timeout)
                if not answer:
                    log("  ! the rewrite didn't finish")
                    self.recorder.discard()
                    return
                self.recorder.waited(started, time.monotonic())
                log(f"       rewrite: {answer[:160]!r}")
            self.wait(1.5)
            self.shot("ai-rewrite", "The rewrite, with Replace the Selection.")
            if not self.dry:
                ok, _ = self.test_action("replace")
                if not ok:
                    log("  ! no Replace button")
                    self.recorder.discard()
                    return
                # Typing it out takes a moment: wait for the text to settle.
                state = {"last": None, "since": time.monotonic()}

                def settled():
                    try:
                        now = out.read_text()
                    except OSError:
                        now = None
                    if now != state["last"]:
                        state["last"], state["since"] = now, time.monotonic()
                        return None
                    return now if now and now != REWRITE_TEXT and time.monotonic() - state["since"] > 1.5 else None

                if not self.wait_for(settled, 30):
                    log("  ! the note wasn't replaced")
            self.wait(2.0)
            self.shot("ai-rewrite-replaced", "Replaced in the app itself.")
            self.recorder.stop(caption)
        finally:
            self.demo_flag(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            if pad:
                try:
                    pad.stdin.write("quit\n")
                    pad.stdin.flush()
                    pad.wait(timeout=5)
                except (OSError, subprocess.TimeoutExpired):
                    pad.kill()
            out.unlink(missing_ok=True)
            self.wait(0.8)
            self.editor_to_front()
            self.scrub_overlay()

    def scene_ai_captions(self):
        """Live captions of whatever is playing: here Umoja's own voice
        (Piper, Read Aloud) reads a short update, the captions follow it,
        and Summarize hands the transcript to the assistant."""
        if not self.dry:
            for method in ("ToggleCaptions", "Speak", "TestAction"):
                if not self.bus.has_method(OVERLAY, method):
                    log(f"  no Overlay.{method} (install newer debs), skipping")
                    return
            if not shutil.which("parec"):
                log("  captions need parec (pulseaudio-utils), skipping")
                return
        caption = ("Live captions of anything playing, here Umoja's own read-aloud voice; "
                   "Summarize hands the transcript to the assistant.")

        def caught():
            _on, text = self.test_action("captions-text")
            t = text.lower()
            return text if sum(w in t for w in CAPTION_WORDS) >= 4 else None

        self.demo_flag(True)
        try:
            self.warm_up_captions()
            for attempt in range(1, (1 if self.dry else 2) + 1):
                self.check_screen()
                self.recorder.start("ai-captions")
                self.bus.call(OVERLAY, "ToggleCaptions")
                if not self.dry and not self.wait_for(lambda: self.test_action("captions-text")[0], 5):
                    log("  ! captions didn't turn on")
                    self.recorder.discard()
                    return
                self.wait(1.0)
                # Nothing here is fast-forwarded: the captions trail the
                # voice by a few seconds, so a fast-forward up to the first
                # caption cut (silenced) the start of the reading.
                self.bus.call(OVERLAY, "Speak", GLib.Variant("(s)", (CAPTIONED,)))
                # The reading takes ~10 s.
                heard = None if self.dry else self.wait_for(caught, 40)
                if self.dry:
                    self.wait(12)
                if heard or self.dry:
                    break
                log(f"  ! the captions didn't catch the reading (try {attempt}): "
                    f"{self.test_action('captions-text')[1]!r}")
                self.bus.call(OVERLAY, "StopSpeaking", quiet=True)
                self.bus.call(OVERLAY, "ToggleCaptions")
                self.recorder.discard()
                self.wait(2.0)
            else:
                return
            self.wait(4.0)  # the rest of the sentence
            self.shot("ai-captions", "Live captions, as it talks.")
            self.events.clear()
            pressed = time.monotonic()
            ok, _ = (True, "") if self.dry else self.test_action("captions-summarize")
            if ok and not self.dry:
                self.until = lambda: any(e[0] == "AnswerFinished" for e in self.events)
                try:
                    self.wait(self.opts.answer_timeout)
                finally:
                    self.until = None
                done = next((e for e in self.events if e[0] == "AnswerFinished"), None)
                if done:
                    self.recorder.waited(pressed, done[2])
                    log(f"       summary: {done[1][0][:160]!r}")
            self.wait(1.5)
            self.shot("ai-captions-summary", "Summarize: what was said, in a line or two.")
            self.recorder.stop(caption)
        finally:
            self.bus.call(OVERLAY, "StopSpeaking", quiet=True)
            if self.dry or self.test_action("captions-text")[0]:
                self.bus.call(OVERLAY, "ToggleCaptions", quiet=True)
            self.demo_flag(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.8)
            self.scrub_overlay()

    def warm_up_captions(self):
        """Off camera, load Umoja's voice and the captions' speech model:
        the first reading of a session spent ~20 s on "Listening…" while
        they loaded, the dullest stretch of the trailer."""
        if self.dry:
            return
        log("  warming up the voice and the captions")
        self.bus.call(OVERLAY, "ToggleCaptions")
        if not self.wait_for(lambda: self.test_action("captions-text")[0], 5):
            return
        try:
            self.wait(0.5)
            self.bus.call(OVERLAY, "Speak", GLib.Variant("(s)", ("Getting ready for the tour.",)))
            if not self.wait_for(lambda: self.test_action("captions-text")[1].strip(), 60):
                log("  ! the captions heard nothing while warming up")
            self.wait_for(lambda: not self.test_action("read-aloud-state")[0], 15)
        finally:
            self.bus.call(OVERLAY, "StopSpeaking", quiet=True)
            if self.test_action("captions-text")[0]:
                self.bus.call(OVERLAY, "ToggleCaptions", quiet=True)
            self.wait(1.0)

    @staticmethod
    def opencode_installed():
        return bool(shutil.which("opencode") or Path("/snap/bin/opencode").exists())

    @staticmethod
    def opencode_on_cloud():
        """Whether umoja-agent-setup gave OpenCode the assistant's cloud model."""
        try:
            conf = json.loads((Path(GLib.get_user_config_dir()) / "opencode" / "opencode.json").read_text())
        except (OSError, ValueError):
            return False
        return "umoja" in (conf.get("provider") or {})

    def confirm_loop(self, question, done, seconds, shot=None):
        """Ask, then allow every "Allow Umoja to do this?" prompt (and say yes
        to a yes/no question) until done() is true. `shot(n, label)` films
        each prompt. Returns whether done() came true."""
        flags = (1 if self.opts.local else 0) | (0 if self.opts.no_typing else 2)
        self.events.clear()
        log(f"  ask  {question!r}")
        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (question, flags)))
        acted = time.monotonic() + self.typing_time(question)
        if self.dry:
            self.wait(self.opts.answer_wait)
            return True
        seen, allowed, replies = 0, 0, 0
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            self.until = lambda: len(self.events) > seen or done()
            try:
                self.wait(min(2.0, max(0.1, deadline - time.monotonic())))
            finally:
                self.until = None
            if done():
                self.recorder.waited(acted, time.monotonic())
                return True
            new, seen = self.events[seen:], len(self.events)
            for name, params, when in new:
                self.recorder.waited(acted, when)
                if name == "ConfirmShown":
                    allowed += 1
                    self.wait(1.4)
                    if shot:
                        shot(allowed, params[0])
                    self.wait(0.6)
                    self.bus.call(OVERLAY, "AnswerConfirm", GLib.Variant("(b)", (True,)))
                    acted = time.monotonic()
                    log(f"       allowed: {params[0]}")
                elif name == "AnswerFinished":
                    answer, _steps = params
                    if answer.strip().endswith("?") and replies < 2:
                        replies += 1
                        self.wait(1.0)
                        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", ("Yes", flags)))
                        acted = time.monotonic() + self.typing_time("Yes")
                    else:
                        log(f"       answer: {answer[:160]!r}")
        return done()

    def make_default_agent(self):
        """In Ask Umoja's settings, pick OpenCode as the Coding agent, on
        camera, so the coding job goes to it without naming it. The setting
        is put back at the end of the tour."""
        s = settings("org.umoja.shell")
        if not self.dry and (not s or "ai-agent" not in s.props.settings_schema.list_keys()):
            log("  no ai-agent setting, so OpenCode stays whatever the default is")
            return
        if not self.dry and self.agent_before is None:
            self.agent_before = s.get_string("ai-agent")
            # Start from another pick so the change shows.
            s.set_string("ai-agent", "claude")
            Gio.Settings.sync()
        self.bus.call(OVERLAY, "ToggleAsk")
        self.wait(1.0)
        ok, _ = (True, "") if self.dry else self.test_action("settings-open")
        if not ok:
            log("  ! couldn't open Ask Umoja's settings (needs newer debs); setting the agent directly")
            if s:
                s.set_string("ai-agent", "opencode")
                Gio.Settings.sync()
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.8)
            return
        self.wait(1.5)
        if not self.dry and not self.test_action("agent-pick:opencode")[0]:
            log("  ! OpenCode isn't in the Coding agent list; setting it directly")
            s.set_string("ai-agent", "opencode")
            Gio.Settings.sync()
        self.wait(1.8)
        self.shot("ai-opencode-default", "Ask Umoja's settings: OpenCode is now the coding agent, "
                  "so coding jobs go to it.")
        self.wait(0.6)
        self.test_action("settings-close")
        self.wait(0.6)
        self.bus.call(OVERLAY, "Hide", quiet=True)
        self.wait(0.8)

    def scene_ai_opencode(self):
        """The coding agent, all from Ask Umoja: install OpenCode (it comes
        set up on the assistant's cloud model, no sign-in), then hand it a
        job: a hello world GTK app in Rust. Nothing is built; the clip ends
        on the code in Text Editor."""
        projects = (self.demo_dir or Path.home() / DEMO_DIR_NAME) / "Projects"
        if not self.dry:
            if not self.can_ask_with or not self.bus.has_method(OVERLAY, "AnswerConfirm"):
                log("  this overlay can't answer prompts for the demo (AnswerConfirm), skipping")
                return
            if not self.demo_dir:
                log(f"  needs the tour's own folder (~/{DEMO_DIR_NAME} made by this run), skipping")
                return
            s = settings("org.umoja.shell")
            if not s or s.get_string("assistant-backend") != "cloud":
                log("  the assistant isn't on a cloud model, so OpenCode would need a sign-in, skipping")
                return
            if self.opencode_installed() and self.opts.reinstall_agent:
                if subprocess.run(["sudo", "-n", "snap", "remove", "opencode"], capture_output=True).returncode == 0:
                    log("  removed OpenCode first, to film its install")
        install = not self.opencode_installed() or self.dry
        if not install:
            log("  OpenCode is already installed: filming the coding job only (--reinstall-agent films the install)")
        project = projects / OPENCODE_PROJECT
        main_rs = project / "src" / "main.rs"
        if not self.dry:
            if project.exists():
                shutil.rmtree(project, ignore_errors=True)
            projects.mkdir(parents=True, exist_ok=True)
            (projects / "opencode.json").write_text(json.dumps(OPENCODE_RULES, indent=2) + "\n")
        before = {w[0] for w in self.windows()} if not self.dry else set()
        caption = ("“Install OpenCode”, make it the coding agent, then “write an app in Rust”: "
                   "OpenCode comes set up on your model and writes the project." if install else
                   "Make OpenCode the coding agent, then just ask: “write an app in Rust”. "
                   "It runs on your model, with Umoja's tools, and writes the project.")
        self.editor_to_front()
        self.demo_flag(True)
        self.recorder.start("ai-opencode")
        try:
            if install:
                def install_shot(n, label):
                    if n == 1:
                        self.shot("ai-opencode-install", "OpenCode isn't installed: Umoja offers its snap, "
                                  "and connects it to your desktop and your model.")

                ok = self.confirm_loop(
                    "Install OpenCode", lambda: self.opencode_installed() and self.opencode_on_cloud(),
                    self.opts.answer_timeout * 5, install_shot)
                if not ok:
                    log("  ! OpenCode wasn't installed and set up, leaving ai-opencode out")
                    self.recorder.discard()
                    return
                self.wait(3.0)  # the terminal's last lines
                self.shot("ai-opencode-installed", "Installed, connected to Umoja's tools and signed in "
                          "with the assistant's cloud model.")
                # Close the install terminal ("Press Enter to close").
                for w in self.windows():
                    if w[0] not in before:
                        self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (w[0],)), quiet=True)
                self.bus.call(OVERLAY, "Hide", quiet=True)
                self.wait(1.2)
                before = {w[0] for w in self.windows()} if not self.dry else set()
            self.scrub_overlay()
            self.make_default_agent()

            def written():
                try:
                    return "gtk" in main_rs.read_text().lower() and (project / "Cargo.toml").exists()
                except OSError:
                    return False

            # OpenCode isn't named: it is the default coding agent now. The
            # full path: the agent starts in that folder, where its rules
            # file is (a folder it can't find means the home folder).
            task = (f"Write an app in Rust: a hello world GTK 4 window, in a new project called "
                    f"{OPENCODE_PROJECT} in {projects}. Don't compile it.")
            ok = self.confirm_loop(task, written, self.opts.answer_timeout * 6)
            if not ok:
                log(f"  ! OpenCode didn't write {main_rs}, leaving ai-opencode out "
                    f"(look for a stray ~/{OPENCODE_PROJECT})")
                self.recorder.discard()
                return
            # Let it finish writing (and say what it did) before the shot.
            state = {"last": None, "since": time.monotonic()}

            def settled():
                if self.dry:
                    return True
                files = sorted((str(p), p.stat().st_size) for p in project.rglob("*") if p.is_file()) \
                    if not self.dry else []
                if files != state["last"]:
                    state["last"], state["since"] = files, time.monotonic()
                return time.monotonic() - state["since"] > 8
            t0 = time.monotonic()
            self.wait_for(settled, 90)
            self.recorder.waited(t0, time.monotonic())
            self.shot("ai-opencode-agent", "OpenCode at work in a terminal, on the assistant's model.")
            # The code, in Text Editor.
            if not self.dry:
                try:
                    DesktopAppInfo.new("org.gnome.TextEditor.desktop").launch_uris(
                        [Gio.File.new_for_path(str(main_rs)).get_uri()], None)
                except (GLib.Error, TypeError, AttributeError) as e:
                    log(f"  ! couldn't open {main_rs.name} in Text Editor: {e}")
            self.wait(2.5)
            self.editor_to_front()
            self.wait(1.5)
            self.shot("ai-opencode", f"{OPENCODE_PROJECT}/src/main.rs: a GTK 4 window saying Hello, World.")
            self.recorder.stop(caption)
        finally:
            self.demo_flag(False)
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.8)
            # The agent's terminal (and anything else this scene opened).
            for w in self.windows():
                if w[0] not in before and w[0] not in self.opened:
                    self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (w[0],)), quiet=True)
            self.wait(0.8)
            self.editor_to_front()
            self.scrub_overlay()

    # ---- the background agent (umoja-agents) ----------------------------

    def agent_state(self):
        if self.dry:
            return {"setup": "ready", "agent_name": "Hermes", "tasks": [], "approvals": []}
        res = self.bus.call(AGENTS, "GetState", None, "(s)", quiet=True)
        try:
            return json.loads(res[0]) if res else {}
        except ValueError:
            return {}

    def agent_ready(self):
        """The background agent is set up and running (Resume if paused)."""
        s = self.agent_state()
        if not s:
            log("  the background agent (umoja-agents) isn't running, skipping")
            return False
        if s.get("setup") != "ready":
            log("  the background agent isn't set up (Ask Umoja's settings, Background agent, Set Up), skipping")
            return False
        if s.get("paused"):
            log("  resuming the paused background agent")
            self.bus.call(AGENTS, "SetPaused", GLib.Variant("(b)", (False,)))
            deadline = time.monotonic() + 420
            while self.agent_state().get("switching") and time.monotonic() < deadline:
                time.sleep(2)
        return True

    def agent_name(self):
        return self.agent_state().get("agent_name") or "Hermes"

    def agent_task(self, tid):
        return next((t for t in self.agent_state().get("tasks", []) if t.get("id") == tid), None)

    def agent_menu(self, open_):
        """The Agents button's menu on the top bar (tasks and consent cards)."""
        if open_:
            self.close_panel_menus()
            self.bus.call(PANEL, "OpenMenu", GLib.Variant("(s)", ("agents",)), quiet=True)
            self.wait(1.2)
        else:
            self.close_panel_menus()
            self.wait(0.6)

    def close_panel_menus(self):
        """Closes whatever top-bar menu is open. (Unfocus alone left a menu
        opened by OpenMenu up, and the next one then couldn't open.)"""
        if self.dry or self.bus.has_method(PANEL, "CloseMenus"):
            self.bus.call(PANEL, "CloseMenus", quiet=True)
        else:
            self.bus.call(PANEL, "Unfocus", quiet=True)

    def hand_to_agent(self, prompt, shot=None, caption=None):
        """Types "@agent <prompt>" into Ask Umoja, the way a person hands a
        job over. Returns the new task's id, or None."""
        before = {t["id"] for t in self.agent_state().get("tasks", [])}
        text = f"@agent {prompt}"
        log(f"  hand over {prompt[:70]!r}...")
        if self.dry:
            self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (text, 2)))
            return "dry-task"
        flags = 0 if self.opts.no_typing else 2
        self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (text, flags)))
        new = self.wait_for(lambda: next((t["id"] for t in self.agent_state().get("tasks", [])
                                          if t["id"] not in before), None), self.typing_time(text) + 30)
        if new:
            self.wait(1.5)  # "Handed to Hermes" in the card
            if shot:
                self.shot(shot, caption or "Handed over from Ask Umoja.")
        self.bus.call(OVERLAY, "Hide", quiet=True)
        self.wait(0.6)
        return new

    def follow_agent(self, tid, name, allow=True, command_answer="deny", working_shot=True, timeout=None):
        """Watches a task to the end, like a person would glance at it:
        the Agents menu while it works, each consent card it raises (shot,
        then Allow, or Deny with allow=False), and the result. The waits in
        between are fast-forwarded in the clip. Returns the task, or None."""
        if self.dry:
            log(f"  follow {tid}")
            return {"id": tid, "status": "done", "files": ["/dry/run.md"], "result": ""}
        n = self.agent_name()
        timeout = timeout or self.opts.task_timeout
        end = time.monotonic() + timeout
        span = time.monotonic()
        shown_working = not working_shot
        started = time.monotonic()
        answered = set()
        while time.monotonic() < end:
            self.wait(1.0)
            s = self.agent_state()
            t = next((x for x in s.get("tasks", []) if x.get("id") == tid), None)
            if t is None:
                return None
            if t.get("status") in AGENT_DONE:
                self.recorder.waited(span, time.monotonic())
                return t
            for a in s.get("approvals", []):
                if a["id"] in answered or a.get("task") not in ("", tid):
                    continue
                answered.add(a["id"])
                self.recorder.waited(span, time.monotonic())
                kind = a.get("kind")
                self.agent_menu(True)
                tag = "" if len(answered) == 1 else f"-{len(answered)}"
                if kind == "network":
                    self.shot(f"{name}-consent{tag}",
                              f"{n} wants to reach {a.get('host')}: it can't until you say so.")
                    choice = "allow" if allow else "deny"
                elif kind == "command":
                    self.shot(f"{name}-command{tag}", f"{n} asks before running a risky command.")
                    choice = command_answer
                else:
                    self.shot(f"{name}-question{tag}", f"{n} has a question.")
                    choice = None
                self.wait(1.2)
                if choice:
                    log(f"  {choice}: {a.get('title')}")
                    self.bus.call(AGENTS, "Answer", GLib.Variant("(ss)", (a["id"], choice)), quiet=True)
                else:
                    self.bus.call(AGENTS, "Reply", GLib.Variant("(ss)", (a["id"], "Use your best judgement.")),
                                  quiet=True)
                self.wait(1.5)
                self.agent_menu(False)
                span = time.monotonic()
            if not shown_working and time.monotonic() - started > 6 and t.get("status") == "running":
                shown_working = True
                self.recorder.waited(span, time.monotonic())
                self.agent_menu(True)
                self.wait(0.8)
                self.shot(f"{name}-working", f"{n} works in the background: the Agents button shows what it's doing.")
                self.wait(1.5)
                self.agent_menu(False)
                span = time.monotonic()
        log(f"  ! {tid} didn't finish in {timeout:.0f} s")
        return None

    def show_agent_answer(self, tid, name, caption, scroll_to=None, hold=2.5):
        """The finished job in Ask Umoja, as its notification's Open shows
        it: the whole answer, a button for its file, and a reply box.
        `scroll_to` (0.0 top .. 1.0 end) glides down to the part the caption
        is about."""
        self.bus.call(OVERLAY, "ShowAgentTask", GLib.Variant("(s)", (tid,)), quiet=True)
        self.wait(2.5)
        if scroll_to is not None:
            self.demo_flag(True)  # TestAction only answers during a demo
            try:
                self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", (f"answer-scroll:{scroll_to}",)), "(bs)",
                              quiet=True)
            finally:
                self.demo_flag(False)
            self.wait(1.5)
        self.wait(max(0.0, hold - 2.5))
        self.shot(name, caption)

    def reply_to_agent(self, tid, text, shot=None, caption=None):
        """Types `text` into the reply box under the answer on show and
        sends it: the agent carries on in the same conversation. Returns
        the follow-up task's id, or None."""
        log(f"  reply {text[:70]!r}...")
        if self.dry:
            self.bus.call(OVERLAY, "ReplyAgentTask", GLib.Variant("(s)", (text,)))
            return "dry-follow-up"
        before = {t["id"] for t in self.agent_state().get("tasks", [])}
        res = self.bus.call(OVERLAY, "ReplyAgentTask", GLib.Variant("(s)", (text,)), "(b)")
        if not res or not res[0]:
            log("  ! Ask Umoja had no answer waiting for a reply (needs newer debs)")
            return None
        new = self.wait_for(lambda: next((t["id"] for t in self.agent_state().get("tasks", [])
                                          if t["id"] not in before and t.get("parent") == tid), None),
                            self.typing_time(text) + 30)
        if new:
            self.wait(2.0)  # the card shows the agent working on it
            if shot:
                self.shot(shot, caption or "A reply carries on in the same conversation.")
        return new

    def open_agent_result(self, t, name, caption):
        """Opens the task's file (Agents.Open, as its notification's button
        does) and shoots it. Returns the window it opened, or None."""
        before = {w[0] for w in self.windows()} if not self.dry else set()
        self.bus.call(AGENTS, "Open", GLib.Variant("(s)", (t["id"],)), quiet=True)
        t0 = time.monotonic()
        new = None if self.dry else self.wait_for_window(before, timeout=10)
        # The wait for the viewer is fast-forwarded in the clip (it may
        # reuse a window and never show a new one, the whole 10 s).
        self.recorder.waited(t0, time.monotonic())
        self.wait(2.0)
        self.shot(name, caption)
        return new

    def scene_ai_agent(self):
        """The background agent, for a job that takes a while: "@agent plan
        a weekend in Lisbon" in Ask Umoja. It works in its sandbox, shows
        on the top bar and notifies when it's done; the plan opens in Ask
        Umoja, a reply refines it, and the file opens in the Markdown
        viewer."""
        if not self.agent_ready():
            return
        n = self.agent_name()
        caption = (f"Hand {n} a bigger job: “@agent plan a weekend in Lisbon”. It works in its own "
                   f"sandbox; then read the plan in Ask Umoja and reply to refine it.")
        # Hermes won't write over a file: an earlier take's plan would make
        # it describe the old one instead.
        ws = Path.home() / "Agents" / n
        earlier = ws / "Lisbon weekend.md"
        if earlier.exists() and not self.dry:
            old = ws / ".earlier demo runs" / time.strftime("%Y%m%d-%H%M%S")
            old.mkdir(parents=True, exist_ok=True)
            shutil.move(str(earlier), str(old / earlier.name))
            log(f"  moved an earlier {earlier.name} aside")
        self.recorder.start("ai-agent")
        opened = None
        try:
            tid = self.hand_to_agent(AGENT_TRIP, "ai-agent-handed",
                                     f"“@agent …” in Ask Umoja hands the job to {n}.")
            if not tid:
                log("  ! the hand-off didn't make a task, leaving ai-agent out")
                self.recorder.discard()
                return
            t = self.follow_agent(tid, "ai-agent")
            if not t or t.get("status") != "done" or not t.get("files"):
                log(f"  ! the task didn't finish with a file ({(t or {}).get('status')}: "
                    f"{(t or {}).get('result', '')[:120]!r}), leaving ai-agent out")
                self.recorder.discard()
                return
            self.wait(2.0)  # the "done" notification
            self.shot("ai-agent-done", f"Done: {n} says so, and the plan is in ~/Agents/{n}.")
            self.show_agent_answer(tid, "ai-agent-answer",
                                   "Open it: the whole plan in Ask Umoja, with a reply box under it.")
            last = t
            follow = self.reply_to_agent(tid, AGENT_TRIP_REPLY, "ai-agent-reply",
                                         f"Reply to refine it: {n} carries on from the same plan.")
            if follow:
                t2 = self.follow_agent(follow, "ai-agent-reply", working_shot=False)
                if t2 and t2.get("status") == "done":
                    last = t2
                    self.show_agent_answer(follow, "ai-agent-refined",
                                           "Refined: a rainy-day Saturday, same budget.")
                else:
                    log(f"  ! the follow-up didn't finish ({(t2 or {}).get('status')})")
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.wait(0.6)
            opened = self.open_agent_result(last, "ai-agent", "The weekend, planned, in the Markdown viewer.")
            self.wait(1.5)
            self.recorder.stop(caption)
        finally:
            self.agent_menu(False)
            if opened is not None:
                self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (opened,)), quiet=True)
                self.wait(0.8)
            self.scrub_overlay()

    def scene_ai_install(self):
