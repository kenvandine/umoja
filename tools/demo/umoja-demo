    HERO = ("ai-btop", "ai-opencode", "ai-agent", "ai-tiling", "ai-settings", "overview", "ai-install")
    LEAD = ("ai-btop", "ai-tiling", "ai-settings", "overview")
    TOOL = "tools/demo/umoja-demo"

    def __init__(self, opts):
        self.opts = opts
        self.dry = opts.dry_run
        self.bus = Bus(self.dry)
        self.out = opts.out
        self.img_dir = self.out / "images"
        self.vid_dir = self.out / "videos"
        self.raw_dir = self.out / ".raw"
        self.video = not opts.no_video
        self.output = None
        self.audio = None  # the monitor source the clips record sound from
        self.can_park = None
        self.area = None  # (x, y, w, h) of the captured monitor, layout pixels
        self.terminal = None  # the window we were started from, minimized
        self.terminal_name = ""
        self.dark = None  # (color-scheme, gtk-theme) before the style ask
        self.ready = False  # the assistant can be asked
        self.until = None  # wait() returns early once this says so
        self.events = []  # (signal, args, time.monotonic()) from org.umoja.Overlay
        self.night_light = None
        self.agent_before = None  # org.umoja.shell ai-agent before ai-opencode
        self.trailer = None
        self.can_ask_with = False
        self.demo_dir = None  # created by us, removed at the end
        self.spots = {}  # window id -> where its title bar sits when floating
        self.names = {}  # window id -> app name, for the assistant
        self.shots = {}  # scene -> [(file, caption)]
        self.layout = {}  # shot name -> screen_layout(), written to images/layout.json
        self.overlay_bounds = None  # whether the overlay answers TestAction "bounds"
        self.clips = []  # (raw webm, caption, scene, fast-forward spans)
        self.videos = {}  # scene -> [(gif or None, mp4/webm, caption)]
        self.scene = None
        self.opened = []  # window ids this tour opened
        self.notes = []
        self.inhibit_cookie = None
        self.start_workspace = None
        self.banners = None
        self.saver = None
        self.recorder = Recorder(self)

    # ---- safety -------------------------------------------------------

    def check_screen(self):
        """Never drive the desktop while the screen is blanked or locked."""
        res = self.bus.call(SCREENSAVER, "GetActive", None, "(b)", quiet=True)
        if res and res[0]:
            raise Stop("the screen is blanked")
        if self.bus.session_locked():
            raise Stop("the session is locked")

    def wait(self, seconds):
        """Sleep in small steps, checking the screen as we go."""
        if self.dry:
            return
        end = time.monotonic() + seconds * self.opts.pace
        ctx = GLib.MainContext.default()
        last_check = 0.0
        while True:
            # D-Bus signals (AnswerFinished...) are delivered here.
            while ctx.iteration(False):
                pass
            if self.until and self.until():
                return
            now = time.monotonic()
            if now >= end:
                return
            if now - last_check > 0.5:
                self.check_screen()
                last_check = now
            time.sleep(min(end - now, 0.05))

    # ---- capture ------------------------------------------------------

    def shot(self, name, caption):
        self.check_screen()
        path = self.img_dir / f"{name}.png"
        cmd = ["grim"]
        if not self.opts.hidpi:
            cmd += ["-s", "1"]  # logical size: keeps the PNGs README-sized
        if self.output:
            cmd += ["-o", self.output]
        cmd.append(str(path))
        if self.dry:
            log(f"  shot {' '.join(cmd)}")
        else:
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                log(f"  ! grim failed: {r.stderr.strip()}")
                return
            log(f"  shot {path.name}")
            self.layout[name] = self.screen_layout()
        self.shots.setdefault(self.scene, []).append((path, caption))

    def screen_layout(self):
        """Where things were for a shot, in the shot's pixels, so
        tools/guide/make-images can crop to them on any screen size: the
        monitor's size, the windows on it, and Ask Umoja's card and settings
        popover when they show (Overlay TestAction "bounds")."""
        x0, y0, w, h = self.area
        out = {"screen": [w, h], "windows": [], "regions": {}}
        for wid, app, title, x, y, ww, wh, flags in self.windows():
            if flags & 2 or not flags & 4:  # minimized, or on another workspace
                continue
            out["windows"].append({"app": app, "title": title, "demo": wid in self.opened,
                                   "rect": [x - x0, y - y0, ww, wh]})
        if self.overlay_bounds is None:
            self.overlay_bounds = self.bus.has_method(OVERLAY, "TestAction")
        if self.overlay_bounds:
            flag = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "umoja-demo"
            made = not flag.exists()
            if made:
                flag.touch()
            try:
                res = self.bus.call(OVERLAY, "TestAction", GLib.Variant("(s)", ("bounds",)), "(bs)", quiet=True)
            finally:
                if made:
                    flag.unlink(missing_ok=True)
            for line in (res[1] if res and res[0] else "").splitlines():
                parts = line.split()
                if len(parts) == 5:
                    try:
                        out["regions"][parts[0]] = [round(float(v)) for v in parts[1:]]
                    except ValueError:
                        pass
        return out

