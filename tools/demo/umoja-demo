def wrap_caption(text, limit=CAPTION_CHARS):
    """`text` on as few lines as fit `limit`, of about even length (no
    one-word last line)."""
    if len(text) <= limit:
        return text
    n = -(-len(text) // limit)
    width = -(-len(text) // n)
    while len(textwrap.wrap(text, width)) > n:
        width += 1
    return textwrap.fill(text, width)


def has_audio(path):
    """Whether the media file at `path` has a sound track."""
    r = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "a", "-show_entries",
                        "stream=index", "-of", "csv=p=0", str(path)], capture_output=True, text=True)
    return r.returncode == 0 and bool(r.stdout.strip())


def duration(path):
    """The length of the media file at `path` in seconds, or None."""
    r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                        "-of", "csv=p=0", str(path)], capture_output=True, text=True)
    try:
        return float(r.stdout.strip())
    except ValueError:
        return None


class Stop(Exception):
    """The tour can't go on (screen blanked/locked, session gone)."""


def settings(schema):
    """Gio.Settings for `schema`, or None (Gio aborts on an unknown schema)."""
    src = Gio.SettingsSchemaSource.get_default()
    if src is None or src.lookup(schema, True) is None:
        return None
    return Gio.Settings.new(schema)


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


class Bus:
    """Thin synchronous wrapper over the session bus (or a printer for --dry-run)."""

    def __init__(self, dry):
        self.dry = dry
        self.conn = None if dry else Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.system = None

    def call(self, target, method, args=None, reply=None, timeout=10_000, quiet=False):
        name, path, iface = target
        if self.dry:
            if not quiet:
                log(f"  dbus {iface}.{method}{'' if args is None else ' ' + str(args.unpack())}")
            return None
        try:
            res = self.conn.call_sync(
                name, path, iface, method, args,
                GLib.VariantType(reply) if reply else None,
                Gio.DBusCallFlags.NONE, timeout, None,
            )
        except GLib.Error as e:
            if not quiet:
                log(f"  ! {iface}.{method}: {e.message}")
            return None
        return res.unpack() if res is not None else None

    def has_method(self, target, method):
        if self.dry:
            return True
        name, path, iface = target
        try:
            res = self.conn.call_sync(
                name, path, "org.freedesktop.DBus.Introspectable", "Introspect",
                None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 5000, None,
            )
        except GLib.Error:
            return False
        info = Gio.DBusNodeInfo.new_for_xml(res.unpack()[0])
        i = info.lookup_interface(iface)
        return bool(i and i.lookup_method(method))

    def has_name(self, name):
        if self.dry:
            return True
        res = self.call(
            ("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus"),
            "NameHasOwner", GLib.Variant("(s)", (name,)), "(b)", quiet=True,
        )
        return bool(res and res[0])

    def session_locked(self):
        if self.dry:
            return False
        try:
            if self.system is None:
                self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            res = self.system.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", "LockedHint")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None,
            )
            return bool(res.unpack()[0])
        except GLib.Error:
            return False


class Recorder:
    """One wf-recorder clip at a time, on the primary monitor."""

    def __init__(self, demo):
        self.demo = demo
        self.proc = None
        self.path = None
        self.t0 = None
        self.fast = []  # (start, end) seconds into the clip to fast-forward

    def start(self, name):
        if not self.demo.video:
            return
        self.fast = []
        self.path = self.demo.raw_dir / f"{name}.webm"
        cmd = [
            # -D: a frame every refresh, not only on damage. Damage-only
            # capture held back the last change (ai-reply ended before
            # its drafts showed).
            "wf-recorder", "-y", "-D", "-c", "libvpx", "-x", "yuv420p",
            "-p", "deadline=realtime", "-p", "cpu-used=8", "-p", "b=16M",
            "-f", str(self.path),
        ]
        if self.demo.audio:
            # What the speakers play (the default output's monitor), as
            # Opus, which WebM can carry.
            cmd[1:1] = [f"--audio={self.demo.audio}", "-C", "libopus", "-R", str(AUDIO_RATE)]
        if self.demo.output:
            cmd[1:1] = ["-o", self.demo.output]
        if self.demo.dry:
            log(f"  rec  {' '.join(cmd)}")
            self.proc = True
            return
        self.proc = subprocess.Popen(
            cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=open(self.demo.raw_dir / f"{name}.log", "w"),
        )
        self.t0 = time.monotonic()
        time.sleep(1.0)  # wf-recorder needs a moment before the first frame
        if self.proc.poll() is not None:
            log(f"  ! wf-recorder exited at once (see {self.demo.raw_dir}/{name}.log)")
            self.proc = None

    def waited(self, start, end):
        """The viewer sat through start..end (time.monotonic()): fast-forward
        it in the clip if it is long. Trimmed a little at both ends so the
        moment things start and finish plays in real time."""
        if not self.proc or self.proc is True or self.t0 is None:
            return
        a, b = start - self.t0 + 0.8, end - self.t0 - 0.8
        if b - a >= FAST_MIN:
            self.fast.append((round(a, 2), round(b, 2)))

    def stop(self, caption):
        if not self.proc:
            return
        if self.demo.dry:
            log("  rec  stop")
        else:
            # wf-recorder drops the last second or so when stopped: keep
            # rolling so the clip really ends on the result.
            time.sleep(2.0)
            self.proc.send_signal(signal.SIGINT)  # finishes the file
            try:
                self.proc.wait(timeout=15)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.demo.clips.append((self.path, caption, self.demo.scene, self.fast))
        self.proc = None
        self.fast = []

    def discard(self):
        """Stop and throw away the clip (a failed try)."""
        path = self.path
        self.abort()
        if path and not self.demo.dry:
            path.unlink(missing_ok=True)

    def abort(self):
        if self.proc and self.proc is not True:
            self.proc.send_signal(signal.SIGINT)
            try:
                self.proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None


class Demo:
    """The tour. tools/demo/umoja-agent-demo subclasses it with its own
    scenes, titles and trailer cards."""

    SCENES = SCENES
    AI_SCENES = AI_SCENES
    OPT_IN = ()
    TRAILER = TRAILER
    TITLES = TITLES
    HEADING = "A tour of Umoja"
