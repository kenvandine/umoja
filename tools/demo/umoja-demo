    # ---- output -------------------------------------------------------

    def encode(self):
        """webm -> GIF (inline on GitHub) + MP4, after capture so it can't stutter."""
        for raw, caption, scene in self.clips:
            gif = self.vid_dir / f"{raw.stem}.gif"
            mp4 = self.vid_dir / f"{raw.stem}.mp4"
            if self.dry:
                self.videos.setdefault(scene, []).append((gif, mp4, caption))
                continue
            if not raw.exists() or raw.stat().st_size == 0:
                log(f"  ! {raw.name} is empty, dropping it")
                continue
            if not self.ffmpeg:
                dest = self.vid_dir / raw.name
                shutil.move(raw, dest)
                self.videos.setdefault(scene, []).append((None, dest, caption))
                continue
            log(f"  encode {raw.stem}")
            ok_mp4 = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(raw),
                "-vf", "scale='min(1920,iw)':-2,fps=30", "-c:v", "libx264", "-preset", "slow",
                "-crf", "26", "-pix_fmt", "yuv420p", "-movflags", "+faststart", "-an", str(mp4),
            ]).returncode == 0
            ok_gif = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(raw), "-vf",
                f"fps=12,scale={self.opts.gif_width}:-1:flags=lanczos,split[a][b];"
                "[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4",
                str(gif),
            ]).returncode == 0
            if not ok_mp4:
                mp4 = self.vid_dir / raw.name
                shutil.copy(raw, mp4)
            self.videos.setdefault(scene, []).append((gif if ok_gif else None, mp4, caption))

    def font(self):
        for pattern in ("Ubuntu Sans:bold", "Ubuntu:bold", "sans:bold"):
            r = subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip() and Path(r.stdout.strip()).exists():
                return r.stdout.strip()
        return None

    def make_trailer(self):
        """The trailer clips, captioned, after a title card: videos/trailer.mp4."""
        parts = [(m, c) for sc in TRAILER for _g, m, c in self.videos.get(sc, [])
                 if m and m.suffix == ".mp4"]
        if self.dry:
            log(f"  trailer from {len(parts)} clips")
            self.trailer = self.vid_dir / "trailer.mp4"
            return
        font = self.font()
        if not self.ffmpeg or not parts or not font:
            if parts and not font:
                log("  ! no font found for captions (fc-match), no trailer")
            return
        log(f"  trailer from {len(parts)} clips")
        _x, _y, w, h = self.area
        W = 1920
        H = int(round(W * h / w / 2) * 2)
        work = self.raw_dir / "trailer"
        work.mkdir(parents=True, exist_ok=True)
        # Ubuntu Sans is "UbuntuSans[wdth,wght].ttf": brackets and commas
        # break ffmpeg's filter syntax, so use a copy with a plain name.
        plain = work / ("font" + Path(font).suffix)
        shutil.copy(font, plain)
        font = str(plain)
        fit = (f"scale={W}:{H}:force_original_aspect_ratio=decrease,"
               f"pad={W}:{H}:(ow-iw)/2:(oh-ih)/2,fps=30,format=yuv420p")
        enc = ["-an", "-c:v", "libx264", "-preset", "veryfast", "-crf", "22", "-pix_fmt", "yuv420p"]
        ff = font.replace("\\", "\\\\").replace(":", "\\:").replace("'", "\\'")
        segs = []
        # Title card.
        (work / "t1.txt").write_text("Umoja")
        (work / "t2.txt").write_text("The desktop you can just talk to")
        card = work / "00-title.mp4"
        r = subprocess.run([
            "ffmpeg", "-loglevel", "error", "-y", "-f", "lavfi", "-i",
            f"color=c=0x2c001e:s={W}x{H}:d=2.5:r=30", "-vf",
            f"drawtext=expansion=none:fontfile={ff}:textfile={work / 't1.txt'}:fontsize=140:fontcolor=white:"
            f"x=(w-text_w)/2:y=(h-text_h)/2-60,"
            f"drawtext=expansion=none:fontfile={ff}:textfile={work / 't2.txt'}:fontsize=48:fontcolor=0xE95420:"
            f"x=(w-text_w)/2:y=(h/2)+70,format=yuv420p", *enc, str(card)])
        if r.returncode == 0:
            segs.append(card)
        for i, (mp4, caption) in enumerate(parts, 1):
            txt = work / f"{i:02d}.txt"
            txt.write_text(caption)
            out = work / f"{i:02d}.mp4"
            r = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(mp4), "-vf",
                f"{fit},drawtext=expansion=none:fontfile={ff}:textfile={txt}:fontsize=40:fontcolor=white:"
                f"box=1:boxcolor=black@0.6:boxborderw=22:x=(w-text_w)/2:y=h-text_h-70",
                *enc, str(out)])
            if r.returncode == 0:
                segs.append(out)
        if len(segs) < 2:
            log("  ! trailer encode failed")
            return
        lst = work / "list.txt"
        lst.write_text("".join(f"file '{p}'\n" for p in segs))
        dest = self.vid_dir / "trailer.mp4"
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "concat", "-safe", "0",
                            "-i", str(lst), "-c", "copy", "-movflags", "+faststart", str(dest)])
        if r.returncode == 0:
            self.trailer = dest

    def version(self):
        if self.dry:
            return "dry run"
        r = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "umoja-desktop"],
                           capture_output=True, text=True)
        return r.stdout.strip() or "unknown version"

    def rel(self, p):
        return os.path.relpath(p, self.out)

    def write_markdown(self):
        titles = {
            "desktop": "Desktop", "tiling": "Window tiling", "app-grid": "App grid and search",
            "overview": "Activities overview", "workspaces": "Workspaces",
            "quick-settings": "Quick Settings", "notifications": "Notifications",
            "shortcuts": "Keyboard shortcuts guide", "screenshot-ui": "Screenshot UI",
            "screensaver": "Screensaver",
            "ai-tiling": "Assistant: tile windows", "ai-settings": "Assistant: change settings",
            "ai-install": "Assistant: install an app", "ai-updates": "Assistant: software updates",
            "ai-reply": "Assistant: reply to a notification",
            "ai-troubleshoot": "Assistant: troubleshooting",
            "ai-summary": "Assistant: notification digest", "ai-custom": "Assistant",
        }
        today = datetime.date.today().isoformat()
        lines = [
            "# A tour of Umoja",
            "",
            f"Captured hands-free by `tools/demo/umoja-demo` on {today} "
            f"(umoja-desktop {self.version()}).",
            "",
        ]
        if self.trailer:
            lines += [f"**[Watch the trailer]({self.rel(self.trailer)})** "
                      f"(all the clips below in one video, real time).", ""]
        for scene in SCENES + ["ai-custom"]:
            shots = self.shots.get(scene, [])
            vids = self.videos.get(scene, [])
            if not shots and not vids:
                continue
            lines += [f"## {titles[scene]}", ""]
            for path, caption in shots:
                lines += [f"![{caption}]({self.rel(path)})", "", f"*{caption}*", ""]
            for gif, video, caption in vids:
                if gif:
                    lines += [f"[![{caption}]({self.rel(gif)})]({self.rel(video)})", "",
                              f"*{caption}* ([video]({self.rel(video)}))", ""]
                else:
                    lines += [f"[{caption} (video)]({self.rel(video)})", ""]
        if not self.dry:
            (self.out / "README.md").write_text("\n".join(lines))

        # A compact gallery for the top-level README (paths from the repo root).
        try:
            root = Path(__file__).resolve().parents[2]
            base = os.path.relpath(self.out.resolve(), root)
        except (IndexError, ValueError):
            base = str(self.out)
        if base.startswith(".."):
            base = str(self.out)
        hero = [s for s in ("ai-tiling", "ai-settings", "overview", "ai-install") if s in self.shots]
        snippet = ["## Screenshots", ""]
        lead = next((s for s in ("ai-tiling", "ai-settings", "overview")
                     if s in self.videos and self.videos[s][0][0]), None)
        if lead:
            gif, video, caption = self.videos[lead][0]
            target = self.trailer or video
            snippet += [f"[![{caption}]({base}/{self.rel(gif)})]({base}/{self.rel(target)})", ""]
        if self.trailer:
            snippet += [f"[Watch the trailer]({base}/{self.rel(self.trailer)}).", ""]
        cells = [self.shots[s][0] for s in hero]
        if cells:
            snippet += ["| " + " | ".join(titles[s] for s in hero) + " |",
                        "| " + " | ".join("---" for _ in hero) + " |",
                        "| " + " | ".join(f"![{titles[s]}]({base}/{self.rel(p)})"
                                          for s, (p, _c) in zip(hero, cells)) + " |", ""]
        snippet += [f"More in the [tour]({base}/README.md).", ""]
        if not self.dry:
            (self.out / "snippet.md").write_text("\n".join(snippet))
            files = [self.rel(p) for v in self.shots.values() for p, _ in v]
            files += [self.rel(p) for v in self.videos.values() for g, m, _ in v for p in (g, m) if p]
            if self.trailer:
                files.append(self.rel(self.trailer))
            files += ["README.md", "snippet.md"]
            (self.out / ".umoja-demo-files").write_text("\n".join(files) + "\n")
            shutil.rmtree(self.raw_dir, ignore_errors=True)
        else:
            log("README.md would be:\n" + "\n".join(lines))
            log("snippet.md would be:\n" + "\n".join(snippet))

    # ---- main ---------------------------------------------------------

    def trailer_only(self):
        """Rebuild videos/trailer.mp4 from an earlier run's clips and captions."""
        import re
        readme = self.out / "README.md"
        if not readme.exists():
            sys.exit(f"no {readme}: run the tour first")
        self.ffmpeg = bool(shutil.which("ffmpeg"))
        _conn, self.area = self.monitor()
        pat = re.compile(r"^\[!\[(?P<cap>.*)\]\((?P<gif>[^)]*)\)\]\((?P<mp4>[^)]*\.mp4)\)$")
        for line in readme.read_text().splitlines():
            m = pat.match(line.strip())
            if not m:
                continue
            mp4 = self.out / m["mp4"]
            if mp4.name == "trailer.mp4" or not mp4.exists():
                continue
            name = mp4.stem
            scene = next((s for s in TRAILER if name == s or name.startswith(s + "-")), name)
            self.videos.setdefault(scene, []).append((self.out / m["gif"], mp4, m["cap"]))
        self.raw_dir.mkdir(parents=True, exist_ok=True)
        self.make_trailer()
        shutil.rmtree(self.raw_dir, ignore_errors=True)
        if not self.trailer:
            log("! no trailer made")
            return 1
        log(f"wrote {self.trailer}")
        text = readme.read_text()
        link = f"**[Watch the trailer]({self.rel(self.trailer)})**"
        if link not in text:
            head, _, rest = text.partition("\n\n")
            head2, _, rest2 = rest.partition("\n\n")
            readme.write_text(f"{head}\n\n{head2}\n\n{link} (all the clips below in one video, real time).\n\n{rest2}")
        manifest = self.out / ".umoja-demo-files"
        if manifest.exists() and "videos/trailer.mp4" not in manifest.read_text():
            with manifest.open("a") as f:
                f.write("videos/trailer.mp4\n")
        return 0

    def run(self):
        if self.opts.trailer_only:
            return self.trailer_only()
        self.preflight()
        def picked(s, names):
            return s in names or (s.startswith("ai-") and "assistant" in names)
        scenes = [s for s in SCENES if (not self.opts.only or picked(s, self.opts.only))
                  and not picked(s, self.opts.skip or [])]
        if self.opts.ask:
            scenes = [s for s in scenes if not s.startswith("ai-")] + ["ai-custom"]
        if not self.dry:
            self.check_screen()
            log("Park the mouse pointer in the bottom-right corner (it shows in the clips), then keep")
            log(f"your hands off the keyboard and mouse: the tour starts in {self.opts.countdown} s.")
            for n in range(self.opts.countdown, 0, -1):
                print(f"  {n}...", flush=True)
                time.sleep(1)
        self.prepare_out()
        self.inhibit()
        stopped = None
        try:
            self.check_screen()
            self.notifications_on()
            self.start_workspace = self.workspaces()[0] if not self.dry else None
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.find_terminal()
            log("opening apps")
            self.open_apps()
            self.hide_terminal()
            self.ready = self.assistant_ready(scenes)
            for s in scenes:
                self.scene = s
                log(f"scene: {s}")
                self.check_screen()
                getattr(self, "scene_" + s.replace("-", "_"))()
        except Stop as e:
            stopped = str(e)
            log(f"! stopping: {stopped}. Nothing more is driven; only tidying up.")
        except KeyboardInterrupt:
            stopped = "interrupted"
            log("! interrupted")
        finally:
            self.tidy()
        log("encoding clips")
        self.encode()
        if not self.opts.no_trailer:
            self.make_trailer()
        self.write_markdown()
        n_shots = sum(len(v) for v in self.shots.values())
        n_vids = sum(len(v) for v in self.videos.values())
        log(f"done: {n_shots} screenshots and {n_vids} clips in {self.out}")
        if not self.dry:
            log(f"review {self.out / 'README.md'}, then: git add {self.out} && git commit")
        return 1 if stopped else 0


def main():
    here = Path(__file__).resolve().parent
    default_out = here.parent.parent / "docs" / "demo"
    if not (here.parent.parent / ".git").exists():
        default_out = Path.home() / f"umoja-demo-{time.strftime('%Y%m%d-%H%M')}"
    p = argparse.ArgumentParser(
        description="Drive a hands-free tour of a live Umoja session and capture screenshots and clips.")
    p.add_argument("--out", type=Path, default=default_out,
                   help=f"output directory (default: {default_out})")
    p.add_argument("--only", nargs="+", choices=SCENES + ["assistant"], metavar="SCENE",
                   help="run only these scenes: " + ", ".join(SCENES))
    p.add_argument("--skip", nargs="+", choices=SCENES + ["assistant"], metavar="SCENE", help="skip these scenes")
    p.add_argument("--ask", action="append", metavar="QUESTION",
                   help="question for the assistant (repeatable; replaces the defaults)")
    p.add_argument("--answer-wait", type=float, default=15.0,
                   help="with an older overlay (no AskWith): seconds to wait for each answer")
    p.add_argument("--answer-timeout", type=float, default=60.0,
                   help="give up on an answer after this many seconds (default 60)")
    p.add_argument("--retries", type=int, default=3,
                   help="asks per question until the answer checks out (default 3)")
    p.add_argument("--local", action="store_true",
                   help="ask the local model instead of the configured backend")
    p.add_argument("--no-typing", action="store_true", help="don't type questions out letter by letter")
    p.add_argument("--app", default="VLC", help="app for the \"I need ...\" install ask (default VLC; never installed)")
    p.add_argument("--no-trailer", action="store_true", help="don't stitch the clips into videos/trailer.mp4")
    p.add_argument("--trailer-only", action="store_true",
                   help="just rebuild videos/trailer.mp4 from the clips of an earlier run in --out")
    p.add_argument("--effect", help="screensaver effect to show (see umoja-screensaver --list-effects)")
    p.add_argument("--output", help="monitor connector to capture, e.g. eDP-1 (default: primary)")
    p.add_argument("--no-video", action="store_true", help="stills only")
    p.add_argument("--no-apps", action="store_true", help="don't open apps for the tour")
    p.add_argument("--no-demo-folder", action="store_true",
                   help=f"don't create ~/{DEMO_DIR_NAME} for Files and Text Editor to show")
    p.add_argument("--keep-terminal", action="store_true",
                   help="don't minimize the terminal the tour was started from")
    p.add_argument("--hidpi", action="store_true", help="full-resolution stills (default: logical size)")
    p.add_argument("--gif-width", type=int, default=960, help="GIF width in pixels (default 960)")
    p.add_argument("--pace", type=float, default=1.0, help="multiply every pause by this (e.g. 1.5 on a slow machine)")
    p.add_argument("--countdown", type=int, default=5, help="seconds before it starts (default 5)")
    p.add_argument("--dry-run", action="store_true", help="print the steps without touching the desktop")
    opts = p.parse_args()
    sys.exit(Demo(opts).run())


if __name__ == "__main__":
    main()
