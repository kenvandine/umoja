    # ---- output -------------------------------------------------------

    def encode(self):
        """webm -> GIF (inline on GitHub) + MP4, after capture so it can't stutter."""
        for raw, caption, scene, fast in self.clips:
            gif = self.vid_dir / f"{raw.stem}.gif"
            mp4 = self.vid_dir / f"{raw.stem}.mp4"
            if self.dry:
                self.videos.setdefault(scene, []).append((gif, mp4, caption))
                continue
            if not raw.exists() or raw.stat().st_size == 0:
                log(f"  ! {raw.name} is empty, dropping it")
                continue
            if not self.ffmpeg:
                dest = self.vid_dir / raw.name
                shutil.move(raw, dest)
                self.videos.setdefault(scene, []).append((None, dest, caption))
                continue
            log(f"  encode {raw.stem}" + (f" (fast-forwarding {fast})" if fast else ""))
            pre = self.fast_forward(fast)
            sound = has_audio(raw)
            graph = f"{pre};[v]scale='min(1920,iw)':-2,fps=30[vo]"
            maps = ["-map", "[vo]"]
            if sound:
                graph += ";" + self.fast_forward_audio(fast)
                maps += ["-map", "[a]", "-c:a", "aac", "-b:a", "160k"]
            ok_mp4 = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(raw),
                "-filter_complex", graph, *maps, "-c:v", "libx264", "-preset", "slow",
                "-crf", "26", "-pix_fmt", "yuv420p", "-movflags", "+faststart", str(mp4),
            ]).returncode == 0
            ok_gif = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(raw), "-filter_complex",
                f"{pre};[v]tpad=stop_mode=clone:stop_duration=1.5,fps=12,scale={self.opts.gif_width}:-1:flags=lanczos,split[a][b];"
                "[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4",
                "-an", str(gif),
            ]).returncode == 0
            if not ok_mp4:
                mp4 = self.vid_dir / raw.name
                shutil.copy(raw, mp4)
            self.videos.setdefault(scene, []).append((gif if ok_gif else None, mp4, caption))

    @staticmethod
    def speed_parts(spans):
        """(start, end or None, speed) pieces of a clip, for fast_forward."""
        parts, t = [], 0.0
        for a, b in sorted(spans):
            if a > t:
                parts.append((t, a, 1))
            parts.append((a, b, max(2, round((b - a) / FAST_TARGET))))
            t = b
        parts.append((t, None, 1))
        return parts

    def fast_forward_audio(self, spans):
        """fast_forward's sound: a filter graph from [0:a] to [a] that keeps
        the real-time pieces and puts silence of the sped-up length in
        place of each fast one (sped-up sound is only noise)."""
        fmt = f"aformat=sample_rates={AUDIO_RATE}:channel_layouts=stereo"
        if not spans:
            return f"[0:a]{fmt}[a]"
        parts = self.speed_parts(spans)
        live = [i for i, (_a, _b, k) in enumerate(parts) if k == 1]
        chains = [f"[0:a]asplit={len(live)}" + "".join(f"[s{i}]" for i in live)] if len(live) > 1 else []
        for i, (a, b, k) in enumerate(parts):
            if k == 1:
                src = f"[s{i}]" if len(live) > 1 else "[0:a]"
                trim = f"atrim=start={a}" + (f":end={b}" if b is not None else "")
                chains.append(f"{src}{trim},asetpts=PTS-STARTPTS,{fmt}[q{i}]")
            else:
                chains.append(f"aevalsrc=0|0:s={AUDIO_RATE}:d={(b - a) / k:.3f},{fmt}[q{i}]")
        n = len(parts)
        return ";".join([*chains, "".join(f"[q{i}]" for i in range(n)) + f"concat=n={n}:v=0:a=1[a]"])

    def fast_forward(self, spans):
        """A filter graph from [0:v] to [v] that plays each (start, end) span
        of the clip fast, down to about FAST_TARGET seconds, with a "N×"
        label in the corner while it does; the rest in real time."""
        if not spans:
            return "[0:v]null[v]"
        ff = self.filter_font()
        parts = self.speed_parts(spans)
        chains = []
        for i, (a, b, k) in enumerate(parts):
            trim = f"trim=start={a}" + (f":end={b}" if b is not None else "")
            chain = f"[s{i}]{trim},setpts=(PTS-STARTPTS)/{k}"
            if k > 1 and ff:
                chain += (f",drawtext=expansion=none:fontfile={ff}:text='{k}× speed':fontsize=h/28:"
                          f"fontcolor=white:box=1:boxcolor=black@0.55:boxborderw=14:x=w-text_w-40:y=60")
            chains.append(chain + f"[p{i}]")
        n = len(parts)
        split = f"[0:v]split={n}" + "".join(f"[s{i}]" for i in range(n))
        return ";".join([split, *chains, "".join(f"[p{i}]" for i in range(n)) + f"concat=n={n}:v=1:a=0[v]"])

    def filter_font(self):
        """The caption font as an ffmpeg filter argument, or None. Ubuntu
        Sans is "UbuntuSans[wdth,wght].ttf": brackets and commas break
        ffmpeg's filter syntax, so this points at a copy with a plain name."""
        font = self.font()
        if not font:
            return None
        self.raw_dir.mkdir(parents=True, exist_ok=True)
        plain = self.raw_dir / ("font" + Path(font).suffix)
        if not plain.exists():
            shutil.copy(font, plain)
        return str(plain).replace("\\", "\\\\").replace(":", "\\:").replace("'", "\\'")

    def font(self):
        for pattern in ("Ubuntu Sans:bold", "Ubuntu:bold", "sans:bold"):
            r = subprocess.run(["fc-match", "-f", "%{file}", pattern], capture_output=True, text=True)
            if r.returncode == 0 and r.stdout.strip() and Path(r.stdout.strip()).exists():
                return r.stdout.strip()
        return None

    def make_trailer(self):
        """The trailer clips, captioned, after a title card: videos/trailer.mp4.
        The screen is shrunk a little to leave a band under it for the
        captions, so they never cover anything on screen. The clips' sound
        comes along (silence where a clip has none), with --music under it."""
        parts = [(m, c) for sc in self.TRAILER for _g, m, c in self.videos.get(sc, [])
                 if m and m.suffix == ".mp4"]
        if self.dry:
            log(f"  trailer from {len(parts)} clips")
            self.trailer = self.vid_dir / "trailer.mp4"
            return
        ff = self.filter_font()
        if not self.ffmpeg or not parts or not ff:
            if parts and not ff:
                log("  ! no font found for captions (fc-match), no trailer")
            return
        log(f"  trailer from {len(parts)} clips")
        _x, _y, w, h = self.area
        W = 1920
        H = int(round(W * h / w / 2) * 2)
        band = int(round(H * CAPTION_BAND / 2) * 2)
        work = self.raw_dir / "trailer"
        work.mkdir(parents=True, exist_ok=True)
        fit = (f"scale={W}:{H - band}:force_original_aspect_ratio=decrease,"
               f"pad={W}:{H}:(ow-iw)/2:0:color={BRAND_BG},fps=30,format=yuv420p")
        # One frame rate, time base and sound format for every segment:
        # concat -c copy keeps each file's timestamps, and the title card
        # (1/30 time base) played for two frames among clips with another one.
        enc = ["-r", "30", "-c:v", "libx264", "-preset", "veryfast", "-crf", "22",
               "-pix_fmt", "yuv420p", "-video_track_timescale", "15360",
               "-c:a", "aac", "-b:a", "160k", "-ar", str(AUDIO_RATE), "-ac", "2"]
        silence = ["-f", "lavfi", "-i", f"anullsrc=r={AUDIO_RATE}:cl=stereo"]
        segs = []

        def card(name, title, subtitle, seconds):
            """A plain card: big title, an orange line under it."""
            (work / f"{name}-1.txt").write_text(title)
            (work / f"{name}-2.txt").write_text(subtitle)
            out = work / f"{name}.mp4"
            r = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-f", "lavfi", "-i",
                f"color=c={BRAND_BG}:s={W}x{H}:d={seconds}:r=30", *silence, "-vf",
                f"drawtext=expansion=none:fontfile={ff}:textfile={work / f'{name}-1.txt'}:fontsize=140:"
                f"fontcolor=white:x=(w-text_w)/2:y=(h-text_h)/2-60,"
                f"drawtext=expansion=none:fontfile={ff}:textfile={work / f'{name}-2.txt'}:fontsize=48:"
                f"fontcolor=0xE95420:x=(w-text_w)/2:y=(h/2)+70,format=yuv420p",
                "-t", str(seconds), *enc, str(out)])
            return out if r.returncode == 0 else None

        title = card("00-title", "Umoja", self.TAGLINE, 2.5)
        if title:
            segs.append(title)
        for i, (mp4, caption) in enumerate(parts, 1):
            txt = work / f"{i:02d}.txt"
            # Long captions wrap onto a second line, centred, instead of
            # running off both edges.
            txt.write_text(wrap_caption(caption))
            out = work / f"{i:02d}.mp4"
            # The sound padded or cut to the picture's length, so the clips
            # after it stay in sync.
            length = duration(mp4)
            sound = has_audio(mp4)
            r = subprocess.run([
                "ffmpeg", "-loglevel", "error", "-y", "-i", str(mp4), *([] if sound else silence),
                "-vf",
                f"{fit},drawtext=expansion=none:fontfile={ff}:textfile={txt}:fontsize=40:fontcolor=white:"
                f"text_align=C:line_spacing=10:x=(w-text_w)/2:y=h-{band // 2}-text_h/2",
                "-af", f"aformat=sample_rates={AUDIO_RATE}:channel_layouts=stereo,apad",
                "-map", "0:v", "-map", "0:a" if sound else "1:a",
                *(["-t", f"{length:.3f}"] if length else ["-shortest"]), *enc, str(out)])
            if r.returncode == 0:
                segs.append(out)
        end = card("99-end", "Umoja", REPO_URL, 3.0)
        if end:
            segs.append(end)
        if len(segs) < 2:
            log("  ! trailer encode failed")
            return
        lst = work / "list.txt"
        lst.write_text("".join(f"file '{p}'\n" for p in segs))
        joined = work / "joined.mp4"
        r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "concat", "-safe", "0",
                            "-i", str(lst), "-c", "copy", str(joined)])
        if r.returncode != 0:
            log("  ! trailer concat failed")
            return
        dest = self.vid_dir / "trailer.mp4"
        music = self.opts.music
        if music and not music.exists():
            log(f"  ! no {music}, the trailer has no music")
            music = None
        if music:
            # Quietly under everything, ducked while the clips make sound
            # (Umoja reading aloud), faded in and out with the cards.
            total = duration(joined) or 0
            graph = (f"[0:a]asplit[keep][key];"
                     f"[1:a]aformat=sample_rates={AUDIO_RATE}:channel_layouts=stereo,volume=0.25,"
                     f"afade=t=in:d=1.5,afade=t=out:st={max(total - 3, 0):.2f}:d=3[bed];"
                     f"[bed][key]sidechaincompress=threshold=0.02:ratio=10:attack=20:release=600[duck];"
                     f"[keep][duck]amix=inputs=2:duration=first:normalize=0[a]")
            cmd = ["ffmpeg", "-loglevel", "error", "-y", "-i", str(joined), "-stream_loop", "-1",
                   "-i", str(music), "-filter_complex", graph, "-map", "0:v", "-map", "[a]",
                   "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(dest)]
        else:
            cmd = ["ffmpeg", "-loglevel", "error", "-y", "-i", str(joined), "-c", "copy",
                   "-movflags", "+faststart", str(dest)]
        if subprocess.run(cmd).returncode == 0:
            self.trailer = dest

    def version(self):
        if self.dry:
            return "dry run"
        r = subprocess.run(["dpkg-query", "-W", "-f", "${Version}", "umoja-desktop"],
                           capture_output=True, text=True)
        return r.stdout.strip() or "unknown version"

    def rel(self, p):
        return os.path.relpath(p, self.out)

    def write_markdown(self):
        titles = self.TITLES
        today = datetime.date.today().isoformat()
        lines = [
            f"# {self.HEADING}",
            "",
            f"Captured hands-free by `{self.TOOL}` on {today} "
            f"(umoja-desktop {self.version()}).",
            "",
        ]
        if self.trailer:
            lines += [f"**[Watch the trailer]({self.rel(self.trailer)})** "
                      f"(all the clips below in one video, real time).", ""]
        for scene in self.SCENES + ["ai-custom"]:
            shots = self.shots.get(scene, [])
            vids = self.videos.get(scene, [])
            if not shots and not vids:
                continue
            lines += [f"## {titles[scene]}", ""]
            for path, caption in shots:
                lines += [f"![{caption}]({self.rel(path)})", "", f"*{caption}*", ""]
            for gif, video, caption in vids:
                if gif:
                    lines += [f"[![{caption}]({self.rel(gif)})]({self.rel(video)})", "",
                              f"*{caption}* ([video]({self.rel(video)}))", ""]
                else:
                    lines += [f"[{caption} (video)]({self.rel(video)})", ""]
        if not self.dry:
            (self.out / "README.md").write_text("\n".join(lines))

        # A compact gallery for the top-level README (paths from the repo root).
        try:
            root = Path(__file__).resolve().parents[2]
            base = os.path.relpath(self.out.resolve(), root)
        except (IndexError, ValueError):
            base = str(self.out)
        if base.startswith(".."):
            base = str(self.out)
        else:
            # A leading "/" makes GitHub resolve links from the repository
            # root, so the same links work in snippet.md and in README.md.
            base = "/" + base
        hero = [s for s in self.HERO if s in self.shots][:4]
        snippet = ["## Screenshots", ""]
        lead = next((s for s in self.LEAD
                     if s in self.videos and self.videos[s][0][0]), None)
        if lead:
            gif, video, caption = self.videos[lead][0]
            target = self.trailer or video
            snippet += [f"[![{caption}]({base}/{self.rel(gif)})]({base}/{self.rel(target)})", ""]
        if self.trailer:
            snippet += [f"[Watch the trailer]({base}/{self.rel(self.trailer)}).", ""]
        # btop's last shot is the one with btop running.
        cells = [self.shots[s][-1 if s == "ai-btop" else 0] for s in hero]
        if cells:
            snippet += ["| " + " | ".join(titles[s] for s in hero) + " |",
                        "| " + " | ".join("---" for _ in hero) + " |",
                        "| " + " | ".join(f"![{titles[s]}]({base}/{self.rel(p)})"
                                          for s, (p, _c) in zip(hero, cells)) + " |", ""]
        snippet += [f"More in the [tour]({base}/README.md).", ""]
        if not self.dry:
            (self.out / "snippet.md").write_text("\n".join(snippet))
            files = [self.rel(p) for v in self.shots.values() for p, _ in v]
            if self.layout:
                layout = self.img_dir / "layout.json"
                layout.write_text(json.dumps(self.layout, indent=1, sort_keys=True) + "\n")
                files.append(self.rel(layout))
            files += [self.rel(p) for v in self.videos.values() for g, m, _ in v for p in (g, m) if p]
            if self.trailer:
                files.append(self.rel(self.trailer))
            files += ["README.md", "snippet.md"]
            (self.out / ".umoja-demo-files").write_text("\n".join(files) + "\n")
            shutil.rmtree(self.raw_dir, ignore_errors=True)
        else:
            log("README.md would be:\n" + "\n".join(lines))
            log("snippet.md would be:\n" + "\n".join(snippet))

    # ---- main ---------------------------------------------------------

    def trailer_only(self):
        """Rebuild videos/trailer.mp4 from an earlier run's clips and captions."""
        import re
        readme = self.out / "README.md"
        if not readme.exists():
            sys.exit(f"no {readme}: run the tour first")
        self.check_tools([], trailer_only=True)
        self.ffmpeg = bool(shutil.which("ffmpeg"))
        _conn, self.area = self.monitor()
        pat = re.compile(r"^\[!\[(?P<cap>.*)\]\((?P<gif>[^)]*)\)\]\((?P<mp4>[^)]*\.mp4)\)$")
        for line in readme.read_text().splitlines():
            m = pat.match(line.strip())
            if not m:
                continue
            mp4 = self.out / m["mp4"]
            if mp4.name == "trailer.mp4" or not mp4.exists():
                continue
            name = mp4.stem
            scene = next((s for s in self.TRAILER if name == s or name.startswith(s + "-")), name)
            self.videos.setdefault(scene, []).append((self.out / m["gif"], mp4, m["cap"]))
        self.raw_dir.mkdir(parents=True, exist_ok=True)
        self.make_trailer()
        shutil.rmtree(self.raw_dir, ignore_errors=True)
        if not self.trailer:
            log("! no trailer made")
            return 1
        log(f"wrote {self.trailer}")
        text = readme.read_text()
        link = f"**[Watch the trailer]({self.rel(self.trailer)})**"
        if link not in text:
            head, _, rest = text.partition("\n\n")
            head2, _, rest2 = rest.partition("\n\n")
            readme.write_text(f"{head}\n\n{head2}\n\n{link} (all the clips below in one video, real time).\n\n{rest2}")
        manifest = self.out / ".umoja-demo-files"
        if manifest.exists() and "videos/trailer.mp4" not in manifest.read_text():
            with manifest.open("a") as f:
                f.write("videos/trailer.mp4\n")
        return 0

    def run(self):
        if self.opts.trailer_only:
            return self.trailer_only()
        def picked(s, names):
            return s in names or (s in self.AI_SCENES and "assistant" in names)
        scenes = [s for s in self.SCENES if (not self.opts.only or picked(s, self.opts.only))
                  and not picked(s, self.opts.skip or [])
                  # Scenes not ready for a default run play only when named.
                  and (s not in self.OPT_IN or picked(s, self.opts.only or []))]
        if self.opts.ask:
            scenes = [s for s in scenes if not s.startswith("ai-")] + ["ai-custom"]
        self.check_tools(scenes)
        self.preflight()
        if not self.dry:
            self.check_screen()
            log("Keep your hands off the keyboard and mouse (the tour moves the pointer out of the")
            log(f"way itself on new enough umoja): it starts in {self.opts.countdown} s.")
            for n in range(self.opts.countdown, 0, -1):
                print(f"  {n}...", flush=True)
                time.sleep(1)
        if self.opts.only and not self.dry:
            # Only some scenes: the earlier run's other scenes stay, in the
            # page and the trailer, instead of being cleared away.
            self.keep_previous(set(scenes))
        self.prepare_out()
        self.inhibit()
        stopped = None
        try:
            self.check_screen()
            self.notifications_on()
            self.start_workspace = self.workspaces()[0] if not self.dry else None
            self.bus.call(OVERLAY, "Hide", quiet=True)
            self.find_terminal()
            log("opening apps")
            self.open_apps()
            self.hide_terminal()
            self.ready = self.assistant_ready(scenes)
            for s in scenes:
                self.scene = s
                log(f"scene: {s}")
                self.check_screen()
                self.park_pointer()
                getattr(self, "scene_" + s.replace("-", "_"))()
        except Stop as e:
            stopped = str(e)
            log(f"! stopping: {stopped}. Nothing more is driven; only tidying up.")
        except KeyboardInterrupt:
            stopped = "interrupted"
            log("! interrupted")
        finally:
            self.tidy()
        log("encoding clips")
        self.encode()
        if not self.opts.no_trailer:
            log("making the trailer (a few minutes; Ctrl+C now leaves the earlier one)")
            self.make_trailer()
        self.write_markdown()
        n_shots = sum(len(v) for v in self.shots.values())
        n_vids = sum(len(v) for v in self.videos.values())
        log(f"done: {n_shots} screenshots and {n_vids} clips in {self.out}")
        if not self.dry:
            log(f"review {self.out / 'README.md'}, then: git add {self.out} && git commit")
        return 1 if stopped else 0


def parser(cls=Demo, out_name="demo", description=None):
    """The command line; tools/demo/umoja-agent-demo adds its own options."""
    here = Path(__file__).resolve().parent
    default_out = here.parent.parent / "docs" / out_name
    if not (here.parent.parent / ".git").exists():
        default_out = Path.home() / f"umoja-{out_name}-{time.strftime('%Y%m%d-%H%M')}"
    SCENES = cls.SCENES  # noqa: N806 (the choices below)
    p = argparse.ArgumentParser(description=description or
                                "Drive a hands-free tour of a live Umoja session and capture screenshots and clips.")
    p.add_argument("--out", type=Path, default=default_out,
                   help=f"output directory (default: {default_out})")
    p.add_argument("--only", nargs="+", choices=SCENES + ["assistant"], metavar="SCENE",
                   help="run only these scenes: " + ", ".join(SCENES))
    p.add_argument("--skip", nargs="+", choices=SCENES + ["assistant"], metavar="SCENE", help="skip these scenes")
    p.add_argument("--ask", action="append", metavar="QUESTION",
                   help="question for the assistant (repeatable; replaces the defaults)")
    p.add_argument("--answer-wait", type=float, default=15.0,
                   help="with an older overlay (no AskWith): seconds to wait for each answer")
    p.add_argument("--answer-timeout", type=float, default=60.0,
                   help="give up on an answer after this many seconds (default 60)")
    p.add_argument("--retries", type=int, default=3,
                   help="asks per question until the answer checks out (default 3)")
    p.add_argument("--local", action="store_true",
                   help="ask the local model instead of the configured backend")
    p.add_argument("--no-typing", action="store_true", help="don't type questions out letter by letter")
    p.add_argument("--app", default="VLC", help="app for the \"I need ...\" install ask (default VLC; never installed)")
    p.add_argument("--reinstall-agent", action="store_true",
                   help="remove OpenCode first (sudo -n snap remove) so ai-opencode films its install")
    p.add_argument("--no-trailer", action="store_true", help="don't stitch the clips into videos/trailer.mp4")
    p.add_argument("--trailer-only", action="store_true",
                   help="just rebuild videos/trailer.mp4 from the clips of an earlier run in --out")
    p.add_argument("--effect", help="screensaver effect to show (see umoja-screensaver --list-effects)")
    p.add_argument("--output", help="monitor connector to capture, e.g. eDP-1 (default: primary)")
    p.add_argument("--no-video", action="store_true", help="stills only")
    p.add_argument("--no-audio", action="store_true", help="silent clips (don't record the desktop's sound)")
    p.add_argument("--music", type=Path, metavar="FILE",
                   help="an audio file to play quietly under the trailer (looped, faded out, "
                        "ducked while Umoja speaks)")
    p.add_argument("--no-apps", action="store_true", help="don't open apps for the tour")
    p.add_argument("--no-demo-folder", action="store_true",
                   help=f"don't create ~/{DEMO_DIR_NAME} for Files and Text Editor to show")
    p.add_argument("--keep-terminal", action="store_true",
                   help="don't minimize the terminal the tour was started from")
    p.add_argument("--keep-notifications", action="store_true",
                   help="don't clear the notification list before the notifications scene")
    p.add_argument("--hidpi", action="store_true", help="full-resolution stills (default: logical size)")
    p.add_argument("--gif-width", type=int, default=960, help="GIF width in pixels (default 960)")
    p.add_argument("--pace", type=float, default=1.0, help="multiply every pause by this (e.g. 1.5 on a slow machine)")
    p.add_argument("--countdown", type=int, default=5, help="seconds before it starts (default 5)")
    p.add_argument("--dry-run", action="store_true", help="print the steps without touching the desktop")
    p.add_argument("--task-timeout", type=float, default=420.0,
                   help="background agent scenes: give up on a task after this many seconds (default 420)")
    return p


def main():
    sys.exit(Demo(parser().parse_args()).run())


if __name__ == "__main__":
    main()
