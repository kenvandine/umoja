    def scene_screensaver(self):
        exe = shutil.which("umoja-screensaver")
        if not exe and not self.dry:
            log("  umoja-screensaver isn't installed, skipping")
            return
        effect = self.opts.effect
        cmd = [exe or "umoja-screensaver"] + (["--effect", effect] if effect else [])
        self.recorder.start("screensaver")
        log(f"  run  {' '.join(cmd)}")
        if not self.dry:
            # A preview ends on real input only; nothing here touches it.
            self.saver = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.wait(3.5)
        self.shot("screensaver", "The screensaver: \"umoja\" drawn in glowing dots, a new effect each cycle.")
        self.wait(3.5)
        if self.saver:
            self.saver.terminate()
            try:
                self.saver.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.saver.kill()
            self.saver = None
        self.wait(0.8)
        self.recorder.stop("Screensaver preview (umoja-screensaver).")

    # ---- assistant ----------------------------------------------------

    def lemonade(self):
        url = os.environ.get("UMOJA_LEMONADE_URL", "").strip().rstrip("/")
        if not url:
            port = os.environ.get("UMOJA_LEMONADE_PORT", "").strip() or "13345"
            url = f"http://127.0.0.1:{port}"
        return url

    def local_model(self):
        s = settings("org.umoja.shell")
        model = s.get_string("lemonade-model") if s else ""
        return model or "Qwen3-4B-Instruct-2507-GGUF"

    def http(self, path, body=None, timeout=10):
        req = urllib.request.Request(
            self.lemonade() + path,
            data=None if body is None else json.dumps(body).encode(),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")

    def warm_model(self):
        """Load the local model first so the asks answer in seconds."""
        if self.dry:
            log(f"  warm {self.lemonade()} model {self.local_model()}")
            return True
        model = self.local_model()
        try:
            models = self.http("/api/v1/models").get("data", [])
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"  ! Lemonade isn't answering on {self.lemonade()} ({e}), skipping the assistant")
            return False
        if model not in [m.get("id") for m in models]:
            log(f"  ! the local model {model} isn't downloaded yet, skipping the assistant")
            return False
        log(f"  loading {model} (the first answer can take ~10 s)")
        try:
            self.http("/api/v1/chat/completions", {
                "model": model, "max_tokens": 1,
                "messages": [{"role": "user", "content": "Hi"}],
            }, timeout=180)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"  ! warming the model failed ({e}); asking anyway")
        return True

    def tiling_question(self):
        names = [self.names.get(w) for w in self.opened[:2]] if not self.dry else ["Files", "Text Editor"]
        if len(names) < 2 or not all(names):
            return None
        return f"Put {names[0]} on the left half of the screen and {names[1]} on the right half"

    def untile_demo_windows(self):
        for w in self.windows():
            if w[0] in self.opened and w[7] & (F_MAXIMIZED | F_FULLSCREEN | F_TILED):
                self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (w[0], TILE_RESTORE)))

    def assistant_ready(self, scenes):
        if not any(s.startswith("ai-") for s in scenes):
            return False
        if self.dry:
            return True
        self.can_ask_with = self.bus.has_method(OVERLAY, "AskWith")
        if not self.can_ask_with:
            log("note: this overlay has no AskWith, so questions aren't typed out and each answer "
                "gets a fixed wait (--answer-wait) with no checking. Install newer debs.")
        else:
            self.bus.conn.signal_subscribe(
                OVERLAY[0], OVERLAY[2], None, OVERLAY[1], None, Gio.DBusSignalFlags.NONE,
                lambda _c, _s, _p, _i, name, params: self.events.append((name, params.unpack())),
            )
        if self.opts.local:
            return self.warm_model()
        return True

    def ask(self, name, question, caption, expect=(), confirm=False, settle=1.5,
            keep_open=False, expect_steps=0, step_has=None):
        """Ask the assistant, recording it; retry until the answer checks out.

        `expect`: words, one of which the answer must contain. `confirm`:
        the ask should end at the "Allow the assistant to do this?" dialog,
        which is shot and then cancelled (the overlay is hidden: nothing is
        installed or sent). Returns the answer text, or None."""
        tries = 1 if self.dry else self.opts.retries
        for attempt in range(1, tries + 1):
            self.check_screen()
            self.events.clear()
            self.recorder.start(name)
            log(f"  ask  {question!r}" + (f" (try {attempt})" if attempt > 1 else ""))
            if self.dry or self.can_ask_with:
                flags = (1 if self.opts.local else 0) | (0 if self.opts.no_typing else 2)
                self.bus.call(OVERLAY, "AskWith", GLib.Variant("(su)", (question, flags)))
            else:
                self.bus.call(OVERLAY, "Ask", GLib.Variant("(s)", (question,)))
            if self.dry or not self.can_ask_with:
                self.wait(self.opts.answer_wait)
                result = ("", [])
            else:
                self.until = lambda: any(e[0] in ("AnswerFinished", "ConfirmShown") for e in self.events)
                try:
                    self.wait(self.opts.answer_timeout)
                finally:
                    self.until = None
                result = self.check_answer(expect, confirm, expect_steps, step_has)
            if result is not None:
                answer, steps = result
                self.wait(settle)
                self.shot(name, caption)
                if not keep_open:
                    self.bus.call(OVERLAY, "Hide")
                    self.wait(0.8)
                self.recorder.stop(caption)
                for st in steps:
                    log(f"       {st}")
                if answer:
                    log(f"       answer: {answer[:160]!r}")
                return answer
            self.recorder.discard()
            self.bus.call(OVERLAY, "Hide")
            self.wait(1.5)
        log(f"  ! no good answer after {tries} tries, leaving {name} out")
        return None

    def check_answer(self, expect, confirm, expect_steps=0, step_has=None):
        """(answer, steps) when the answer is good, else None (logged)."""
        names = [e[0] for e in self.events]
        if confirm:
            if "ConfirmShown" in names:
                label = next(e[1][0] for e in self.events if e[0] == "ConfirmShown")
                return ("", [f"confirm:{label}"])
            log("  ! the assistant didn't ask for confirmation")
            return None
        done = [e for e in self.events if e[0] == "AnswerFinished"]
        if not done:
            if "ConfirmShown" in names:
                log("  ! it asked for confirmation; retrying")
            else:
                log(f"  ! no answer within {self.opts.answer_timeout:.0f} s")
            return None
        answer, steps = done[-1][1]
        bad = [st for st in steps if not st.startswith("done:")]
        if bad:
            log(f"  ! a step didn't work: {bad}")
            return None
        if len(steps) < expect_steps:
            log(f"  ! expected {expect_steps} steps, got {steps}")
            return None
        if step_has and not any(step_has.lower() in st.lower() for st in steps):
            log(f"  ! no step about {step_has!r}: {steps}")
            return None
        if expect and not any(w.lower() in answer.lower() for w in expect):
            log(f"  ! the answer doesn't mention any of {list(expect)}: {answer[:120]!r}")
            return None
        if not answer and not steps:
            log("  ! empty answer")
            return None
        return answer, steps

