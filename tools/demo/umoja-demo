class Stop(Exception):
    """The tour can't go on (screen blanked/locked, session gone)."""


def settings(schema):
    """Gio.Settings for `schema`, or None (Gio aborts on an unknown schema)."""
    src = Gio.SettingsSchemaSource.get_default()
    if src is None or src.lookup(schema, True) is None:
        return None
    return Gio.Settings.new(schema)


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


class Bus:
    """Thin synchronous wrapper over the session bus (or a printer for --dry-run)."""

    def __init__(self, dry):
        self.dry = dry
        self.conn = None if dry else Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.system = None

    def call(self, target, method, args=None, reply=None, timeout=10_000, quiet=False):
        name, path, iface = target
        if self.dry:
            if not quiet:
                log(f"  dbus {iface}.{method}{'' if args is None else ' ' + str(args.unpack())}")
            return None
        try:
            res = self.conn.call_sync(
                name, path, iface, method, args,
                GLib.VariantType(reply) if reply else None,
                Gio.DBusCallFlags.NONE, timeout, None,
            )
        except GLib.Error as e:
            if not quiet:
                log(f"  ! {iface}.{method}: {e.message}")
            return None
        return res.unpack() if res is not None else None

    def has_method(self, target, method):
        if self.dry:
            return True
        name, path, iface = target
        try:
            res = self.conn.call_sync(
                name, path, "org.freedesktop.DBus.Introspectable", "Introspect",
                None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 5000, None,
            )
        except GLib.Error:
            return False
        info = Gio.DBusNodeInfo.new_for_xml(res.unpack()[0])
        i = info.lookup_interface(iface)
        return bool(i and i.lookup_method(method))

    def has_name(self, name):
        if self.dry:
            return True
        res = self.call(
            ("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus"),
            "NameHasOwner", GLib.Variant("(s)", (name,)), "(b)", quiet=True,
        )
        return bool(res and res[0])

    def session_locked(self):
        if self.dry:
            return False
        try:
            if self.system is None:
                self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            res = self.system.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", ("org.freedesktop.login1.Session", "LockedHint")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None,
            )
            return bool(res.unpack()[0])
        except GLib.Error:
            return False


class Recorder:
    """One wf-recorder clip at a time, on the primary monitor."""

    def __init__(self, demo):
        self.demo = demo
        self.proc = None
        self.path = None

    def start(self, name):
        if not self.demo.video:
            return
        self.path = self.demo.raw_dir / f"{name}.webm"
        cmd = [
            "wf-recorder", "-y", "-c", "libvpx", "-x", "yuv420p",
            "-p", "deadline=realtime", "-p", "cpu-used=8", "-p", "b=16M",
            "-f", str(self.path),
        ]
        if self.demo.output:
            cmd[1:1] = ["-o", self.demo.output]
        if self.demo.dry:
            log(f"  rec  {' '.join(cmd)}")
            self.proc = True
            return
        self.proc = subprocess.Popen(
            cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=open(self.demo.raw_dir / f"{name}.log", "w"),
        )
        time.sleep(1.0)  # wf-recorder needs a moment before the first frame
        if self.proc.poll() is not None:
            log(f"  ! wf-recorder exited at once (see {self.demo.raw_dir}/{name}.log)")
            self.proc = None

    def stop(self, caption):
        if not self.proc:
            return
        if self.demo.dry:
            log("  rec  stop")
        else:
            time.sleep(0.5)
            self.proc.send_signal(signal.SIGINT)  # finishes the file
            try:
                self.proc.wait(timeout=15)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.demo.clips.append((self.path, caption, self.demo.scene))
        self.proc = None

    def discard(self):
        """Stop and throw away the clip (a failed try)."""
        path = self.path
        self.abort()
        if path and not self.demo.dry:
            path.unlink(missing_ok=True)

    def abort(self):
        if self.proc and self.proc is not True:
            self.proc.send_signal(signal.SIGINT)
            try:
                self.proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc = None


class Demo:
    def __init__(self, opts):
        self.opts = opts
        self.dry = opts.dry_run
        self.bus = Bus(self.dry)
        self.out = opts.out
        self.img_dir = self.out / "images"
        self.vid_dir = self.out / "videos"
        self.raw_dir = self.out / ".raw"
        self.video = not opts.no_video
        self.output = None
        self.area = None  # (x, y, w, h) of the captured monitor, layout pixels
        self.terminal = None  # the window we were started from, minimized
        self.terminal_name = ""
        self.dark = None  # (color-scheme, gtk-theme) before the dark style ask
        self.ready = False  # the assistant can be asked
        self.until = None  # wait() returns early once this says so
        self.events = []  # (signal, args) from org.umoja.Overlay
        self.night_light = None
        self.trailer = None
        self.can_ask_with = False
        self.demo_dir = None  # created by us, removed at the end
        self.spots = {}  # window id -> where its title bar sits when floating
        self.names = {}  # window id -> app name, for the assistant
        self.shots = {}  # scene -> [(file, caption)]
        self.clips = []  # (raw webm, caption, scene)
        self.videos = {}  # scene -> [(gif or None, mp4/webm, caption)]
        self.scene = None
        self.opened = []  # window ids this tour opened
        self.notes = []
        self.inhibit_cookie = None
        self.start_workspace = None
        self.banners = None
        self.saver = None
        self.recorder = Recorder(self)

    # ---- safety -------------------------------------------------------

    def check_screen(self):
        """Never drive the desktop while the screen is blanked or locked."""
        res = self.bus.call(SCREENSAVER, "GetActive", None, "(b)", quiet=True)
        if res and res[0]:
            raise Stop("the screen is blanked")
        if self.bus.session_locked():
            raise Stop("the session is locked")

    def wait(self, seconds):
        """Sleep in small steps, checking the screen as we go."""
        if self.dry:
            return
        end = time.monotonic() + seconds * self.opts.pace
        ctx = GLib.MainContext.default()
        last_check = 0.0
        while True:
            # D-Bus signals (AnswerFinished...) are delivered here.
            while ctx.iteration(False):
                pass
            if self.until and self.until():
                return
            now = time.monotonic()
            if now >= end:
                return
            if now - last_check > 0.5:
                self.check_screen()
                last_check = now
            time.sleep(min(end - now, 0.05))

    # ---- capture ------------------------------------------------------

    def shot(self, name, caption):
        self.check_screen()
        path = self.img_dir / f"{name}.png"
        cmd = ["grim"]
        if not self.opts.hidpi:
            cmd += ["-s", "1"]  # logical size: keeps the PNGs README-sized
        if self.output:
            cmd += ["-o", self.output]
        cmd.append(str(path))
        if self.dry:
            log(f"  shot {' '.join(cmd)}")
        else:
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                log(f"  ! grim failed: {r.stderr.strip()}")
                return
            log(f"  shot {path.name}")
        self.shots.setdefault(self.scene, []).append((path, caption))

    # ---- setup / teardown --------------------------------------------

    def preflight(self):
        problems = []
        if not os.environ.get("WAYLAND_DISPLAY"):
            problems.append("run this inside the Umoja session (no WAYLAND_DISPLAY)")
        if "Umoja" not in os.environ.get("XDG_CURRENT_DESKTOP", ""):
            problems.append("XDG_CURRENT_DESKTOP doesn't say Umoja; is this an Umoja session?")
        for tool in ["grim"] + (["wf-recorder"] if self.video else []):
            if not shutil.which(tool):
                problems.append(f"{tool} is missing (sudo apt install {tool})")
        for target in (OVERLAY, PANEL, COMPOSITOR):
            if not self.bus.has_name(target[0]):
                problems.append(f"{target[0]} isn't on the session bus")
        if problems and not self.dry:
            for p in problems:
                log(f"! {p}")
            sys.exit(1)
        self.ffmpeg = bool(shutil.which("ffmpeg"))
        if self.video and not self.ffmpeg:
            log("note: ffmpeg is missing, so clips stay .webm (no GIFs for the README). "
                "sudo apt install ffmpeg, then rerun.")
        self.output, self.area = self.monitor()
        if self.opts.output:
            self.output = self.opts.output
        log(f"capturing monitor {self.output or '(all)'}; writing to {self.out}")
        if not self.dry and not self.bus.has_method(COMPOSITOR, "DragWindow"):
            log("note: the running compositor has no DragWindow, so there's no tiling scene and "
                "the windows can't be laid out. If you just installed newer debs, log out and back in.")

    def monitor(self):
        """(connector, (x, y, w, h)) of the primary monitor, in layout pixels."""
        res = self.bus.call(DISPLAY_CONFIG, "GetCurrentState", None, quiet=True)
        if not res:
            return None, (0, 0, 1920, 1080)
        _serial, monitors, logical, props = res
        physical_layout = props.get("layout-mode") == 2
        pick = next((lm for lm in logical if lm[4] and lm[5]), logical[0] if logical else None)
        if not pick or not pick[5]:
            return None, (0, 0, 1920, 1080)
        x, y, scale, _transform, _primary, mons, _p = pick
        connector = mons[0][0]
        w, h = 1920, 1080
        for (spec, modes, _mp) in monitors:
            if spec[0] != connector:
                continue
            for mode in modes:
                if mode[6].get("is-current"):
                    w, h = mode[1], mode[2]
        if not physical_layout and scale:
            w, h = round(w / scale), round(h / scale)
        if pick[3] in (1, 3, 5, 7):  # rotated 90/270
            w, h = h, w
        return connector, (x, y, w, h)

    def prepare_out(self):
        if self.dry:
            return
        manifest = self.out / ".umoja-demo-files"
        if manifest.exists():  # remove what an earlier run wrote, nothing else
            for line in manifest.read_text().splitlines():
                p = self.out / line
                if p.is_file() and p.resolve().is_relative_to(self.out.resolve()):
                    p.unlink()
        for d in (self.img_dir, self.vid_dir, self.raw_dir):
            d.mkdir(parents=True, exist_ok=True)

    def inhibit(self):
        res = self.bus.call(
            SCREENSAVER, "Inhibit",
            GLib.Variant("(ss)", ("umoja-demo", "Recording a demo of the desktop")), "(u)",
        )
        self.inhibit_cookie = res[0] if res else None

    def uninhibit(self):
        if self.inhibit_cookie is not None:
            self.bus.call(SCREENSAVER, "UnInhibit", GLib.Variant("(u)", (self.inhibit_cookie,)),
                          quiet=True)

    def notifications_on(self):
        """Do Not Disturb would hide the bubbles; lift it for the tour."""
        if self.dry:
            return
        s = settings("org.gnome.desktop.notifications")
        if not s:
            return
        self.banners = s.get_boolean("show-banners")
        if not self.banners:
            log("turning Do Not Disturb off for the tour (restored afterwards)")
            s.set_boolean("show-banners", True)
            Gio.Settings.sync()

    def windows(self):
        rows = self.bus.call(COMPOSITOR, "GetWindows", None, "(a(tssiiiiu))", quiet=True)
        return rows[0] if rows else []

    def open_apps(self):
        if self.opts.no_apps:
            return
        found = []
        for desktop_id in APP_CANDIDATES:
            try:
                info = DesktopAppInfo.new(desktop_id)
            except TypeError:
                info = None
            if info:
                found.append(info)
            if len(found) == 3:
                break
        demo = self.make_demo_dir()
        uris = {
            "org.gnome.Nautilus.desktop": demo,
            "org.gnome.TextEditor.desktop": demo / "Release notes.md" if demo else None,
        }
        before = {w[0] for w in self.windows()}
        for info in found:
            log(f"  open {info.get_id()}")
            if self.dry:
                continue
            ids = {w[0] for w in self.windows()}
            try:
                target = uris.get(info.get_id())
                if target:
                    info.launch_uris([Gio.File.new_for_path(str(target)).get_uri()], None)
                else:
                    info.launch([], None)
            except GLib.Error as e:
                log(f"  ! could not open {info.get_id()}: {e.message}")
                continue
            new = self.wait_for_window(ids)
            if new is not None:
                self.opened.append(new)
        if self.dry:
            return
        self.opened = [w for w in self.opened if w not in before]
        for wid, info in zip(self.opened, found):
            self.names[wid] = info.get_name()
        # Nothing maximized or full screen: the wallpaper should show.
        for w in self.windows():
            if w[0] in self.opened and w[7] & (F_MAXIMIZED | F_FULLSCREEN | F_TILED):
                self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (w[0], TILE_RESTORE)))
        self.wait(0.6)
        self.arrange_floating()
        if len(self.opened) >= 3 and self.bus.has_method(COMPOSITOR, "SendWindowToWorkspace"):
            cur, _count = self.workspaces()
            self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                          GLib.Variant("(tu)", (self.opened[2], cur + 1)))
        self.wait(1.5)

    def make_demo_dir(self):
        if self.dry or self.opts.no_demo_folder:
            return None
        d = Path.home() / DEMO_DIR_NAME
        if d.exists():
            log(f"  ~/{DEMO_DIR_NAME} already exists; using it as it is")
            return d
        for rel, text in DEMO_FILES.items():
            f = d / rel
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text)
        self.demo_dir = d
        return d

    def can_drag(self):
        return self.bus.has_method(COMPOSITOR, "DragWindow")

    def drag(self, wid, x, y, ms=900):
        """Drag a window by its title bar to (x, y), as a person would."""
        self.check_screen()
        log(f"  drag {self.names.get(wid, wid)} -> {x},{y}")
        self.bus.call(COMPOSITOR, "DragWindow", GLib.Variant("(tiiu)", (wid, int(x), int(y), ms)),
                      "(b)", timeout=ms + 5000)
        # The dock slides away or back when windows touch it: let it finish.
        self.wait(1.2)

    def arrange_floating(self):
        """Two windows floating, overlapping a little, with desktop around them."""
        if not self.can_drag():
            return
        x, y, w, h = self.area
        # Title-bar grab points, as fractions of the monitor.
        spots = [(0.27, 0.16), (0.73, 0.30), (0.50, 0.24)]
        for wid, (fx, fy) in zip(self.opened, spots):
            self.spots[wid] = (x + int(w * fx), y + int(h * fy))
            self.drag(wid, *self.spots[wid], ms=450)

    def find_terminal(self):
        """The window we were started from: focused when the tour begins."""
        if self.opts.keep_terminal or self.dry:
            return
        focused = [w for w in self.windows() if w[7] & F_FOCUSED]
        if focused:
            self.terminal = focused[0][0]
            self.terminal_name = focused[0][1] or focused[0][2]

    def hide_terminal(self):
        """Get the terminal out of every shot, the overview included: send it
        to its own workspace past the demo's ones, then minimize it."""
        if self.opts.keep_terminal:
            return
        if self.dry:
            log("  move this terminal to a spare workspace and minimize it")
            return
        if self.terminal is None:
            return
        log(f"  hide {self.terminal_name} (restored at the end)")
        _cur, count = self.workspaces()
        if self.bus.has_method(COMPOSITOR, "SendWindowToWorkspace") and count > 1:
            self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                          GLib.Variant("(tu)", (self.terminal, count - 1)))
            self.wait(0.4)
        self.bus.call(COMPOSITOR, "TileWindow", GLib.Variant("(tu)", (self.terminal, MINIMIZE)))
        self.wait(0.8)

    def wait_for_window(self, known, timeout=10):
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            time.sleep(0.4)
            new = [w[0] for w in self.windows() if w[0] not in known]
            if new:
                time.sleep(0.6)  # let it draw its first frames
                return new[-1]
        log("  ! no new window appeared")
        return None

    def workspaces(self):
        res = self.bus.call(COMPOSITOR, "GetWorkspaces", None, "(uu)", quiet=True)
        return res if res else (0, 1)

    def tidy(self):
        """Put the desktop back. D-Bus calls only, safe on a blanked screen."""
        log("tidying up")
        self.recorder.abort()
        if self.saver and self.saver.poll() is None:
            self.saver.terminate()
        self.bus.call(OVERLAY, "Hide", quiet=True)
        if self.bus.has_method(OVERLAY, "HideScreenshotUI"):
            self.bus.call(OVERLAY, "HideScreenshotUI", quiet=True)
        for nid in self.notes:
            self.bus.call(NOTIFY, "CloseNotification", GLib.Variant("(u)", (nid,)), quiet=True)
        for wid in self.opened:
            self.bus.call(COMPOSITOR, "CloseWindow", GLib.Variant("(t)", (wid,)), quiet=True)
        if self.demo_dir:
            time.sleep(1.0)  # let Files and Text Editor let go of it
            shutil.rmtree(self.demo_dir, ignore_errors=True)
        if self.start_workspace is not None:
            self.bus.call(COMPOSITOR, "ShowWorkspace",
                          GLib.Variant("(u)", (self.start_workspace,)), quiet=True)
        if self.terminal is not None:
            if self.start_workspace is not None:
                self.bus.call(COMPOSITOR, "SendWindowToWorkspace",
                              GLib.Variant("(tu)", (self.terminal, self.start_workspace)), quiet=True)
            time.sleep(0.5)
            self.bus.call(COMPOSITOR, "ActivateWindow", GLib.Variant("(t)", (self.terminal,)), quiet=True)
        if self.night_light is not None:
            nl = settings(NIGHT_LIGHT[0])
            nl.set_boolean(NIGHT_LIGHT[1], self.night_light)
            Gio.Settings.sync()
        if self.dark is not None:
            s = settings("org.gnome.desktop.interface")
            s.set_string("color-scheme", self.dark[0])
            s.set_string("gtk-theme", self.dark[1])
            Gio.Settings.sync()
        if self.banners is False:
            s = settings("org.gnome.desktop.notifications")
            s.set_boolean("show-banners", False)
            Gio.Settings.sync()
        self.uninhibit()

    # ---- scenes -------------------------------------------------------

    def scene_desktop(self):
        self.shot("desktop", "The desktop: top bar, Ubuntu-style dock and floating windows over the wallpaper.")

    def scene_tiling(self):
        if not self.can_drag():
            log("  this compositor can't drag windows over D-Bus (update umoja), skipping")
            return
        if len(self.opened) < 2 and not self.dry:
            log("  needs two of the demo's windows, skipping")
            return
        a, b = (self.opened[:2] if not self.dry else (1, 2))
        x, y, w, h = self.area
        mid = y + h // 2
        self.recorder.start("tiling")
        # Drag to the screen edges: the preview shows, the window snaps.
        self.drag(a, x + 3, mid)
        self.drag(b, x + w - 3, mid)
        self.wait(0.8)
        self.shot("tiling-halves", "Drag a window to a screen edge and it snaps to that half, like Ubuntu's Tiling Assistant.")
        # A corner gives a quarter.
        self.drag(b, x + w - 3, y + 3)
        self.wait(0.8)
        self.shot("tiling-quarter", "Drag to a corner for a quarter; tiled windows resize together.")
        # Drag them back out: they get their own size back.
        for wid in (b, a):
            spot = self.spots.get(wid) or (x + w // 2, y + h // 3)
            self.drag(wid, *spot)
        self.wait(0.8)
        self.recorder.stop("Drag-to-tile: halves at the sides, quarters in the corners, drag out to float again.")

    def scene_app_grid(self):
        self.bus.call(OVERLAY, "Show")
        self.wait(1.5)
        self.shot("app-grid", "The app grid with search. Type to find apps, files or ask the assistant.")
        self.bus.call(OVERLAY, "Hide")
        self.wait(0.8)

