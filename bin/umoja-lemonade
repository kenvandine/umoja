#!/bin/sh
# Launch Umoja's embedded Lemonade server (lemond) for the current user.
#
# This is deliberately separate from any system lemonade-server package:
#  - binary:  /usr/lib/umoja/lemonade/lemond (not on PATH)
#  - port:    $UMOJA_LEMONADE_PORT, default 13345 (upstream uses 13305)
#  - host:    127.0.0.1 only, UDP discovery broadcast off
#  - config:  ~/.config/umoja/lemonade   (config.json)
#  - cache:   ~/.cache/umoja/lemonade    (backends, models)
#  - limits:  /usr/share/umoja/lemonade/defaults.json (see below)
set -eu

LEMONADE_DIR=${UMOJA_LEMONADE_DIR:-/usr/lib/umoja/lemonade}
PORT=${UMOJA_LEMONADE_PORT:-13345}
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/umoja/lemonade
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/umoja/lemonade

if [ "$PORT" = "13305" ]; then
    echo "umoja-lemonade: refusing port 13305, it belongs to the system lemonade-server" >&2
    exit 1
fi

mkdir -p "$CONFIG" "$CACHE"

# Keep Hugging Face model downloads inside Umoja's cache too.
export HF_HOME="$CACHE/huggingface"

# GPU memory headroom for the desktop. On an AMD APU the GPU shares system
# RAM, and with ctx_size left at -1 Lemonade's auto-tune sizes the context
# from VRAM + GTT: Qwen3-4B got ~231k tokens, a KV cache of ~32 GiB, and the
# compositor's next command submission was rejected (-ENOMEM), which Mesa
# turns into abort() for a non-robust GL context. Our defaults cap the
# context at 16k and keep one request and one model per type in flight.
# The KV cache is stored as q8_0 (flash attention on), half the size of the
# f16 default: about 1.2 GB less for Qwen3-4B at 16k.
# They are only defaults: ~/.config/umoja/lemonade/config.json still wins.
DEFAULTS=${UMOJA_LEMONADE_DEFAULTS:-/usr/share/umoja/lemonade/defaults.json}
if [ -z "${LEMONADE_DEFAULTS_PATH:-}" ] && [ -r "$DEFAULTS" ]; then
    export LEMONADE_DEFAULTS_PATH="$DEFAULTS"
fi

# Put llama.cpp's Vulkan buffers in GTT (system RAM the GPU maps) rather than
# the VRAM carve-out, which scanout and the compositor's textures need. On an
# iGPU both are the same DRAM. Set UMOJA_LEMONADE_PREFER_HOST_MEMORY=0 in
# ~/.config/umoja/lemonade.env to turn this off.
if [ "${UMOJA_LEMONADE_PREFER_HOST_MEMORY:-1}" != 0 ]; then
    export GGML_VK_PREFER_HOST_MEMORY=1
else
    unset GGML_VK_PREFER_HOST_MEMORY
fi

exec "$LEMONADE_DIR/lemond" "$CACHE" "$CONFIG" \
    --host 127.0.0.1 --port "$PORT" --no-broadcast --log-file disabled
