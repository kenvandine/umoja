#!/bin/bash
# umoja-agent-setup: let the AI coding agents a user already has (Claude Code,
# Codex, GitHub Copilot CLI, Antigravity CLI, OpenCode, Pi, Gemini CLI) work with
# Umoja. For each agent it finds it
# links the Umoja agent skill into the agent's skills folder and registers
# Umoja's MCP server (umoja-mcp), so the agent knows how the desktop works
# and gets the same desktop tools, with the same Allow rules, as the overlay
# assistant.
#
# It never installs an agent (Umoja's Coding agent picker does that, then
# runs this for the new agent; see umoja_common::agents) and never touches an
# entry it didn't write. The session runs it with --auto at every login: each
# agent is set up once, the first time it is seen, so an agent installed
# outside Umoja is picked up at the next login and an agent the user ran
# --remove for is left alone.
#
# OpenCode and Pi get the assistant's models (in opencode.json and
# ~/.pi/agent/models.json), so they work without signing in to anything:
# Umoja's local Lemonade model always, and the cloud model (org.umoja.shell
# cloud-base-url and cloud-model, the key from the keyring) when one is set
# up. The one the assistant uses becomes their default unless the user
# picked another. Pi reads the key from the keyring at each request;
# OpenCode can't, so it gets a 0600 file of its own.

set -uo pipefail

SKILL_SRC=${UMOJA_AGENT_SKILL:-/usr/share/umoja/agents/skills/umoja}
MCP_CMD=${UMOJA_MCP_COMMAND:-umoja-mcp}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/umoja
STATE=$STATE_DIR/agent-setup
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
AGENTS=(claude codex copilot agy opencode pi gemini)

# Login services get a short PATH; agents usually live in the user's own bin
# folders (native installers, npm, bun, mise, snaps).
PI_DIR=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
PATH=$PATH:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.bun/bin:$HOME/.local/share/mise/shims:$HOME/.opencode/bin:/snap/bin

usage() {
  cat <<EOF
Usage: umoja-agent-setup [AGENT...]          set up these agents (default: all found)
       umoja-agent-setup --remove [AGENT...]  undo it (default: all)
       umoja-agent-setup --status             show what is set up
       umoja-agent-setup --auto               set up agents not seen before (run at login)
       umoja-agent-setup --models [opencode|pi]  give OpenCode (or Pi) the assistant's models
                                              (no agent: refresh the ones that have them)
       umoja-agent-setup --cloud [opencode|pi]  point OpenCode (or Pi) at the assistant's cloud model
       umoja-agent-setup --cloud --remove [opencode|pi]  undo that

Agents: ${AGENTS[*]}
EOF
}

label() {
  case $1 in
    claude) echo "Claude Code" ;;
    codex) echo "Codex" ;;
    copilot) echo "GitHub Copilot" ;;
    agy) echo "Antigravity" ;;
    gemini) echo "Gemini CLI" ;;
    opencode) echo "OpenCode" ;;
    pi) echo "Pi" ;;
  esac
}

home_of() {
  case $1 in
    claude) echo "$HOME/.claude" ;;
    codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
    copilot) echo "${COPILOT_HOME:-$HOME/.copilot}" ;;
    # Antigravity CLI and the Antigravity app share this folder.
    agy) echo "$HOME/.gemini/config" ;;
    gemini) echo "$HOME/.gemini" ;;
    opencode) echo "$CONFIG/opencode" ;;
    pi) echo "$PI_DIR" ;;
  esac
}

present() {
  command -v "$1" >/dev/null 2>&1 && return 0
  case $1 in
    # Antigravity also uses ~/.gemini, so that folder alone doesn't mean
    # Gemini CLI is here.
    gemini) [[ -f $HOME/.gemini/oauth_creds.json ]] ;;
    agy) [[ -d $HOME/.gemini/antigravity-cli ]] ;;
    *) [[ -d $(home_of "$1") ]] ;;
  esac
}

skill_dir() {
  case $1 in
    opencode) echo "$CONFIG/opencode/skills" ;;
    *) echo "$(home_of "$1")/skills" ;;
  esac
}

seen() { [[ -f $STATE ]] && grep -qx "$1" "$STATE"; }

mark_seen() {
  mkdir -p "$STATE_DIR"
  seen "$1" || echo "$1" >>"$STATE"
}

# --- skill links -------------------------------------------------------------

link_skill() {
  local dir=$1/umoja
  if [[ -L $dir ]]; then
    ln -sfn "$SKILL_SRC" "$dir"
  elif [[ -e $dir ]]; then
    echo "  skill: $dir already exists and isn't Umoja's link; left alone" >&2
    return 1
  else
    mkdir -p "$1" && ln -s "$SKILL_SRC" "$dir"
  fi
}

unlink_skill() {
  local dir=$1/umoja
  [[ -L $dir && $(readlink "$dir") == "$SKILL_SRC" ]] && rm -f "$dir"
  # Don't leave behind a skills folder that only ever held our link.
  rmdir "$1" 2>/dev/null
  return 0
}

has_skill() {
  [[ -L $1/umoja && $(readlink "$1/umoja") == "$SKILL_SRC" ]]
}

# --- MCP registration ------------------------------------------------------

# JSON settings files (Gemini CLI, OpenCode): add or remove one entry under a
# key, keeping everything else. A file that isn't plain JSON (OpenCode allows
# comments) is left alone rather than rewritten without them.
json_mcp() {
  python3 - "$@" <<'EOF'
import json, os, sys, tempfile
action, path, key, name, entry = sys.argv[1:6]
try:
    with open(path) as f:
        text = f.read()
    data = json.loads(text) if text.strip() else {}
except FileNotFoundError:
    data = {}
except ValueError:
    print(f"  mcp: {path} isn't plain JSON; add the umoja server by hand", file=sys.stderr)
    sys.exit(1)
servers = data.get(key) or {}
if action == "has":
    sys.exit(0 if name in servers else 1)
if action == "add":
    if name in servers:
        sys.exit(0)
    servers[name] = json.loads(entry)
elif action == "remove":
    if servers.get(name) != json.loads(entry):
        sys.exit(0)          # not ours, or changed by the user
    del servers[name]
if servers:
    data[key] = servers
else:
    data.pop(key, None)
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
if os.path.exists(path):
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
EOF
}

gemini_entry() { printf '{"command": "%s"}' "$MCP_CMD"; }
copilot_entry() { printf '{"type": "local", "command": "%s", "args": [], "tools": ["*"]}' "$MCP_CMD"; }
opencode_entry() { printf '{"type": "local", "command": ["%s"], "enabled": true}' "$MCP_CMD"; }
codex_toml() { echo "$(home_of codex)/config.toml"; }

mcp() {
  local action=$1 agent=$2
  case $agent in
    claude)
      command -v claude >/dev/null || { [[ $action == has ]] && return 1; echo "  mcp: the claude command isn't on PATH" >&2; return 1; }
      case $action in
        has) claude mcp get umoja >/dev/null 2>&1 ;;
        add) claude mcp get umoja >/dev/null 2>&1 || claude mcp add --scope user umoja -- "$MCP_CMD" >/dev/null ;;
        remove)
          if claude mcp get umoja 2>/dev/null | grep -q "$MCP_CMD"; then
            claude mcp remove --scope user umoja >/dev/null 2>&1
          fi
          return 0 ;;
      esac ;;
    codex)
      local toml
      toml=$(codex_toml)
      case $action in
        has) [[ -f $toml ]] && grep -q '^\[mcp_servers\.umoja\]' "$toml" ;;
        add)
          [[ -f $toml ]] && grep -q '^\[mcp_servers\.umoja\]' "$toml" && return 0
          mkdir -p "$(dirname "$toml")"
          printf '\n# Added by umoja-agent-setup\n[mcp_servers.umoja]\ncommand = "%s"\n' "$MCP_CMD" >>"$toml" ;;
        remove)
          [[ -f $toml ]] || return 0
          python3 - "$toml" "$MCP_CMD" <<'EOF'
import os, re, sys
path, cmd = sys.argv[1:3]
text = open(path).read()
block = re.compile(r'\n?# Added by umoja-agent-setup\n\[mcp_servers\.umoja\]\ncommand = "' + re.escape(cmd) + r'"\n')
new = block.sub("", text)
if new != text:
    if new.strip():
        open(path, "w").write(new)
    else:
        os.remove(path)      # we created it
EOF
          ;;
      esac ;;
    copilot) json_mcp "$action" "$(home_of copilot)/mcp-config.json" mcpServers umoja "$(copilot_entry)" ;;
    agy) json_mcp "$action" "$(home_of agy)/mcp_config.json" mcpServers umoja "$(gemini_entry)" ;;
    gemini) json_mcp "$action" "$(home_of gemini)/settings.json" mcpServers umoja "$(gemini_entry)" ;;
    opencode) json_mcp "$action" "$CONFIG/opencode/opencode.json" mcp umoja "$(opencode_entry)" ;;
    pi) json_mcp "$action" "$PI_DIR/mcp.json" mcpServers umoja "$(gemini_entry)" ;;
  esac
}

# --- OpenCode on the assistant's models -----------------------------------

OPENCODE_KEY=${XDG_DATA_HOME:-$HOME/.local/share}/umoja/opencode-cloud.key

shell_key() {
  gsettings get org.umoja.shell "$1" 2>/dev/null | sed -e "s/^'//" -e "s/'$//"
}

# Sets port, ctx, local_model, cloud_url and cloud_model from the
# assistant's settings, for opencode_models and pi_models.
assistant_models() {
  local mem_kb
  port=$(lemonade_env UMOJA_LEMONADE_PORT)
  port=${port:-${UMOJA_LEMONADE_PORT:-13345}}
  ctx=$(lemonade_env UMOJA_LEMONADE_CTX)
  if [[ -z $ctx ]]; then
    # bin/umoja-lemonade's defaults: 16k, 8k under 12 GB of RAM.
    mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)
    if ((${mem_kb:-0} > 0 && mem_kb < 12 * 1024 * 1024)); then ctx=8192; else ctx=16384; fi
  fi
  local_model=$(lemonade_model)
  cloud_url=$(shell_key cloud-base-url)
  cloud_model=$(shell_key cloud-model)
}

# add [cloud|refresh] | remove | remove-cloud | has. Like pi_models, for
# OpenCode: providers "umoja-local" (Lemonade) and "umoja-cloud" (when the
# assistant has a cloud model) in opencode.json, so OpenCode works without
# signing in to anything. One becomes the model unless the user picked their
# own: the cloud one when the assistant uses it (or with "cloud"), else the
# local one. OpenCode can't run a command for a key, so the cloud key goes
# in a file of its own (mode 0600) that the provider reads with apiKey
# "{file:...}"; that keeps it out of opencode.json, which people copy
# around. It reaches Python through the environment, never the command line.
opencode_models() {
  local action=$1 prefer=${2:-} port="" ctx="" local_model="" cloud_url="" cloud_model="" key=""
  if [[ $action == add ]]; then
    assistant_models
    [[ $(shell_key assistant-backend) == cloud ]] && prefer=cloud
    if [[ $prefer == cloud && ( -z $cloud_url || -z $cloud_model ) ]]; then
      echo "  cloud: the assistant has no cloud model set up (Ask Umoja, model button, Cloud)" >&2
      [[ ${2:-} == cloud ]] && return 1
      prefer=""
    fi
    if [[ -n $cloud_url && -n $cloud_model ]] && command -v secret-tool >/dev/null; then
      key=$(secret-tool lookup umoja assistant-cloud kind api-key 2>/dev/null)
    fi
  fi
  UMOJA_CLOUD_KEY=$key python3 - "$action" "$CONFIG/opencode/opencode.json" "$OPENCODE_KEY" \
    "$port" "$ctx" "$local_model" "$cloud_url" "$cloud_model" "$prefer" <<'PY'
import json, os, sys, tempfile
action, conf, keyfile, port, ctx, local_model, cloud_url, cloud_model, prefer = sys.argv[1:10]
key = os.environ.get("UMOJA_CLOUD_KEY", "").strip()
LOCAL, CLOUD = "umoja-local", "umoja-cloud"
NAMES = {LOCAL: "Umoja local model", CLOUD: "Umoja cloud model"}

def load(path):
    try:
        with open(path) as f:
            text = f.read()
        return json.loads(text) if text.strip() else {}
    except FileNotFoundError:
        return {}
    except ValueError:
        print(f"  opencode: {path} isn't plain JSON; left alone", file=sys.stderr)
        sys.exit(1)

def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)

def drop_key():
    if os.path.exists(keyfile):
        os.remove(keyfile)

c = load(conf)
providers = c.get("provider") or {}
ours = lambda pid: (providers.get(pid) or {}).get("name") == NAMES[pid]
if action == "has":
    sys.exit(0 if ours(LOCAL) or ours(CLOUD) else 1)
for pid in (LOCAL, CLOUD):
    if pid in providers and not ours(pid):
        print(f"  opencode: opencode.json already has a provider called {pid}; left alone", file=sys.stderr)
        sys.exit(1)
mine = not c.get("model") or str(c["model"]).startswith("umoja-")

if action == "add":
    providers[LOCAL] = {
        "npm": "@ai-sdk/openai-compatible",
        "name": NAMES[LOCAL],
        "options": {"baseURL": f"http://127.0.0.1:{port}/api/v1", "apiKey": "lemonade"},
        "models": {local_model: {
            "name": f"{local_model} (Umoja, on this computer)",
            "limit": {"context": int(ctx), "output": 4096},
            # Qwen3.5 thinks by default and then leaves the answer empty;
            # the assistant turns it off too (lemonade::chat_template_kwargs).
            "options": {"chat_template_kwargs": {"enable_thinking": False}},
        }},
    }
    keep_cloud = prefer != "refresh" or ours(CLOUD)
    if cloud_url and cloud_model and keep_cloud:
        options = {"baseURL": cloud_url.rstrip("/")}
        if key:
            os.makedirs(os.path.dirname(keyfile), exist_ok=True)
            fd = os.open(keyfile + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(key)
            os.chmod(keyfile + ".new", 0o600)
            os.replace(keyfile + ".new", keyfile)
            options["apiKey"] = "{file:" + keyfile + "}"
        else:
            drop_key()
        providers[CLOUD] = {
            "npm": "@ai-sdk/openai-compatible",
            "name": NAMES[CLOUD],
            "options": options,
            "models": {cloud_model: {"name": f"{cloud_model} (Umoja cloud)"}},
        }
    elif ours(CLOUD):
        del providers[CLOUD]
        drop_key()
    c["provider"] = providers
    if mine:
        current = str(c.get("model", "")).split("/", 1)[0]
        if prefer == "cloud" and CLOUD in providers:
            pid = CLOUD
        elif current in providers and current in (LOCAL, CLOUD):
            pid = current       # keep the user's pick between ours
        else:
            pid = LOCAL
        c["model"] = f"{pid}/{next(iter(providers[pid]['models']))}"
    c.setdefault("$schema", "https://opencode.ai/config.json")
    save(conf, c)
elif action in ("remove", "remove-cloud"):
    drop = (CLOUD,) if action == "remove-cloud" else (LOCAL, CLOUD)
    drop_key()
    for pid in drop:
        if ours(pid):
            del providers[pid]
    if providers:
        c["provider"] = providers
    else:
        c.pop("provider", None)
    if str(c.get("model", "")).split("/", 1)[0] in drop:
        if action == "remove-cloud" and LOCAL in providers:
            c["model"] = f"{LOCAL}/{next(iter(providers[LOCAL]['models']))}"
        else:
            del c["model"]
    if not os.path.exists(conf):
        sys.exit(0)
    if set(c) <= {"$schema"}:
        os.remove(conf)      # we created it
    else:
        save(conf, c)
PY
}

opencode_note() {
  local m
  m=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("model",""))' \
    "$CONFIG/opencode/opencode.json" 2>/dev/null)
  case $m in
    umoja-local/*) echo "OpenCode: uses the assistant's local model (${m#*/})" ;;
    umoja-cloud/*) echo "OpenCode: uses the assistant's cloud model (${m#*/})" ;;
  esac
}

# --- Pi on the assistant's models -----------------------------------------

# The local model the assistant uses: org.umoja.shell lemonade-model, else
# the automatic pick of umoja_common::lemonade::auto_model (by RAM, and the
# tiny model once the small one ran out of memory). Keep the two in step.
lemonade_model() {
  local picked mem_kb
  picked=$(shell_key lemonade-model)
  if [[ -n $picked ]]; then echo "$picked"; return; fi
  mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)
  if ((${mem_kb:-0} >= 12 * 1024 * 1024)); then
    echo Qwen3-4B-Instruct-2507-GGUF
  elif [[ -e ${XDG_STATE_HOME:-$HOME/.local/state}/umoja/lemonade-tiny-model ]]; then
    echo Qwen3.5-0.8B-GGUF
  else
    echo Qwen3.5-2B-GGUF
  fi
}

# One setting from ~/.config/umoja/lemonade.env (port, context), as
# bin/umoja-lemonade reads it.
lemonade_env() {
  local file=$CONFIG/umoja/lemonade.env
  [[ -r $file ]] || return 0
  sed -n "s/^[[:space:]]*\(export[[:space:]]\+\)\?$1=[\"']\?\([^\"']*\)[\"']\?[[:space:]]*$/\2/p" "$file" | tail -n1
}

# add [cloud|refresh] | remove | remove-cloud | has. Writes providers "umoja-local" (Lemonade) and
# "umoja-cloud" (when the assistant has a cloud model) to Pi's models.json,
# and makes one Pi's default in settings.json when the user hasn't picked a
# model of their own: the cloud one when the assistant uses it (or with
# "cloud"), else the local one. Only entries named as ours are touched.
pi_models() {
  local action=$1 prefer=${2:-} port="" ctx="" local_model="" cloud_url="" cloud_model=""
  if [[ $action == add ]]; then
    assistant_models
    [[ $(shell_key assistant-backend) == cloud ]] && prefer=cloud
    if [[ $prefer == cloud && ( -z $cloud_url || -z $cloud_model ) ]]; then
      echo "  cloud: the assistant has no cloud model set up (Ask Umoja, model button, Cloud)" >&2
      [[ ${2:-} == cloud ]] && return 1
      prefer=""
    fi
  fi
  python3 - "$action" "$PI_DIR" "${port:-}" "${ctx:-}" "$local_model" "$cloud_url" "$cloud_model" "$prefer" <<'PY'
import json, os, sys, tempfile
action, pidir, port, ctx, local_model, cloud_url, cloud_model, prefer = sys.argv[1:9]
models_path = os.path.join(pidir, "models.json")
settings_path = os.path.join(pidir, "settings.json")
LOCAL, CLOUD = "umoja-local", "umoja-cloud"
NAMES = {LOCAL: "Umoja local model", CLOUD: "Umoja cloud model"}
# Read at each request, so the key never lands in a file.
KEY_CMD = "!secret-tool lookup umoja assistant-cloud kind api-key"

def load(path):
    try:
        with open(path) as f:
            text = f.read()
        return json.loads(text) if text.strip() else {}
    except FileNotFoundError:
        return {}
    except ValueError:
        print(f"  pi: {path} isn't plain JSON; left alone", file=sys.stderr)
        sys.exit(1)

def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)

m = load(models_path)
providers = m.get("providers") or {}
ours = lambda pid: (providers.get(pid) or {}).get("name") == NAMES[pid]
if action == "has":
    sys.exit(0 if ours(LOCAL) or ours(CLOUD) else 1)
for pid in (LOCAL, CLOUD):
    if pid in providers and not ours(pid):
        print(f"  pi: models.json already has a provider called {pid}; left alone", file=sys.stderr)
        sys.exit(1)

s = load(settings_path)
mine = str(s.get("defaultProvider", "")).startswith("umoja-") or not s.get("defaultProvider")

if action == "add":
    providers[LOCAL] = {
        "name": NAMES[LOCAL],
        "baseUrl": f"http://127.0.0.1:{port}/api/v1",
        "api": "openai-completions",
        "apiKey": "lemonade",
        "models": [{
            "id": local_model,
            "name": f"{local_model} (Umoja, on this computer)",
            "contextWindow": int(ctx),
            "maxTokens": 4096,
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            # Qwen3.5 thinks by default and then leaves the answer empty;
            # the assistant turns it off too (lemonade::chat_template_kwargs).
            "samplingParams": {"chat_template_kwargs": {"enable_thinking": False}},
        }],
    }
    # A refresh at login keeps the cloud model only if it is still there
    # (--cloud --remove pi took it away), unless the assistant uses it.
    keep_cloud = prefer != "refresh" or ours(CLOUD)
    if cloud_url and cloud_model and keep_cloud:
        providers[CLOUD] = {
            "name": NAMES[CLOUD],
            "baseUrl": cloud_url.rstrip("/"),
            "api": "openai-completions",
            "apiKey": KEY_CMD,
            "models": [{"id": cloud_model, "name": f"{cloud_model} (Umoja cloud)"}],
        }
    elif ours(CLOUD):
        del providers[CLOUD]
    m["providers"] = providers
    m.setdefault("$schema", "https://pi.dev/schemas/models.schema.json")
    save(models_path, m)
    if mine:
        current = s.get("defaultProvider")
        if prefer == "cloud" and CLOUD in providers:
            pid = CLOUD
        elif current in providers and current in (LOCAL, CLOUD):
            pid = current       # keep the user's pick between ours
        else:
            pid = LOCAL
        s["defaultProvider"] = pid
        s["defaultModel"] = providers[pid]["models"][0]["id"]
        save(settings_path, s)
elif action in ("remove", "remove-cloud"):
    drop = (CLOUD,) if action == "remove-cloud" else (LOCAL, CLOUD)
    changed = False
    for pid in drop:
        if ours(pid):
            del providers[pid]
            changed = True
    if changed:
        if providers:
            m["providers"] = providers
        else:
            m.pop("providers", None)
        if set(m) <= {"$schema"}:
            os.remove(models_path)      # we created it
        else:
            save(models_path, m)
    if s.get("defaultProvider") in drop:
        if action == "remove-cloud" and LOCAL in providers:
            s["defaultProvider"] = LOCAL
            s["defaultModel"] = providers[LOCAL]["models"][0]["id"]
        else:
            s.pop("defaultProvider", None)
            s.pop("defaultModel", None)
        if s:
            save(settings_path, s)
        else:
            os.remove(settings_path)
PY
}

pi_note() {
  local s=$PI_DIR/settings.json
  [[ -f $s ]] || return 0
  python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); p=s.get("defaultProvider","")
print({"umoja-local":"Pi: uses the assistant'"'"'s local model ("+s.get("defaultModel","")+")",
       "umoja-cloud":"Pi: uses the assistant'"'"'s cloud model ("+s.get("defaultModel","")+")"}.get(p,""))' "$s" 2>/dev/null | grep . || true
}

# --- commands ---------------------------------------------------------------

# Bring OpenCode's or Pi's copy of the assistant's models up to date, if it
# has one (--remove took it away for good).
refresh_models() {
  case $1 in
    opencode) opencode_models has 2>/dev/null && opencode_models add refresh ;;
    pi) pi_models has 2>/dev/null && pi_models add refresh ;;
  esac
  return 0
}

setup_one() {
  local agent=$1 ok=0
  link_skill "$(skill_dir "$agent")" || ok=1
  mcp add "$agent" || ok=1
  if [[ $agent == opencode ]]; then
    opencode_models add && opencode_note || ok=1
  fi
  if [[ $agent == pi ]]; then
    pi_models add && pi_note || ok=1
  fi
  mark_seen "$agent"
  if ((ok == 0)); then
    echo "$(label "$agent"): Umoja skill and tools added"
  else
    echo "$(label "$agent"): partly set up (see above)"
  fi
  return $ok
}

remove_one() {
  local agent=$1
  unlink_skill "$(skill_dir "$agent")"
  mcp remove "$agent"
  [[ $agent == opencode ]] && opencode_models remove
  [[ $agent == pi ]] && pi_models remove
  mark_seen "$agent"
  echo "$(label "$agent"): Umoja skill and tools removed"
}

status() {
  local agent
  for agent in "${AGENTS[@]}"; do
    if ! present "$agent"; then
      printf '%-14s not installed\n' "$(label "$agent")"
      continue
    fi
    local skill=no tools=no
    has_skill "$(skill_dir "$agent")" && skill=yes
    mcp has "$agent" 2>/dev/null && tools=yes
    local extra=""
    [[ $agent == opencode ]] && opencode_models has 2>/dev/null && extra="  models: the assistant's"
    [[ $agent == pi ]] && pi_models has 2>/dev/null && extra="  models: the assistant's"
    printf '%-14s skill: %-3s  tools: %s%s\n' "$(label "$agent")" "$skill" "$tools" "$extra"
  done
  if has_skill "$HOME/.agents/skills"; then
    echo "~/.agents/skills: skill linked"
  fi
}

notify() {
  command -v notify-send >/dev/null || return 0
  notify-send --app-name=Umoja \
    "Your AI apps can use Umoja" \
    "$1 can now change settings and do things on the desktop with Umoja's tools, asking you first like the assistant does. Run umoja-agent-setup --remove to undo." \
    2>/dev/null || true
}

pick() {
  local agent
  if (($# == 0)); then
    for agent in "${AGENTS[@]}"; do present "$agent" && echo "$agent"; done
    return
  fi
  for agent in "$@"; do
    if [[ " ${AGENTS[*]} " != *" $agent "* ]]; then
      echo "Unknown agent: $agent (known: ${AGENTS[*]})" >&2
      exit 2
    fi
    echo "$agent"
  done
}

main() {
  local mode=setup
  case ${1:-} in
    -h|--help) usage; exit 0 ;;
    --status) status; exit 0 ;;
    --remove) mode=remove; shift ;;
    --auto) mode=auto; shift ;;
    --models)
      # From the assistant's settings: give OpenCode or Pi the assistant's
      # models (the Coding agent picker, so they need no sign-in), or with
      # no agent, refresh the ones that have them (after the assistant's
      # model changes).
      shift
      if (($# == 0)); then
        for agent in opencode pi; do present "$agent" && refresh_models "$agent"; done
        exit 0
      fi
      local rc=0
      for agent in "$@"; do
        case $agent in
          opencode) opencode_models add && opencode_note || rc=1 ;;
          pi) pi_models add && pi_note || rc=1 ;;
          *) echo "Only OpenCode and Pi can use the assistant's models" >&2; rc=2 ;;
        esac
      done
      exit $rc ;;
    --cloud)
      shift
      local undo=0
      [[ ${1:-} == --remove ]] && { undo=1; shift; }
      case ${1:-opencode} in
        opencode)
          if ((undo)); then
            opencode_models remove-cloud && echo "OpenCode: no longer uses the assistant's cloud model"
          else
            opencode_models add cloud && opencode_note
          fi ;;
        pi)
          if ((undo)); then
            pi_models remove-cloud && echo "Pi: no longer uses the assistant's cloud model"
          else
            pi_models add cloud && pi_note
          fi ;;
        *)
          echo "Only OpenCode and Pi can use the assistant's cloud model" >&2
          exit 2 ;;
      esac
      exit ;;
    -*) usage >&2; exit 2 ;;
  esac

  if [[ $mode != remove && ! -d $SKILL_SRC ]]; then
    echo "Umoja's agent skill isn't installed at $SKILL_SRC" >&2
    exit 1
  fi

  local agents agent rc=0 added=()
  mapfile -t agents < <(pick "$@")

  case $mode in
    setup|auto)
      for agent in "${agents[@]}"; do
        if [[ $mode == auto ]] && seen "$agent"; then
          # Keep OpenCode and Pi on the assistant's current models (they
          # change with the RAM rule, the model picker and the Cloud page).
          refresh_models "$agent" >/dev/null 2>&1
          continue
        fi
        if setup_one "$agent"; then added+=("$(label "$agent")"); else rc=1; fi
      done
      # The shared folder several agents read (Codex, OpenCode, Pi...).
      if ((${#agents[@]})) && { [[ $mode == setup ]] || ((${#added[@]})); }; then
        link_skill "$HOME/.agents/skills" || true
      fi
      if [[ $mode == auto ]] && ((${#added[@]})); then
        local who
        who=$(printf '%s, ' "${added[@]}")
        notify "${who%, }"
      elif [[ $mode == setup ]] && ((${#agents[@]} == 0)); then
        echo "No AI coding agents found (looked for: ${AGENTS[*]})."
      fi
      ;;
    remove)
      for agent in "${agents[@]}"; do remove_one "$agent"; done
      (($# == 0)) && unlink_skill "$HOME/.agents/skills"
      ;;
  esac
  exit $rc
}

main "$@"
