#!/bin/bash
# umoja-agent-setup: let the AI coding agents a user already has (Claude Code,
# Codex, GitHub Copilot CLI, Antigravity CLI, OpenCode, Gemini CLI) work with
# Umoja. For each agent it finds it
# links the Umoja agent skill into the agent's skills folder and registers
# Umoja's MCP server (umoja-mcp), so the agent knows how the desktop works
# and gets the same desktop tools, with the same Allow rules, as the overlay
# assistant.
#
# It never installs an agent (Umoja's Coding agent picker does that, then
# runs this for the new agent; see umoja_common::agents) and never touches an
# entry it didn't write. The session runs it with --auto at every login: each
# agent is set up once, the first time it is seen, so an agent installed
# outside Umoja is picked up at the next login and an agent the user ran
# --remove for is left alone.
#
# OpenCode can also use the assistant's cloud model (org.umoja.shell
# cloud-base-url and cloud-model, the key from the keyring): that happens
# when it is set up while the assistant uses the cloud, or with --cloud.

set -uo pipefail

SKILL_SRC=${UMOJA_AGENT_SKILL:-/usr/share/umoja/agents/skills/umoja}
MCP_CMD=${UMOJA_MCP_COMMAND:-umoja-mcp}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/umoja
STATE=$STATE_DIR/agent-setup
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
AGENTS=(claude codex copilot agy opencode gemini)

# Login services get a short PATH; agents usually live in the user's own bin
# folders (native installers, npm, bun, mise, snaps).
PATH=$PATH:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.bun/bin:$HOME/.local/share/mise/shims:$HOME/.opencode/bin:/snap/bin

usage() {
  cat <<EOF
Usage: umoja-agent-setup [AGENT...]          set up these agents (default: all found)
       umoja-agent-setup --remove [AGENT...]  undo it (default: all)
       umoja-agent-setup --status             show what is set up
       umoja-agent-setup --auto               set up agents not seen before (run at login)
       umoja-agent-setup --cloud [opencode]   point OpenCode at the assistant's cloud model
       umoja-agent-setup --cloud --remove     undo that

Agents: ${AGENTS[*]}
EOF
}

label() {
  case $1 in
    claude) echo "Claude Code" ;;
    codex) echo "Codex" ;;
    copilot) echo "GitHub Copilot" ;;
    agy) echo "Antigravity" ;;
    gemini) echo "Gemini CLI" ;;
    opencode) echo "OpenCode" ;;
  esac
}

home_of() {
  case $1 in
    claude) echo "$HOME/.claude" ;;
    codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
    copilot) echo "${COPILOT_HOME:-$HOME/.copilot}" ;;
    # Antigravity CLI and the Antigravity app share this folder.
    agy) echo "$HOME/.gemini/config" ;;
    gemini) echo "$HOME/.gemini" ;;
    opencode) echo "$CONFIG/opencode" ;;
  esac
}

present() {
  command -v "$1" >/dev/null 2>&1 && return 0
  case $1 in
    # Antigravity also uses ~/.gemini, so that folder alone doesn't mean
    # Gemini CLI is here.
    gemini) [[ -f $HOME/.gemini/oauth_creds.json ]] ;;
    agy) [[ -d $HOME/.gemini/antigravity-cli ]] ;;
    *) [[ -d $(home_of "$1") ]] ;;
  esac
}

skill_dir() {
  case $1 in
    opencode) echo "$CONFIG/opencode/skills" ;;
    *) echo "$(home_of "$1")/skills" ;;
  esac
}

seen() { [[ -f $STATE ]] && grep -qx "$1" "$STATE"; }

mark_seen() {
  mkdir -p "$STATE_DIR"
  seen "$1" || echo "$1" >>"$STATE"
}

# --- skill links -------------------------------------------------------------

link_skill() {
  local dir=$1/umoja
  if [[ -L $dir ]]; then
    ln -sfn "$SKILL_SRC" "$dir"
  elif [[ -e $dir ]]; then
    echo "  skill: $dir already exists and isn't Umoja's link; left alone" >&2
    return 1
  else
    mkdir -p "$1" && ln -s "$SKILL_SRC" "$dir"
  fi
}

unlink_skill() {
  local dir=$1/umoja
  [[ -L $dir && $(readlink "$dir") == "$SKILL_SRC" ]] && rm -f "$dir"
  # Don't leave behind a skills folder that only ever held our link.
  rmdir "$1" 2>/dev/null
  return 0
}

has_skill() {
  [[ -L $1/umoja && $(readlink "$1/umoja") == "$SKILL_SRC" ]]
}

# --- MCP registration ------------------------------------------------------

# JSON settings files (Gemini CLI, OpenCode): add or remove one entry under a
# key, keeping everything else. A file that isn't plain JSON (OpenCode allows
# comments) is left alone rather than rewritten without them.
json_mcp() {
  python3 - "$@" <<'EOF'
import json, os, sys, tempfile
action, path, key, name, entry = sys.argv[1:6]
try:
    with open(path) as f:
        text = f.read()
    data = json.loads(text) if text.strip() else {}
except FileNotFoundError:
    data = {}
except ValueError:
    print(f"  mcp: {path} isn't plain JSON; add the umoja server by hand", file=sys.stderr)
    sys.exit(1)
servers = data.get(key) or {}
if action == "has":
    sys.exit(0 if name in servers else 1)
if action == "add":
    if name in servers:
        sys.exit(0)
    servers[name] = json.loads(entry)
elif action == "remove":
    if servers.get(name) != json.loads(entry):
        sys.exit(0)          # not ours, or changed by the user
    del servers[name]
if servers:
    data[key] = servers
else:
    data.pop(key, None)
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
if os.path.exists(path):
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
EOF
}

gemini_entry() { printf '{"command": "%s"}' "$MCP_CMD"; }
copilot_entry() { printf '{"type": "local", "command": "%s", "args": [], "tools": ["*"]}' "$MCP_CMD"; }
opencode_entry() { printf '{"type": "local", "command": ["%s"], "enabled": true}' "$MCP_CMD"; }
codex_toml() { echo "$(home_of codex)/config.toml"; }

mcp() {
  local action=$1 agent=$2
  case $agent in
    claude)
      command -v claude >/dev/null || { [[ $action == has ]] && return 1; echo "  mcp: the claude command isn't on PATH" >&2; return 1; }
      case $action in
        has) claude mcp get umoja >/dev/null 2>&1 ;;
        add) claude mcp get umoja >/dev/null 2>&1 || claude mcp add --scope user umoja -- "$MCP_CMD" >/dev/null ;;
        remove)
          if claude mcp get umoja 2>/dev/null | grep -q "$MCP_CMD"; then
            claude mcp remove --scope user umoja >/dev/null 2>&1
          fi
          return 0 ;;
      esac ;;
    codex)
      local toml
      toml=$(codex_toml)
      case $action in
        has) [[ -f $toml ]] && grep -q '^\[mcp_servers\.umoja\]' "$toml" ;;
        add)
          [[ -f $toml ]] && grep -q '^\[mcp_servers\.umoja\]' "$toml" && return 0
          mkdir -p "$(dirname "$toml")"
          printf '\n# Added by umoja-agent-setup\n[mcp_servers.umoja]\ncommand = "%s"\n' "$MCP_CMD" >>"$toml" ;;
        remove)
          [[ -f $toml ]] || return 0
          python3 - "$toml" "$MCP_CMD" <<'EOF'
import os, re, sys
path, cmd = sys.argv[1:3]
text = open(path).read()
block = re.compile(r'\n?# Added by umoja-agent-setup\n\[mcp_servers\.umoja\]\ncommand = "' + re.escape(cmd) + r'"\n')
new = block.sub("", text)
if new != text:
    if new.strip():
        open(path, "w").write(new)
    else:
        os.remove(path)      # we created it
EOF
          ;;
      esac ;;
    copilot) json_mcp "$action" "$(home_of copilot)/mcp-config.json" mcpServers umoja "$(copilot_entry)" ;;
    agy) json_mcp "$action" "$(home_of agy)/mcp_config.json" mcpServers umoja "$(gemini_entry)" ;;
    gemini) json_mcp "$action" "$(home_of gemini)/settings.json" mcpServers umoja "$(gemini_entry)" ;;
    opencode) json_mcp "$action" "$CONFIG/opencode/opencode.json" mcp umoja "$(opencode_entry)" ;;
  esac
}

# --- OpenCode on the assistant's cloud model ------------------------------

OPENCODE_AUTH=${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json
OPENCODE_KEY=${XDG_DATA_HOME:-$HOME/.local/share}/umoja/opencode-cloud.key

shell_key() {
  gsettings get org.umoja.shell "$1" 2>/dev/null | sed -e "s/^'//" -e "s/'$//"
}

# add|remove|has. Adds a "umoja" OpenAI-compatible provider to opencode.json
# with the cloud URL and model, and makes it the model unless the user picked
# another one. The key goes in a file of its own (mode 0600) that the
# provider reads with apiKey "{file:...}": OpenCode 2.x never sends an
# auth.json key for a custom provider, and this keeps the secret out of
# opencode.json, which people copy around. It reaches Python through the
# environment, never the command line. "has" means set up with a key.
opencode_cloud() {
  local action=$1 url="" model="" key=""
  if [[ $action == add ]]; then
    url=$(shell_key cloud-base-url)
    model=$(shell_key cloud-model)
    if [[ -z $url || -z $model ]]; then
      echo "  cloud: the assistant has no cloud model set up (Ask Umoja, model button, Cloud)" >&2
      return 1
    fi
    command -v secret-tool >/dev/null && key=$(secret-tool lookup umoja assistant-cloud kind api-key 2>/dev/null)
  fi
  UMOJA_CLOUD_KEY=$key python3 - "$action" "$CONFIG/opencode/opencode.json" "$OPENCODE_AUTH" "$url" "$model" \
    "$OPENCODE_KEY" <<'PY'
import json, os, sys, tempfile
action, conf, auth, url, model, keyfile = sys.argv[1:7]
key = os.environ.get("UMOJA_CLOUD_KEY", "")
NAME = "Umoja cloud model"

def load(path):
    try:
        with open(path) as f:
            text = f.read()
        return json.loads(text) if text.strip() else {}
    except FileNotFoundError:
        return {}
    except ValueError:
        print(f"  cloud: {path} isn't plain JSON; left alone", file=sys.stderr)
        sys.exit(1)

def save(path, data, mode):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)

c = load(conf)
providers = c.get("provider") or {}
ours = providers.get("umoja", {}).get("name") == NAME
key_ref = "{file:" + keyfile + "}"
if action == "has":
    keyed = (providers.get("umoja", {}).get("options") or {}).get("apiKey") == key_ref
    sys.exit(0 if ours and keyed and os.path.exists(keyfile) else 1)

def drop_old_auth():
    """Earlier setups put the key in auth.json, where 2.x ignores it."""
    a = load(auth)
    if a.pop("umoja", None) is not None:
        if a:
            save(auth, a, 0o600)
        else:
            os.remove(auth)
mode = os.stat(conf).st_mode & 0o777 if os.path.exists(conf) else 0o644
if action == "add":
    if "umoja" in providers and not ours:
        print("  cloud: opencode.json already has a provider called umoja; left alone", file=sys.stderr)
        sys.exit(1)
    options = {"baseURL": url}
    if key:
        os.makedirs(os.path.dirname(keyfile), exist_ok=True)
        fd = os.open(keyfile + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(key.strip())
        os.chmod(keyfile + ".new", 0o600)
        os.replace(keyfile + ".new", keyfile)
        options["apiKey"] = key_ref
    else:
        print("  cloud: no API key in the keyring; OpenCode will ask the provider without one",
              file=sys.stderr)
    providers["umoja"] = {
        "npm": "@ai-sdk/openai-compatible",
        "name": NAME,
        "options": options,
        "models": {model: {"name": model}},
    }
    c["provider"] = providers
    if not c.get("model") or str(c["model"]).startswith("umoja/"):
        c["model"] = f"umoja/{model}"
    c.setdefault("$schema", "https://opencode.ai/config.json")
    save(conf, c, mode)
    drop_old_auth()
elif action == "remove":
    if os.path.exists(keyfile):
        os.remove(keyfile)
    if not ours:
        sys.exit(0)
    del providers["umoja"]
    if providers:
        c["provider"] = providers
    else:
        c.pop("provider", None)
    if str(c.get("model", "")).startswith("umoja/"):
        del c["model"]
    if set(c) <= {"$schema"}:
        os.remove(conf)      # we created it
    else:
        save(conf, c, mode)
    drop_old_auth()
PY
}

cloud_note() {
  echo "OpenCode: uses the assistant's cloud model ($(shell_key cloud-model))"
}

# --- commands ---------------------------------------------------------------

setup_one() {
  local agent=$1 ok=0
  link_skill "$(skill_dir "$agent")" || ok=1
  mcp add "$agent" || ok=1
  # OpenCode set up while the assistant uses the cloud: same model.
  if [[ $agent == opencode && $(shell_key assistant-backend) == cloud ]] \
    && ! opencode_cloud has 2>/dev/null; then
    opencode_cloud add && cloud_note
  fi
  mark_seen "$agent"
  if ((ok == 0)); then
    echo "$(label "$agent"): Umoja skill and tools added"
  else
    echo "$(label "$agent"): partly set up (see above)"
  fi
  return $ok
}

remove_one() {
  local agent=$1
  unlink_skill "$(skill_dir "$agent")"
  mcp remove "$agent"
  [[ $agent == opencode ]] && opencode_cloud remove
  mark_seen "$agent"
  echo "$(label "$agent"): Umoja skill and tools removed"
}

status() {
  local agent
  for agent in "${AGENTS[@]}"; do
    if ! present "$agent"; then
      printf '%-14s not installed\n' "$(label "$agent")"
      continue
    fi
    local skill=no tools=no
    has_skill "$(skill_dir "$agent")" && skill=yes
    mcp has "$agent" 2>/dev/null && tools=yes
    local extra=""
    [[ $agent == opencode ]] && opencode_cloud has 2>/dev/null && extra="  model: the assistant's cloud model"
    printf '%-14s skill: %-3s  tools: %s%s\n' "$(label "$agent")" "$skill" "$tools" "$extra"
  done
  if has_skill "$HOME/.agents/skills"; then
    echo "~/.agents/skills: skill linked"
  fi
}

notify() {
  command -v notify-send >/dev/null || return 0
  notify-send --app-name=Umoja \
    "Your AI apps can use Umoja" \
    "$1 can now change settings and do things on the desktop with Umoja's tools, asking you first like the assistant does. Run umoja-agent-setup --remove to undo." \
    2>/dev/null || true
}

pick() {
  local agent
  if (($# == 0)); then
    for agent in "${AGENTS[@]}"; do present "$agent" && echo "$agent"; done
    return
  fi
  for agent in "$@"; do
    if [[ " ${AGENTS[*]} " != *" $agent "* ]]; then
      echo "Unknown agent: $agent (known: ${AGENTS[*]})" >&2
      exit 2
    fi
    echo "$agent"
  done
}

main() {
  local mode=setup
  case ${1:-} in
    -h|--help) usage; exit 0 ;;
    --status) status; exit 0 ;;
    --remove) mode=remove; shift ;;
    --auto) mode=auto; shift ;;
    --cloud)
      shift
      if [[ ${1:-} == --remove ]]; then
        opencode_cloud remove && echo "OpenCode: no longer uses the assistant's cloud model"
        exit
      fi
      if [[ -n ${1:-} && $1 != opencode ]]; then
        echo "Only OpenCode can use the assistant's cloud model" >&2
        exit 2
      fi
      opencode_cloud add && cloud_note
      exit ;;
    -*) usage >&2; exit 2 ;;
  esac

  if [[ $mode != remove && ! -d $SKILL_SRC ]]; then
    echo "Umoja's agent skill isn't installed at $SKILL_SRC" >&2
    exit 1
  fi

  local agents agent rc=0 added=()
  mapfile -t agents < <(pick "$@")

  case $mode in
    setup|auto)
      for agent in "${agents[@]}"; do
        [[ $mode == auto ]] && seen "$agent" && continue
        if setup_one "$agent"; then added+=("$(label "$agent")"); else rc=1; fi
      done
      # The shared folder several agents read (Codex, OpenCode, Pi...).
      if ((${#agents[@]})) && { [[ $mode == setup ]] || ((${#added[@]})); }; then
        link_skill "$HOME/.agents/skills" || true
      fi
      if [[ $mode == auto ]] && ((${#added[@]})); then
        local who
        who=$(printf '%s, ' "${added[@]}")
        notify "${who%, }"
      elif [[ $mode == setup ]] && ((${#agents[@]} == 0)); then
        echo "No AI coding agents found (looked for: ${AGENTS[*]})."
      fi
      ;;
    remove)
      for agent in "${agents[@]}"; do remove_one "$agent"; done
      (($# == 0)) && unlink_skill "$HOME/.agents/skills"
      ;;
  esac
  exit $rc
}

main "$@"
