#!/bin/sh
# Session entry point, launched by LightDM (or any DM) via umoja.desktop.
# "ubuntu" (lowercase, as in Ubuntu's own "ubuntu:GNOME") turns on the
# [schema:ubuntu] GSettings overrides: the left dock, Yaru, Ubuntu Sans...
export XDG_CURRENT_DESKTOP="Umoja:ubuntu:GNOME"
export XDG_SESSION_DESKTOP="Umoja"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland;xcb"
export MOZ_ENABLE_WAYLAND=1
# Input methods go through IBus, as in Ubuntu's GNOME session (where
# mutter bridges Wayland text-input to it); here apps talk to IBus
# directly. Myna's dictation types through it too. umoja-ibus.service
# starts the daemon.
if command -v ibus-daemon >/dev/null 2>&1; then
    export GTK_IM_MODULE=ibus QT_IM_MODULE=ibus XMODIFIERS=@im=ibus
fi
# GTK picks Wayland by itself; forcing GDK_BACKEND leaks into later sessions.
unset GDK_BACKEND

# The cursor theme and size, from the same settings GNOME uses. mutter
# exports these too: Xwayland, Electron/Chromium and other apps that draw
# their own cursor read them (without them Electron's cursor is huge), and
# umoja-mir uses them for its own pointer.
gs_get() {
    command -v gsettings >/dev/null 2>&1 && gsettings get org.gnome.desktop.interface "$1" 2>/dev/null | tr -d "'"
}
if [ -z "${XCURSOR_THEME:-}" ]; then
    XCURSOR_THEME=$(gs_get cursor-theme)
    export XCURSOR_THEME="${XCURSOR_THEME:-Yaru}"
fi
if [ -z "${XCURSOR_SIZE:-}" ]; then
    XCURSOR_SIZE=$(gs_get cursor-size)
    case "$XCURSOR_SIZE" in ''|*[!0-9]*) XCURSOR_SIZE=24 ;; esac
    export XCURSOR_SIZE
fi

# Without GNOME Shell (ubuntu-umoja-desktop), the Ubuntu Dock and Tiling
# Assistant schemas come from umoja-desktop's own copy. Appended, so a
# system copy always wins.
UMOJA_GSETTINGS=/usr/share/umoja/gsettings
if [ ! -e /usr/share/glib-2.0/schemas/org.gnome.shell.extensions.dash-to-dock.gschema.xml ] \
    && [ -d "$UMOJA_GSETTINGS" ]; then
    case ":${XDG_DATA_DIRS:-}:" in
        *":$UMOJA_GSETTINGS:"*) ;;
        *) export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$UMOJA_GSETTINGS" ;;
    esac
fi

SESSION_VARS="XCURSOR_THEME XCURSOR_SIZE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORM MOZ_ENABLE_WAYLAND"
[ -n "${GTK_IM_MODULE:-}" ] && SESSION_VARS="$SESSION_VARS GTK_IM_MODULE QT_IM_MODULE XMODIFIERS"

log() { echo "umoja-session: $*" >&2; }

# SSH keys: gnome-keyring no longer runs an SSH agent; gcr4's gcr-ssh-agent
# (a socket unit) wraps ssh-agent and asks for a key's passphrase through
# the keyring prompter in umoja-panel, offering to keep it in the login
# keyring so later logins unlock the key without asking. Point SSH at it,
# as GNOME does, unless something already set an agent up.
GCR_SSH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gcr/ssh"
if { [ -z "${SSH_AUTH_SOCK:-}" ] || [ ! -S "$SSH_AUTH_SOCK" ]; } \
    && systemctl --user -q is-enabled gcr-ssh-agent.socket 2>/dev/null; then
    systemctl --user start gcr-ssh-agent.socket || log "could not start gcr-ssh-agent.socket"
    export SSH_AUTH_SOCK="$GCR_SSH_SOCK"
    SESSION_VARS="$SESSION_VARS SSH_AUTH_SOCK"
fi

# The language the user picked at the login screen (LightDM sets it from
# AccountsService) only lives in our environment; the user manager started
# with the system locale. Hand it over, as gnome-session does, so the shell
# services, the apps they launch and xdg-user-dirs.service (which names
# ~/Documents, ~/Music... in the session language) all agree. These are
# not unset at logout: the user manager had a locale before us and every
# session sets its own.
LOCALE_VARS=""
for v in LANG LANGUAGE LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY \
         LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE \
         LC_MEASUREMENT LC_IDENTIFICATION LC_ALL; do
    eval "[ -n \"\${$v:-}\" ]" && LOCALE_VARS="$LOCALE_VARS $v"
done

# Ensure the D-Bus user session and systemd --user see the session variables.
# shellcheck disable=SC2086
# XDG_DATA_DIRS is imported but never unset on exit: the user manager had
# its own value first, and the appended directory is harmless elsewhere.
IMPORT_VARS="$SESSION_VARS $LOCALE_VARS"
[ -n "${XDG_DATA_DIRS:-}" ] && IMPORT_VARS="$IMPORT_VARS XDG_DATA_DIRS"
systemctl --user import-environment $IMPORT_VARS
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $IMPORT_VARS
fi

# The XDG autostart generator only runs when the user manager starts or
# reloads, and with lingering (or a second login) that manager outlives the
# last session, so an app switched to "start at login" since then would be
# missed. Re-run the generators now, before
# umoja-session.target pulls in xdg-desktop-autostart.target.
systemctl --user daemon-reload || log "systemctl --user daemon-reload failed; autostart entries may be stale"

# Stop the shell services when the compositor exits, however it exits, and
# take our variables back out of the user manager, which outlives this
# session and would otherwise hand them to the next login (e.g. GNOME).
cleanup() {
    systemctl --user stop umoja-session.target
    # shellcheck disable=SC2086
    systemctl --user unset-environment $SESSION_VARS WAYLAND_DISPLAY DISPLAY
}
trap cleanup EXIT INT TERM

session_active() {
    [ "$(loginctl show-session "$XDG_SESSION_ID" -p Active --value 2>/dev/null)" = yes ]
}

# LightDM starts the session before it has stopped the X greeter and made
# this logind session active, and until then Mir can't open the GPU ("Failed
# to find any platforms"). Wait for the hand-over, as gnome-session does.
# After a crash, wait as long as it takes: the user may be on another VT
# (e.g. a text console to kill a hung compositor), and a compositor started
# in the background can't open the GPU or, with an unpatched Mir, takes
# control of whichever session *is* in the foreground and never resumes.
wait_active() {
    [ -n "${XDG_SESSION_ID:-}" ] || return 0
    limit=${1:-100}
    if [ "$limit" = forever ] && ! session_active; then
        log "waiting for session $XDG_SESSION_ID to be in the foreground before restarting umoja-mir"
        while ! session_active; do
            sleep 0.5
        done
        return 0
    fi
    i=0
    while [ $i -lt "$limit" ]; do
        session_active && return 0
        sleep 0.1
        i=$((i + 1))
    done
    log "session $XDG_SESSION_ID still not active after 10s; starting anyway"
}

# The compositor's output goes to the journal (journalctl -t umoja-mir).
run_mir() {
    if command -v systemd-cat >/dev/null 2>&1; then
        systemd-cat -t umoja-mir /usr/bin/umoja-mir "$@"
    else
        /usr/bin/umoja-mir "$@"
    fi
}

# umoja-mir is the session master. Once Wayland is up it starts
# umoja-session.target (panel, dock, overlay, portal, embedded Lemonade).
# If umoja-mir crashes mid-session (for example Mesa calls abort() when the
# GPU rejects a command submission because memory ran out), start it again
# inside this login instead of dropping back to the greeter. Wayland clients
# can't outlive their compositor, so open apps are lost, but the panel, dock,
# overlay and Lemonade come back with it. Give up after MAX_CRASHES crashes
# in CRASH_WINDOW seconds so a compositor that can't run doesn't loop forever.
MAX_CRASHES=${UMOJA_MAX_COMPOSITOR_RESTARTS:-3}
CRASH_WINDOW=600
crashes=""        # start times of recent crashes, oldest first
startup_retry=yes

# True if umoja-mir died from a crash rather than a normal exit or a
# request to stop (SIGHUP/SIGINT/SIGTERM from logout or the DM).
crashed() {
    [ "$1" -gt 128 ] || return 1
    case $(( $1 - 128 )) in
        1|2|15) return 1 ;;
    esac
    return 0
}

# Drop crashes older than CRASH_WINDOW and set n to how many are left.
# (Not called in $(...), so the trimmed list survives.)
count_recent_crashes() {
    kept=""; n=0
    for t in $crashes; do
        if [ $(( $1 - t )) -lt $CRASH_WINDOW ]; then
            kept="$kept $t"; n=$((n + 1))
        fi
    done
    crashes=$kept
}

wait_limit=100    # 10s at login; a restart after a crash waits forever
while :; do
    wait_active $wait_limit
    started=$(date +%s)
    run_mir "$@"
    status=$?
    [ $status -eq 0 ] && break
    now=$(date +%s)

    # A compositor that dies straight away most likely lost the race for the
    # GPU; give it one more go before giving up and returning to the greeter.
    if [ $(( now - started )) -lt 3 ]; then
        [ $startup_retry = yes ] || break
        startup_retry=no
        log "umoja-mir exited with $status during start-up; retrying once"
        sleep 1
        continue
    fi

    crashed $status || break
    crashes="$crashes $now"
    count_recent_crashes "$now"
    if [ "$n" -gt "$MAX_CRASHES" ]; then
        log "umoja-mir crashed $n times in ${CRASH_WINDOW}s (last status $status); ending the session"
        break
    fi
    log "umoja-mir crashed (status $status) after $(( now - started ))s; restarting it ($n/$MAX_CRASHES)"
    # Stop the shell services and Lemonade so they let go of the GPU and
    # reconnect cleanly; umoja-mir starts the target again once it's up.
    systemctl --user stop umoja-session.target
    startup_retry=yes
    wait_limit=forever
    sleep 1
done
exit $status
